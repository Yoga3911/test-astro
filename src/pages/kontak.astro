---
/**
 * kontak.astro — Halaman Kontak & Layanan SDK Maria Fatima Jember
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import KontakForm from '@/components/KontakForm.svelte';
import { SITE_CONFIG } from '@/utils/config';

const kontakInfo = [
  {
    type: 'location',
    label: 'Alamat Sekolah',
    value: SITE_CONFIG.address,
    href: SITE_CONFIG.mapsUrl || 'https://maps.google.com/?q=-8.1713365,113.7008447',
  },
  {
    type: 'whatsapp',
    label: 'Kontak WhatsApp (Bpk. Alex)',
    value: '0813 5897 7450',
    href: `https://wa.me/${SITE_CONFIG.whatsapp}`,
  },
  {
    type: 'phone',
    label: 'Kontak Informasi (Ibu Kikis)',
    value: '0812 1751 3124',
    href: 'tel:081217513124',
  },
  {
    type: 'email',
    label: 'Email Layanan',
    value: SITE_CONFIG.email,
    href: `mailto:${SITE_CONFIG.email}`,
  },
  {
    type: 'clock',
    label: 'Jam Kerja TU',
    value: 'Senin–Jumat: 07.00–14.30 WIB',
    href: null,
  },
];
---

<BaseLayout
  title="Kontak & Lokasi"
  description="Hubungi SDK Maria Fatima Jember — Layanan informasi pendaftaran SPMB, konsultasi orang tua, alamat, dan nomor kontak resmi."
  preloadImages={['/sdk/totem-identitas-sekolah.jpg', '/sdk/gerbang-prestasi.jpg']}
>
  <Header />

  <main id="main-content">
    <!-- Hero Header -->
    <section class="bg-gradient-to-b from-blue-50/80 via-white to-slate-50 border-b border-slate-200/80 py-16 sm:py-20 relative overflow-hidden">
      <!-- Decorative ambient glows -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-blue-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider border border-blue-200 shadow-xs">
          <span>LAYANAN &amp; SEKRETARIAT</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight text-slate-900">
          Kontak &amp; Informasi
        </h1>
        <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto font-normal leading-relaxed">
          Kami dengan senang hati menyambut kehadiran, pertanyaan, dan konsultasi dari bapak, ibu, serta sahabat sekalian.
        </p>
      </div>
    </section>

    <!-- Contacts & Form -->
    <section class="py-16 sm:py-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          
          <!-- Contact Details (Left) -->
          <div class="lg:col-span-5 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase">
              <span>SALURAN KOMUNIKASI</span>
            </div>

            <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
              Keluarga Besar SDK Maria Fatima Jember
            </h2>

            <p class="text-slate-600 text-base leading-relaxed">
              Silakan hubungi kami melalui saluran telepon, pesan WhatsApp, email, atau datang langsung ke kantor tata usaha sekolah.
            </p>

            <div class="space-y-4 pt-2">
              {kontakInfo.map((info) => (
                <div class="p-4 rounded-2xl bg-white border border-slate-200/90 shadow-xs flex items-start gap-4">
                  <span class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center shrink-0 mt-0.5">
                    {info.type === 'location' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                    )}
                    {info.type === 'whatsapp' && (
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                      </svg>
                    )}
                    {info.type === 'phone' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                    )}
                    {info.type === 'email' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                    )}
                    {info.type === 'clock' && (
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    )}
                  </span>
                  <div>
                    <div class="text-[11px] font-bold uppercase text-slate-400">{info.label}</div>
                    {info.href ? (
                      <a href={info.href} class="text-sm font-semibold text-blue-700 hover:underline">
                        {info.value}
                      </a>
                    ) : (
                      <div class="text-sm font-semibold text-slate-800">{info.value}</div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Form (Right) -->
          <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/90 shadow-lg">
            <div class="mb-6 border-b border-slate-100 pb-4">
              <h3 class="text-2xl font-heading font-black text-slate-900">
                Kirimkan Pesan atau Pertanyaan
              </h3>
              <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Isi formulir di bawah ini, tim administrasi kami akan segera menanggapi melalui WhatsApp/Email.
              </p>
            </div>

            <KontakForm client:visible />
          </div>

        </div>
      </div>
    </section>

    <!-- Panduan Akses & Patokan Masuk Sekolah -->
    <section class="py-16 bg-white border-t border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider mb-2">
            <span>PANDUAN KEDATANGAN &amp; AKSES TAMU</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 tracking-tight">
            Patokan Lokasi &amp; Pintu Masuk
          </h2>
          <p class="text-slate-600 text-sm sm:text-base mt-2 font-normal">
            Bapak, ibu, dan sahabat sekalian dapat dengan mudah mengenali gerbang depan dan selasar masuk SDK Maria Fatima di Jl. Kartini No. 24, Jember.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Totem Card -->
          <div class="group bg-slate-50 rounded-3xl overflow-hidden border border-slate-200/90 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div class="aspect-16/10 overflow-hidden bg-slate-100 relative">
              <img
                src="/sdk/totem-identitas-sekolah.jpg"
                alt="Totem Papan Nama Resmi SDK Maria Fatima Jember di Tepi Jl. Kartini"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-slate-900/85 backdrop-blur-md text-white text-xs font-bold shadow-xs">
                Patokan Tepi Jalan Kartini
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-lg text-slate-900 mb-1.5">
                Totem Resmi &amp; Maskot Si Karu
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Tepat di sisi depan Jl. Kartini No. 24 berdiri totem resmi yang memuat nama sekolah, Akreditasi A, serta maskot Si Karu yang ramah menyapa.
              </p>
            </div>
          </div>

          <!-- Gerbang & Etalase Prestasi -->
          <div class="group bg-slate-50 rounded-3xl overflow-hidden border border-slate-200/90 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div class="aspect-16/10 overflow-hidden bg-slate-100 relative">
              <img
                src="/sdk/gerbang-prestasi.jpg"
                alt="Gerbang Masuk Utama dan Etalase Piala Prestasi SDK Maria Fatima"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-slate-900/85 backdrop-blur-md text-white text-xs font-bold shadow-xs">
                Pintu Masuk &amp; Akses Tamu
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading font-bold text-lg text-slate-900 mb-1.5">
                Gerbang Masuk &amp; Selasar Penerima Tamu
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Akses masuk berkanopi teduh yang dilengkapi etalase piala prestasi kebanggaan siswa serta jalur selasar langsung menuju ruang tata usaha.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Maps Embed -->
    <section class="py-12 bg-white border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="w-full h-96 rounded-3xl overflow-hidden shadow-lg border border-slate-200">
          <iframe
            title="Peta Lokasi SDK Maria Fatima Jember"
            class="w-full h-full border-0"
            src={SITE_CONFIG.mapsEmbedUrl || "https://maps.google.com/maps?q=-8.1713365,113.7008447&hl=id&z=17&output=embed"}
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
