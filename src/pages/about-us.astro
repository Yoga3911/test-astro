---
/**
 * about-us.astro — Halaman Mengenalkan SDK Maria Fatima
 *
 * Dokumen Resmi Sekolah:
 * - Sejarah Singkat SDK Maria Fatima
 * - Visi & Misi SD Katolik Maria Fatima
 * - Tujuan SD Katolik Maria Fatima
 * - Core Values UKB (Unggul, Kasih, Bermartabat)
 * - Profil Lulusan SD Katolik Maria Fatima
 * - Profil Guru SD Katolik Maria Fatima
 * - Tagline Resmi: "Living Values, Creating Digitally"
 * - Tata Tertib Sekolah
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { 
  VISI_MISI_DATA, 
  TUJUAN_SDK, 
  PROFIL_LULUSAN_SDK, 
  PROFIL_GURU_SDK, 
  CORE_VALUES_UKB, 
  SITE_CONFIG 
} from '@/utils/config';

// ─── Data Tata Tertib ───────────────────────────────────────────────────────
const TATA_TERTIB_ITEMS = [
  {
    category: 'Kehadiran & Disiplin Waktu',
    rules: [
      'Siswa hadir di sekolah paling lambat pukul 06.45 WIB sebelum bel masuk berbunyi.',
      'Kegiatan belajar mengajar (KBM) dimulai dengan doa pagi dan lagu kebangsaan Indonesia Raya.',
      'Siswa yang berhalangan hadir wajib menyampaikan surat izin tertulis atau pemberitahuan orang tua ke wali kelas.',
    ],
  },
  {
    category: 'Seragam & Kerapian Diri',
    rules: [
      'Mengenakan seragam lengkap sesuai jadwal harian (Putih-Merah, Batik Yayasan SPM, Pramuka, Kaos Olahraga).',
      'Memakai sepatu hitam bertali/perekat dan kaos kaki putih berlogo sekolah.',
      'Rambut rapi dan bersih; putra tidak menutupi kerah dan telinga, putri yang berambut panjang diikat rapi.',
    ],
  },
  {
    category: 'Sikap, Budi Pekerti & Relasi',
    rules: [
      'Menerapkan budaya 5S (Senyum, Salam, Sapa, Sopan, Santun) kepada suster, bapak/ibu guru, karyawan, dan sesama teman.',
      'Menjaga sikap saling menghormati dan menolak segala bentuk perundungan (zero tolerance for bullying).',
      'Membiasakan membuang sampah pada tempatnya dan merawat kebersihan fasilitas sekolah bersama.',
    ],
  },
  {
    category: 'Penggunaan Gawai & Barang Bawaan',
    rules: [
      'Penggunaan tablet/gawai hanya diizinkan saat sesi pembelajaran terarah di bawah bimbingan guru.',
      'Dilarang membawa mainan berbahaya, perhiasan berlebih, atau barang non-edukatif ke lingkungan sekolah.',
      'Menjaga barang pribadi masing-masing dengan memberi label nama yang jelas.',
    ],
  },
];
---

<BaseLayout
  title="About Us — Mengenal SDK Maria Fatima"
  description="Visi, Misi, Tujuan, Core Values UKB, Profil Lulusan, Profil Guru, dan Sejarah SDK Maria Fatima Jember — Living Values, Creating Digitally."
>
  <Header />

  <main id="main-content">
    
    <!-- Hero Subpage Header -->
    <section class="bg-gradient-to-b from-blue-50/80 via-white to-slate-50 border-b border-slate-200/80 py-16 sm:py-20 relative overflow-hidden">
      <!-- Decorative ambient glows -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-blue-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider border border-blue-200 shadow-xs">
          <span>TAGLINE: “LIVING VALUES, CREATING DIGITALLY”</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight text-slate-900">
          About Us: SDK Maria Fatima
        </h1>
        <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto font-normal leading-relaxed">
          Menghidupi nilai-nilai kebenaran, menciptakan karya dengan teknologi — mendampingi tunas muda yang berkarakter luhur, berprestasi, dan berwawasan global.
        </p>

        <!-- Quick Section Links -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
          <a href="#sejarah" class="px-3 py-1 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs font-bold text-slate-700 hover:text-blue-700 shadow-xs transition-all">
            Sejarah
          </a>
          <a href="#visi-misi" class="px-3 py-1 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs font-bold text-slate-700 hover:text-blue-700 shadow-xs transition-all">
            Visi &amp; Misi
          </a>
          <a href="#tujuan-sekolah" class="px-3 py-1 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs font-bold text-slate-700 hover:text-blue-700 shadow-xs transition-all">
            Tujuan
          </a>
          <a href="#core-values" class="px-3 py-1 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs font-bold text-slate-700 hover:text-blue-700 shadow-xs transition-all">
            Core Value UKB
          </a>
          <a href="#profil-lulusan" class="px-3 py-1 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs font-bold text-slate-700 hover:text-blue-700 shadow-xs transition-all">
            Profil Lulusan
          </a>
          <a href="#profil-guru" class="px-3 py-1 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs font-bold text-slate-700 hover:text-blue-700 shadow-xs transition-all">
            Profil Guru
          </a>
        </div>
      </div>
    </section>

    <!-- 1. SEJARAH SDK MARIA FATIMA -->
    <section id="sejarah" class="py-16 sm:py-24 bg-white scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-6 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase">
              <span>SEJARAH SINGKAT</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
              Lebih Dari 65 Tahun Menyemai Kasih &amp; Ilmu di Jember
            </h2>
            <div class="space-y-4 text-slate-600 text-base sm:text-lg leading-relaxed text-justify">
              <p>
                <strong>SDK Maria Fatima Jember</strong> lahir dari kerinduan luhur untuk menghadirkan pelayanan pendidikan dasar Katolik yang bermutu tinggi dan penuh kasih bagi masyarakat Kabupaten Jember dan sekitarnya.
              </p>
              <p>
                Dengan bimbingan para Suster perintis Kongregasi SPM (Suster-suster Santa Perawan Maria), sekolah ini berkembang dari kelas-kelas bersahaja menjadi institusi pendidikan unggulan yang dipercaya lintas generasi. Ribuan alumni telah lahir dan berkiprah menjadi pemimpin, profesional, akademisi, rohaniwan, dan tokoh masyarakat yang berintegritas.
              </p>
              <p>
                Hingga kini, di era transformasi digital dan Kurikulum Merdeka, SDK Maria Fatima terus memperbarui metodologi pengajaran modern tanpa pernah meninggalkan akar spiritualitas kasih dan pendidikan hati yang menjadi jati dirinya.
              </p>
            </div>
          </div>

          <div class="lg:col-span-6">
            <div class="bg-white rounded-3xl p-8 sm:p-10 text-slate-900 shadow-xl border border-slate-200/90 space-y-6 relative overflow-hidden group">
              <!-- Subtle decorative accent -->
              <div class="absolute top-0 right-0 w-40 h-40 bg-blue-50/80 rounded-full blur-2xl pointer-events-none -z-10"></div>

              <div class="flex items-center gap-3.5 border-b border-slate-100 pb-5">
                <span class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center shadow-xs">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </span>
                <div>
                  <div class="text-[11px] uppercase font-extrabold tracking-wider text-amber-700">IDENTITAS SEKOLAH</div>
                  <div class="text-xl font-heading font-black text-slate-900">{SITE_CONFIG.foundation}</div>
                </div>
              </div>

              <div class="space-y-4">
                <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:bg-blue-50/40 hover:border-blue-200 transition-colors">
                  <div class="font-heading font-black text-slate-900 text-sm mb-1.5 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                    <span>Misi Suci Pendidikan</span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                    Menyediakan akses pembelajaran berkualitas bagi setiap anak, menanamkan toleransi, cinta tanah air, dan iman yang mendalam.
                  </p>
                </div>

                <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:bg-amber-50/40 hover:border-amber-200 transition-colors">
                  <div class="font-heading font-black text-slate-900 text-sm mb-1.5 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span>Spirit Pelindung Bunda Maria Fatima</span>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                    Meneladani kerendahan hati, ketabahan, dan kepedulian Bunda Maria dalam mendampingi tumbuh kembang putra-putri kita.
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. VISI & MISI SD KATOLIK MARIA FATIMA -->
    <section id="visi-misi" class="py-16 sm:py-24 bg-slate-50 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase mb-3">
            <span>VISI &amp; MISI SEKOLAH</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
            Arah &amp; Kompas Utama Pendidikan Kami
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          <!-- Visi Card -->
          <div class="lg:col-span-5 bg-white text-slate-900 rounded-3xl p-8 sm:p-10 shadow-md border border-slate-200/90 flex flex-col justify-between hover:shadow-xl hover:border-blue-300 transition-all duration-300 group">
            <div class="space-y-6">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center group-hover:scale-110 transition-transform shadow-xs">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-blue-700 block">VISI SEKOLAH</span>
                  <h3 class="text-2xl font-heading font-black text-slate-900">Visi SDK Maria Fatima</h3>
                </div>
              </div>
              <blockquote class="text-lg sm:text-xl font-heading font-bold text-slate-800 leading-relaxed border-l-4 border-blue-600 pl-4 py-3 bg-blue-50/40 rounded-r-2xl">
                "{VISI_MISI_DATA.visi}"
              </blockquote>
              <p class="text-xs sm:text-sm text-slate-500 leading-relaxed font-normal">
                Membentuk lingkungan belajar yang ramah anak, berakar pada cinta kasih Kristiani, menjunjung martabat kemanusiaan, serta memiliki kompetensi dan wawasan global di era digital.
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-slate-100 text-xs text-slate-500 font-bold uppercase tracking-wider flex items-center gap-2">
              <span>SDK Maria Fatima Jember</span>
            </div>
          </div>

          <!-- Misi Card -->
          <div class="lg:col-span-7 bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm flex flex-col justify-between space-y-6">
            <div>
              <div class="flex items-center gap-3 mb-5">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center shadow-xs">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div>
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 block">MISI SEKOLAH</span>
                  <h3 class="text-2xl font-heading font-black text-slate-900">Misi SD Katolik Maria Fatima</h3>
                  <p class="text-xs font-semibold text-slate-500">Langkah Operasional dan Strategi Pembelajaran</p>
                </div>
              </div>

              <div class="space-y-3 pt-1">
                {VISI_MISI_DATA.misi.map((m, idx) => (
                  <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-blue-50/50 hover:border-blue-200 transition-colors">
                    <span class="w-6 h-6 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
                      {idx + 1}
                    </span>
                    <p class="text-sm text-slate-700 font-medium leading-relaxed">
                      {m}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. TUJUAN SD KATOLIK MARIA FATIMA (BARU) -->
    <section id="tujuan-sekolah" class="py-16 sm:py-24 bg-white relative overflow-hidden scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-widest mb-3 border border-blue-200 shadow-xs">
            <span>TARGET &amp; SASARAN STRATEGIS</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight">
            Tujuan SD Katolik Maria Fatima
          </h2>
          <p class="text-slate-600 mt-3 text-base sm:text-lg">
            Sasaran mutu dan capaian nyata yang menjadi komitmen seluruh sivitas akademika dalam mendidik generasi penerus bangsa.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {TUJUAN_SDK.map((t) => (
            <div class="bg-gradient-to-br from-slate-50 to-white rounded-3xl p-7 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-blue-300 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 border border-blue-200/60 flex items-center justify-center font-heading font-black text-base shadow-xs group-hover:bg-blue-600 group-hover:text-white transition-all">
                    0{t.number}
                  </span>
                  <span class="text-xs font-black px-3 py-1 rounded-full bg-blue-100 text-blue-800 border border-blue-200">
                    Tujuan #{t.number}
                  </span>
                </div>
                <h3 class="text-lg font-heading font-black text-slate-900 mb-2 group-hover:text-blue-700 transition-colors">
                  {t.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                  {t.description}
                </p>
              </div>
              <div class="pt-4 mt-4 border-t border-slate-200/60 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                Sasaran Mutu Sekolah
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. CORE VALUES UKB (UNGGUL, KASIH, BERMARTABAT) -->
    <section id="core-values" class="py-16 sm:py-24 bg-slate-50 relative overflow-hidden scroll-mt-20">
      <!-- Decorative ambient glows -->
      <div class="absolute top-1/2 left-0 w-96 h-96 bg-blue-50/70 rounded-full blur-3xl pointer-events-none -translate-y-1/2 -z-10"></div>
      <div class="absolute top-1/2 right-0 w-96 h-96 bg-amber-50/70 rounded-full blur-3xl pointer-events-none -translate-y-1/2 -z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-widest mb-3 border border-blue-200 shadow-xs">
            <span>CORE VALUES SDK MARIA FATIMA</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight">
            Nilai Luhur UKB
          </h2>
          <p class="text-slate-600 mt-4 text-base sm:text-lg leading-relaxed">
            Sebagai lembaga pendidikan yang berkomitmen membentuk generasi unggul dan berkarakter, SD Katolik Maria Fatima Jember menanamkan nilai-nilai luhur yang dirangkum dalam <strong>Core Value UKB</strong>: <span class="text-blue-700 font-bold">Unggul</span>, <span class="text-red-600 font-bold">Kasih</span>, dan <span class="text-yellow-600 font-bold">Bermartabat</span> — identitas yang menjiwai budaya dan perjalanan pendidikan kami.
          </p>
        </div>

        <!-- 3 Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
          {CORE_VALUES_UKB.map((cv) => (
            <div class={`group bg-white rounded-3xl p-8 sm:p-9 border border-slate-200/90 shadow-lg hover:shadow-2xl ${cv.theme.borderHover} transition-all duration-300 flex flex-col justify-between relative overflow-hidden hover:-translate-y-1.5`}>
              
              <!-- Ambient Top Accent Gradient -->
              <div class={`absolute top-0 left-0 right-0 h-2 bg-gradient-to-r ${cv.theme.badge}`}></div>

              <div>
                <!-- Header Card: Letter Badge + Title + Subtitle -->
                <div class="flex items-center gap-4 mb-6">
                  <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${cv.theme.badge} font-heading font-black text-2xl flex items-center justify-center shadow-md shrink-0 group-hover:scale-105 transition-transform`}>
                    {cv.letter}
                  </div>
                  <div>
                    <div class="text-[11px] font-extrabold uppercase tracking-widest text-slate-400">Core Value</div>
                    <h3 class="text-2xl sm:text-3xl font-heading font-black tracking-tight text-slate-900">
                      {cv.name}
                    </h3>
                  </div>
                </div>

                <!-- Tagline Highlight -->
                <div class={`p-4 rounded-2xl ${cv.theme.lightBg} border border-slate-100 mb-5`}>
                  <p class={`text-sm font-bold ${cv.theme.textAccent} leading-snug`}>
                    "{cv.tagline}"
                  </p>
                </div>

                <!-- Main Narrative -->
                <p class="text-sm text-slate-600 leading-relaxed font-normal mb-6">
                  {cv.fullDesc}
                </p>

                <!-- Pillars / Key Takeaways -->
                <div class="space-y-2.5 pt-5 border-t border-slate-100">
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 mb-3">
                    Fokus Pembinaan Karakter:
                  </div>
                  {cv.points.map((pt) => (
                    <div class="flex items-start gap-2.5 text-xs sm:text-sm font-medium text-slate-700">
                      <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{pt}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Card Bottom Accent -->
              <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 font-bold uppercase tracking-wider">
                <span>SDK Maria Fatima</span>
                <span class={cv.theme.textAccent}>Nilai UKB →</span>
              </div>

            </div>
          ))}
        </div>

        <!-- Heritage Bridge Box -->
        <div class="mt-14 p-6 sm:p-8 rounded-3xl bg-white border border-slate-200/90 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
          <div class="flex items-start gap-4">
            <span class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </span>
            <div>
              <h4 class="font-heading font-black text-slate-900 text-base">Pondasi Spiritualitas &amp; Nilai Yayasan SPM</h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed font-normal">
                Nilai UKB berakar kuat pada warisan rohani Kongregasi Suster SPM (Suster Santa Perawan Maria), keteladanan Santa Julie Billiart, serta misi pendidikan kasih Perkumpulan Dharmaputri.
              </p>
            </div>
          </div>
          <a
            href="/heritage"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-slate-50 border border-slate-200/90 hover:border-blue-400 text-blue-700 hover:text-blue-800 font-bold text-xs shadow-xs hover:shadow-md transition-all shrink-0 active:scale-95"
          >
            <span>Pelajari Halaman Heritage</span>
            <span>↗</span>
          </a>
        </div>

      </div>
    </section>

    <!-- 5. PROFIL LULUSAN SD KATOLIK MARIA FATIMA -->
    <section id="profil-lulusan" class="py-16 sm:py-24 bg-white relative overflow-hidden scroll-mt-20">
