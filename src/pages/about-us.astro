---
/**
 * about-us.astro — Halaman Mengenal SDK Maria Fatima
 *
 * Struktur Halaman (Selaras dengan Submenu Navigasi):
 * 1. Sejarah SDK (1 container paragraf naratif terpadu 1928–sekarang)
 * 2. Visi, Misi & Profil Lulusan (Kompas visi misi & 6 dimensi lulusan)
 * 3. Core Value (UKB: Unggul, Kasih, Bermartabat)
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { 
  VISI_MISI_DATA, 
  PROFIL_LULUSAN_SDK, 
  CORE_VALUES_UKB, 
  SITE_CONFIG 
} from '@/utils/config';
---

<BaseLayout
  title="About Us — Mengenal SDK Maria Fatima"
  description="Sejarah SDK Maria Fatima Jember sejak 1928, Visi, Misi, Profil Lulusan, serta Core Value UKB (Unggul, Kasih, Bermartabat)."
>
  <Header />

  <main id="main-content">
    
    <!-- Hero Subpage Header -->
    <section class="bg-gradient-to-b from-blue-50/80 via-white to-slate-50 border-b border-slate-200/80 py-16 sm:py-20 relative overflow-hidden">
      <!-- Decorative ambient glows -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-blue-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider border border-blue-200 shadow-xs">
          <span>“LIVING VALUES, CREATING DIGITALLY”</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight text-slate-900">
          SDK Maria Fatima
        </h1>
        <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto font-normal leading-relaxed">
          Menghidupi nilai-nilai kebenaran, menciptakan karya dengan teknologi — mendampingi tunas muda yang berkarakter luhur, berprestasi, dan berwawasan global.
        </p>

        <!-- Quick Section Links (3 Menu Utama) -->
        <div class="flex flex-wrap items-center justify-center gap-2.5 pt-3">
          <a
            href="#sejarah-sdk"
            class="px-4 py-2 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs sm:text-sm font-bold text-slate-700 hover:text-blue-700 shadow-xs hover:shadow-md transition-all active:scale-95"
          >
            Sejarah SDK
          </a>
          <a
            href="#visi-misi-profil-lulusan"
            class="px-4 py-2 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs sm:text-sm font-bold text-slate-700 hover:text-blue-700 shadow-xs hover:shadow-md transition-all active:scale-95"
          >
            Visi, Misi &amp; Profil Lulusan
          </a>
          <a
            href="#core-value-ukb"
            class="px-4 py-2 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-xs sm:text-sm font-bold text-slate-700 hover:text-blue-700 shadow-xs hover:shadow-md transition-all active:scale-95"
          >
            Core Value (UKB)
          </a>
        </div>
      </div>
    </section>

    <!-- 1. SEJARAH SDK (Disusun dalam 1 Container Berbentuk Paragraf Naratif) -->
    <section id="sejarah-sdk" class="py-16 sm:py-24 bg-white scroll-mt-28">
      <!-- Alias id untuk kompatibilitas tautan lama -->
      <div id="sejarah" class="sr-only"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header Judul -->
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase mb-3 border border-blue-200">
            <span>WARISAN &amp; SEJARAH KARYA PENDIDIKAN</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight">
            Sejarah SDK
          </h2>
          <p class="text-slate-600 mt-3 text-base sm:text-lg">
            Perjalanan panjang pelayanan kasih dan pendidikan berkualitas Kongregasi Suster SPM di Jember sejak tahun 1928 hingga saat ini.
          </p>
        </div>

        <!-- 1 Unified Container -->
        <article class="bg-gradient-to-br from-slate-50 via-white to-blue-50/30 rounded-3xl p-8 sm:p-12 lg:p-14 border border-slate-200/90 shadow-xl relative overflow-hidden">
          <!-- Subtle ambient accent -->
          <div class="absolute top-0 right-0 w-72 h-72 bg-blue-100/50 rounded-full blur-3xl pointer-events-none -z-10"></div>
          <div class="absolute bottom-0 left-0 w-72 h-72 bg-amber-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

          <!-- Top Badge & Identity Line -->
          <div class="flex flex-wrap items-center justify-between gap-4 pb-8 border-b border-slate-200/80 mb-8">
            <div class="flex items-center gap-3">
              <span class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-md">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </span>
              <div>
                <span class="text-[11px] uppercase font-extrabold tracking-wider text-blue-700 block">KILAS HISTORIS RESMI</span>
                <h3 class="text-xl sm:text-2xl font-heading font-black text-slate-900">Perjalanan Pendidikan SD Katolik Maria Fatima</h3>
              </div>
            </div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 shadow-2xs text-xs font-bold text-slate-700">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>1928 — Sekarang</span>
            </div>
          </div>

          <!-- School Building Photo Showcase -->
          <div class="mb-8 rounded-3xl overflow-hidden border border-slate-200/90 shadow-md relative group">
            <div class="aspect-16/9 sm:aspect-21/9 overflow-hidden bg-slate-100">
              <img
                src="/sdk/gedung-lapangan.jpg"
                alt="Gedung Utama Bersejarah dan Lapangan Upacara SDK Maria Fatima Jember"
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700"
                loading="lazy"
              />
            </div>
            <div class="p-4 sm:p-5 bg-white/95 backdrop-blur-xs border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm text-slate-600">
              <span class="font-bold text-slate-900 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                Gedung Utama &amp; Lapangan Upacara SDK Maria Fatima Jember
              </span>
              <span class="text-slate-500 font-medium text-xs">Jl. Kartini No. 24, Jember</span>
            </div>
          </div>

          <!-- Simplified Narrative Paragraphs -->
          <div class="space-y-6 text-slate-700 text-base sm:text-lg leading-relaxed text-justify">
            
            <!-- Paragraf 1: Awal Misi (1928) -->
            <p>
              Perjalanan pendidikan SD Katolik Maria Fatima berakar dari panggilan kasih dan dedikasi luhur Kongregasi Suster Santa Perawan Maria (SPM). Pada masa ketika kesempatan bersekolah masih sangat terbatas, tiga suster perintis dari Probolinggo—<strong>Sr. Ignatia, Sr. Urbana, dan Sr. Rosalia</strong>—tiba di Jember pada tanggal <strong>22 Desember 1928</strong>. Tanpa memiliki gedung sendiri dan bertempat tinggal sementara di kawasan Jalan Diponegoro, keterbatasan sarana tidak menyurutkan semangat mereka dalam menghadirkan pendidikan bermutu bagi generasi muda seiring kian bertambahnya anak-anak yang rindu belajar.
            </p>

            <!-- Paragraf 2: Pusat Pendidikan & Peresmian SRK (1929 - 1935) -->
            <p>
              Berbekal ketekunan doa dan dukungan tulus dari masyarakat, pembangunan rumah biara sekaligus sekolah berhasil diwujudkan pada awal tahun <strong>1929</strong> melalui pembukaan tiga ruang kelas pertama. Kepercayaan masyarakat yang terus bertumbuh pesat mendorong penambahan fasilitas secara berkala hingga pada <strong>1 Februari 1935</strong>, sekolah resmi berdiri dengan nama <strong>SRK Maria Fatima</strong> (Sekolah Rakyat Katolik Maria Fatima). Peristiwa ini menjadi tonggak penting berdirinya lembaga pendidikan Katolik yang tidak hanya mengasah kecerdasan intelektual, melainkan juga membentuk integritas karakter dan nilai-nilai luhur kehidupan.
            </p>

            <!-- Paragraf 3: Ujian Masa Perang & Harapan Pasca Kemerdekaan (1942 - 1948) -->
            <p>
              Tantangan besar melanda saat pecahnya Perang Dunia II dan masa pendudukan Jepang tahun <strong>1942</strong>, di mana kegiatan belajar mengajar terpaksa terhenti, para suster berkewarganegaraan Belanda harus menjalani masa interniran, serta gedung sekolah dialihfungsikan untuk kepentingan militer. Kendati demikian, nyala semangat pelayanan dan iman para pendiri tetap hidup. Pascakemerdekaan Indonesia, para Suster SPM kembali ke Jember pada akhir tahun 1947 untuk merajut kembali misi pendidikan yang sempat tertunda. Pada <strong>15 Januari 1948</strong>, kegiatan belajar mengajar kembali bergulir dengan antusiasme masyarakat yang luar biasa besar untuk kembali mengisi ruang-ruang kelas.
            </p>

            <!-- Paragraf 4: Era Indonesia Baru & Penyatuan Satu Sekolah (1950 - Sekarang) -->
            <p>
              Memasuki babak baru pada tahun <strong>1950</strong>, Bahasa Indonesia secara resmi diadopsi sebagai bahasa pengantar pembelajaran demi memperkokoh semangat persatuan dan kebangsaan. Menjawab dinamika zaman dan perkembangan dunia pendidikan modern, pada <strong>1 Juli 2000</strong> SDK Maria Fatima I dan SDK Maria Fatima II resmi dipersatukan menjadi satu kesatuan: <strong>SD Katolik Maria Fatima Jember</strong>. Langkah strategis ini memperkokoh mutu layanan, mengoptimalkan tata kelola sumber daya, dan memantapkan langkah sekolah menuju masa depan. Hingga kini, SD Katolik Maria Fatima Jember terus setia melanjutkan warisan para pendiri: membina tunas muda yang beriman mendalam, berkarakter luhur, berprestasi unggul, serta siap berkarya dengan tulus bagi masyarakat dan bangsa.
            </p>

          </div>

          <!-- Bottom Milestone Strip inside container -->
          <div class="mt-10 pt-8 border-t border-slate-200/80 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
            <div class="p-3.5 rounded-2xl bg-white border border-slate-200/70 shadow-2xs">
              <span class="block text-xl font-heading font-black text-blue-700">1928</span>
              <span class="text-xs font-semibold text-slate-500">Kedatangan Perintis SPM</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-slate-200/70 shadow-2xs">
              <span class="block text-xl font-heading font-black text-blue-700">1935</span>
              <span class="text-xs font-semibold text-slate-500">Peresmian SRK Maria Fatima</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-slate-200/70 shadow-2xs">
              <span class="block text-xl font-heading font-black text-blue-700">1948</span>
              <span class="text-xs font-semibold text-slate-500">KBM Bangkit Pascaperang</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-slate-200/70 shadow-2xs">
              <span class="block text-xl font-heading font-black text-blue-700">2000 — Kini</span>
              <span class="text-xs font-semibold text-slate-500">Penyatuan SDK Maria Fatima</span>
            </div>
          </div>

        </article>
      </div>
    </section>

    <!-- 2. VISI, MISI & PROFIL LULUSAN -->
    <section id="visi-misi-profil-lulusan" class="py-16 sm:py-24 bg-slate-50 scroll-mt-28">
      <!-- Alias id untuk kompatibilitas tautan lama -->
      <div id="visi-misi" class="sr-only"></div>
      <div id="profil-lulusan" class="sr-only"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        
        <!-- Header Seksi -->
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase mb-3 border border-blue-200">
            <span>ARAH STRATEGIS &amp; STANDAR KELULUSAN</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight">
            Visi, Misi &amp; Profil Lulusan
          </h2>
          <p class="text-slate-600 mt-3 text-base sm:text-lg">
            Kompas utama arah pendidikan dan standar kompetensi karakter holistik yang dibentuk pada diri setiap peserta didik SD Katolik Maria Fatima.
          </p>
        </div>

        <!-- Bagian A: Visi & Misi Card Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          
          <!-- Visi Card -->
          <div class="lg:col-span-5 bg-white text-slate-900 rounded-3xl p-8 sm:p-10 shadow-md border border-slate-200/90 flex flex-col justify-between hover:shadow-xl hover:border-blue-300 transition-all duration-300 group">
            <div class="space-y-6">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center group-hover:scale-110 transition-transform shadow-xs">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-blue-700 block">VISI SEKOLAH</span>
                  <h3 class="text-2xl font-heading font-black text-slate-900">Visi SDK Maria Fatima</h3>
                </div>
              </div>
              <blockquote class="text-lg sm:text-xl font-heading font-bold text-slate-800 leading-relaxed border-l-4 border-blue-600 pl-4 py-3 bg-blue-50/40 rounded-r-2xl">
                "{VISI_MISI_DATA.visi}"
              </blockquote>
              <p class="text-xs sm:text-sm text-slate-500 leading-relaxed font-normal">
                Membentuk lingkungan belajar yang ramah anak, berakar pada cinta kasih Kristiani, menjunjung martabat kemanusiaan, serta memiliki kompetensi dan wawasan global di era digital.
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-slate-100 text-xs text-slate-500 font-bold uppercase tracking-wider flex items-center gap-2">
              <span>SDK Maria Fatima Jember</span>
            </div>
          </div>

          <!-- Misi Card -->
          <div class="lg:col-span-7 bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm flex flex-col justify-between space-y-6">
            <div>
              <div class="flex items-center gap-3 mb-5">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center shadow-xs">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div>
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 block">MISI SEKOLAH</span>
                  <h3 class="text-2xl font-heading font-black text-slate-900">Misi SD Katolik Maria Fatima</h3>
                  <p class="text-xs font-semibold text-slate-500">Langkah Operasional dan Strategi Pembelajaran</p>
                </div>
              </div>

              <div class="space-y-3 pt-1">
                {VISI_MISI_DATA.misi.map((m) => (
                  <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-blue-50/50 hover:border-blue-200 transition-colors">
                    <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
                      <svg class="w-4 h-4 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <p class="text-sm text-slate-700 font-medium leading-relaxed">
                      {m}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>

        <!-- Bagian B: Profil Lulusan (6 Dimensi Karakter) -->
        <div class="pt-8 border-t border-slate-200/80">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold uppercase mb-3 border border-amber-200">
              <span>6 DIMENSI KARAKTER &amp; KOMPETENSI</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 tracking-tight">
              Profil Lulusan SD Katolik Maria Fatima
            </h3>
            <blockquote class="text-slate-800 font-heading font-bold text-sm sm:text-base max-w-3xl mx-auto mt-3 p-4 rounded-2xl bg-amber-50/60 border border-amber-200 italic leading-relaxed">
              "Pribadi yang beriman, mampu bernalar kritis, mengambil keputusan, kolaboratif, empati, dan berwawasan global."
            </blockquote>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {PROFIL_LULUSAN_SDK.map((p) => (
              <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-amber-300 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-800 border border-amber-200/60 flex items-center justify-center font-heading font-black text-base transition-colors shadow-xs group-hover:bg-amber-500 group-hover:text-white">
                      0{p.number}
                    </span>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 border border-blue-200">
                      Dimensi #{p.number}
                    </span>
                  </div>
                  <div class="text-[11px] font-bold text-amber-600 uppercase tracking-wider mb-1">
                    {p.aspect}
                  </div>
                  <h4 class="text-lg font-heading font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors">
                    {p.title}
                  </h4>
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                    {p.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- 3. CORE VALUE (UKB) -->
    <section id="core-value-ukb" class="py-16 sm:py-24 bg-white relative overflow-hidden scroll-mt-28">
      <!-- Alias id untuk kompatibilitas tautan lama -->
      <div id="core-values" class="sr-only"></div>

      <!-- Decorative ambient glows -->
      <div class="absolute top-1/2 left-0 w-96 h-96 bg-blue-50/70 rounded-full blur-3xl pointer-events-none -translate-y-1/2 -z-10"></div>
      <div class="absolute top-1/2 right-0 w-96 h-96 bg-amber-50/70 rounded-full blur-3xl pointer-events-none -translate-y-1/2 -z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header Judul -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-widest mb-3 border border-blue-200 shadow-xs">
            <span>NILAI INTI BUDI PEKERTI</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight">
            Core Value (UKB)
          </h2>
          <p class="text-slate-600 mt-4 text-base sm:text-lg leading-relaxed">
            Sebagai lembaga pendidikan yang berkomitmen membentuk tunas muda unggul dan berkarakter, SD Katolik Maria Fatima Jember menanamkan nilai-nilai luhur yang dirangkum dalam <strong>Core Value UKB</strong>: <span class="text-blue-700 font-bold">Unggul</span>, <span class="text-red-600 font-bold">Kasih</span>, dan <span class="text-amber-600 font-bold">Bermartabat</span>.
          </p>
        </div>

        <!-- 3 Cards Grid: Unggul, Kasih, Bermartabat -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
          {CORE_VALUES_UKB.map((cv) => (
            <div class={`group bg-white rounded-3xl p-8 sm:p-9 border border-slate-200/90 shadow-lg hover:shadow-2xl ${cv.theme.borderHover} transition-all duration-300 flex flex-col justify-between relative overflow-hidden hover:-translate-y-1.5`}>
              
              <!-- Ambient Top Accent Gradient -->
              <div class={`absolute top-0 left-0 right-0 h-2 bg-gradient-to-r ${cv.theme.badge}`}></div>

              <div>
                <!-- Header Card: Letter Badge + Title + Subtitle -->
                <div class="flex items-center gap-4 mb-6">
                  <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${cv.theme.badge} font-heading font-black text-2xl flex items-center justify-center shadow-md shrink-0 group-hover:scale-105 transition-transform`}>
                    {cv.letter}
                  </div>
                  <div>
                    <div class="text-[11px] font-extrabold uppercase tracking-widest text-slate-400">Core Value</div>
                    <h3 class="text-2xl sm:text-3xl font-heading font-black tracking-tight text-slate-900">
                      {cv.name}
                    </h3>
                  </div>
                </div>

                <!-- Tagline Highlight -->
                <div class={`p-4 rounded-2xl ${cv.theme.lightBg} border border-slate-100 mb-5`}>
                  <p class={`text-sm font-bold ${cv.theme.textAccent} leading-snug`}>
                    "{cv.tagline}"
                  </p>
                </div>

                <!-- Main Narrative -->
                <p class="text-sm text-slate-600 leading-relaxed font-normal mb-6">
                  {cv.fullDesc}
                </p>

                <!-- Pillars / Key Takeaways -->
                <div class="space-y-2.5 pt-5 border-t border-slate-100">
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 mb-3">
                    Fokus Pembinaan Karakter:
                  </div>
                  {cv.points.map((pt) => (
