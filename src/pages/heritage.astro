---
/**
 * heritage.astro — Warisan Rohani, Tokoh Pendiri, Sejarah Kongregasi SPM & Maskot
 *
 * Konten resmi dari 5 dokumen arsip:
 * 1. Santa Julie Billiart (Inspirasi Pendidikan Kasih & Martabat)
 * 2. Pater Mathias Wolff, SJ (Perintis & Pendiri Kongregasi SPM)
 * 3. Sejarah Berdirinya Kongregasi SPM di Indonesia & Perkumpulan Dharmaputri
 *    - Pendaratan Probolinggo 1926
 *    - Carousel Spiritualitas Suster SPM (Immensitas Bonitas Dei, Ecce Ancilla Domini, Belas Kasih)
 *    - Latar Belakang Badan Hukum, Makna Dharmaputri & Peran Saat Ini
 * 4. Tota Christi Per Mariam (Makna Lambang & Spiritualitas)
 * 5. Maskot "Si Karu" (Filosofi & Makna Simbolis)
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CarouselSpiritualitasSPM from '@/components/CarouselSpiritualitasSPM.svelte';
import { SITE_CONFIG } from '@/utils/config';

// ─── Data Bedah Logo Tota Christi Per Mariam ────────────────────────────────
const LOGO_ELEMENTS = [
  {
    title: 'Salib Kristus (P)',
    desc: 'Untuk membawa dan melahirkan kehidupan sejati, hanya mungkin melalui jalan salib Kristus sebagaimana dialami Maria: jalan hati yang tertusuk pedang.',
    badge: 'KORBAN & KASIH',
    color: 'border-red-200 bg-red-50/50 text-red-800',
  },
  {
    title: 'Inisial Bunda Maria (M)',
    desc: 'Jalan kita untuk seutuhnya menjadi milik Kristus ditempuh melalui jalan Maria, yaitu jalan yang setia mengandung, memelihara, dan melahirkan Sabda Allah.',
    badge: 'JALAN MARIA',
    color: 'border-blue-200 bg-blue-50/50 text-blue-800',
  },
  {
    title: 'Bunga Matahari Mekar',
    desc: 'Melambangkan keterbukaan dan keterarahan hati kepada Kristus Sang Matahari Sejati. Seperti rahim Maria yang siap menerima limpahan cahaya daya hidup Allah.',
    badge: 'KETERARAHAN HATI',
    color: 'border-amber-200 bg-amber-50/50 text-amber-800',
  },
  {
    title: 'Matahari di Tengah Salib & Sinar',
    desc: 'Keberadaan hidup kita senantiasa bernaung dalam kuasa Allah dan Roh Kudus, menyerap kehidupan dari Kristus lalu menyebarkannya ke dunia melalui perutusan karya.',
    badge: 'PERUTUSAN DUNIA',
    color: 'border-yellow-200 bg-yellow-50/50 text-yellow-800',
  },
  {
    title: 'Biji & Batang pada Salib',
    desc: 'Biji melambangkan lubuk hati (rahim jiwa) yang mengandung sabda benih kehidupan ilahi. Batang melambangkan kesatuan hati dengan Kristus dan kekuatan doa yang mengalir dalam karya.',
    badge: 'DOA & KARYA',
    color: 'border-blue-200 bg-blue-50/50 text-blue-800',
  },
  {
    title: 'Lingkaran & Warna Kuning Paskah',
    desc: 'Lingkaran melambangkan persekutuan satu keluarga persaudaraan (fraternitas). Warna kuning melambangkan kemuliaan sukacita Paskah yang lahir sesudah dukacita salib.',
    badge: 'PERSAUDARAAN & PASKAH',
    color: 'border-blue-200 bg-blue-50/50 text-blue-800',
  },
];

// ─── Data Bedah Maskot Si Karu ──────────────────────────────────────────────
const MASKOT_ELEMENTS = [
  {
    label: 'Sosok Hewan Rusa',
    desc: 'Mempresentasikan simbol surga dan sosok elegan yang mengatasi tantangan dengan kemurnian hati. Tanduk rusa menggambarkan ke-Unggul-an dan ketangguhan karakter.',
  },
  {
    label: 'Warna Pakaian (Kuning, Merah, Biru)',
    desc: 'Tiga warna ciri khas Perkumpulan Dharmaputri. Warna cokelat kulit rusa melambangkan kejujuran, integritas, dan ketulusan hati yang membumi.',
  },
  {
    label: 'Perisai Tota Christi Per Mariam',
    desc: 'Membentengi dan melindungi seluruh warga Dharmaputri agar seutuhnya milik Kristus melalui Maria, sekaligus mengusung Core Values: Unggul, Kasih, dan Bermartabat.',
  },
  {
    label: 'Bunga Matahari (Ikat Jubah)',
    desc: 'Lambang keterbukaan batin dan keterarahan seluruh cita-cita kepada Kristus Sang Matahari Sejati.',
  },
  {
    label: 'Jubah Warna Merah & Kuning',
    desc: 'Menggambarkan keanggunan, wibawa kepemimpinan, dan sukacita pelayanan yang tulus bagi generasi muda.',
  },
  {
    label: 'Hati (Ikat Pinggang)',
    desc: 'Simbol pengendali emosi yang luhur, moralitas yang teguh, belas kasih kepada sesama, serta spiritualitas yang mendalam.',
  },
];
---

<BaseLayout
  title="Heritage & Spiritualitas SPM — Warisan Rohani & Sejarah"
  description="Sejarah Kongregasi Suster SPM di Indonesia, teladan Santa Julie Billiart, Pater Mathias Wolff, SJ, Perkumpulan Dharmaputri, Logo Tota Christi Per Mariam, dan Maskot Si Karu."
>
  <Header />

  <main id="main-content">
    
    <!-- Hero Subpage Header -->
    <section class="bg-gradient-to-b from-blue-50/90 via-white to-slate-50 border-b border-slate-200/80 py-16 sm:py-20 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-blue-100/50 rounded-full blur-3xl -z-10 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-amber-100/50 rounded-full blur-3xl -z-10 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-widest border border-blue-200 shadow-xs">
          <span>WARISAN SPIRITUAL &amp; SEJARAH KONGREGASI</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight text-slate-900">
          Heritage &amp; Spiritualitas
        </h1>
        <p class="text-slate-600 text-base sm:text-lg max-w-3xl mx-auto font-normal leading-relaxed">
          Mengenal akar iman yang mendalam, teladan hidup para perintis, perjalanan sejarah Kongregasi Suster SPM &amp; Perkumpulan Dharmaputri di tanah air, serta makna lambang dan maskot kebanggaan sekolah.
        </p>

        <!-- Quick Navigation Jump Pills -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-4">
          <a href="#st-julie" class="px-3.5 py-1.5 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-slate-700 hover:text-blue-700 text-xs font-bold transition-all shadow-xs">
            St. Julie Billiart
          </a>
          <a href="#pater-wolff" class="px-3.5 py-1.5 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-slate-700 hover:text-blue-700 text-xs font-bold transition-all shadow-xs">
            Pater Mathias Wolff
          </a>
          <a href="#sejarah-spm" class="px-3.5 py-1.5 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-slate-700 hover:text-blue-700 text-xs font-bold transition-all shadow-xs">
            Sejarah SPM di Indonesia
          </a>
          <a href="#tota-christi" class="px-3.5 py-1.5 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-slate-700 hover:text-blue-700 text-xs font-bold transition-all shadow-xs">
            Tota Christi Per Mariam
          </a>
          <a href="#si-karu" class="px-3.5 py-1.5 rounded-full bg-white hover:bg-blue-50 border border-slate-200 text-slate-700 hover:text-blue-700 text-xs font-bold transition-all shadow-xs">
            Maskot Si Karu
          </a>
        </div>
      </div>
    </section>

    <!-- Content Sections Container -->
    <div class="py-16 sm:py-24 bg-slate-50 space-y-20 sm:space-y-28">
      
      <!-- ===================================================================
           1. SANTA JULIE BILLIART (PDF 1)
      ==================================================================== -->
      <section id="st-julie" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-28">
        <div class="bg-white rounded-3xl p-8 sm:p-12 md:p-14 border border-slate-200/90 shadow-xl relative overflow-hidden">
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
            
            <!-- Left: Portrait & Timeline Card -->
            <div class="lg:col-span-5 flex flex-col items-center text-center">
              <div class="relative w-full max-w-sm rounded-3xl overflow-hidden shadow-2xl border-4 border-white ring-1 ring-slate-200/80 bg-amber-50/50">
                <img
                  src="/images/heritage/st-julie.png"
                  alt="Santa Julie Billiart mendidik anak-anak"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/80 via-slate-900/40 to-transparent p-4 text-white text-left">
                  <div class="font-heading font-black text-lg">Santa Julie Billiart</div>
                  <div class="text-xs text-amber-300 font-semibold">12 Juli 1751 – 8 April 1816 • Cuvilly, Prancis</div>
                </div>
              </div>

              <!-- Quote Pill -->
              <div class="mt-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-center max-w-sm">
                <p class="font-serif italic font-semibold text-sm sm:text-base">
                  "Ah! Qu'il est bon le Bon Dieu!"
                </p>
                <div class="text-xs text-amber-700 font-bold uppercase tracking-wider mt-1">
                  Betapa baiknya Allah yang Mahabaik itu!
                </div>
              </div>
            </div>

            <!-- Right: Content & Simplification -->
            <div class="lg:col-span-7 space-y-6">
              <div>
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold uppercase tracking-wider mb-2">
                  <span>TOKOH SPIRITUALITAS PENDIDIKAN</span>
                </div>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-slate-900 tracking-tight">
                  Santa Julie Billiart
                </h2>
                <p class="text-base sm:text-lg font-bold text-amber-600 mt-1">
                  Inspirasi Pendidikan yang Berakar pada Iman dan Kasih
                </p>
              </div>

              <!-- Summary Paragraphs -->
              <div class="space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed text-justify">
                <p>
                  <strong>Santa Julie Billiart</strong> lahir pada 12 Juli 1751 di Cuvilly, Prancis. Sejak usia muda, ia dikenal sebagai pribadi yang memiliki iman mendalam dan kecintaan besar terhadap pendidikan iman bagi anak-anak.
                </p>
                <p>
                  Perjalanan hidupnya penuh ujian berat. Pada usia dewasa, ia mengalami penderitaan kelumpuhan fisik selama lebih dari dua dekade. Namun keterbatasan fisik tidak pernah memadamkan semangat pelayanannya: dari tempat tidurnya, ia terus membimbing, menguatkan, dan mengajar iman kepada sesama. Di masa Revolusi Prancis, dengan iman yang teguh dan keberanian luar biasa, ia melindungi para imam yang setia pada Gereja.
                </p>
                <p>
                  Pada tahun 1803, bersama Françoise Blin de Bourdon, ia mendirikan <em>Kongregasi Sisters of Notre Dame de Namur</em> untuk menghadirkan pendidikan bermutu bagi anak-anak miskin. Setahun kemudian (1804), Julia mengalami kesembuhan mukjizat yang semakin meneguhkan panggilannya hingga akhir hayatnya (8 April 1816).
                </p>
              </div>

              <!-- 3 Highlighted Key Pillars -->
              <div class="space-y-3 pt-2">
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-3.5">
                  <span class="w-8 h-8 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">1</span>
                  <div>
                    <div class="font-heading font-bold text-slate-900 text-sm">Pendidikan Memerdekakan Martabat Manusia</div>
                    <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed">
                      Pendidikan adalah jalan menghadirkan harapan dan memulihkan martabat manusia, terutama menjangkau yang miskin, lemah, dan kurang beruntung.
                    </p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-3.5">
                  <span class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">2</span>
                  <div>
                    <div class="font-heading font-bold text-slate-900 text-sm">Bukan Sekadar Transfer Pengetahuan</div>
                    <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed">
                      Pendidikan adalah karya kasih yang membantu setiap anak menemukan martabat, harapan, dan panggilan hidupnya karena setiap anak berharga dan dicintai Allah.
                    </p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-start gap-3.5">
                  <span class="w-8 h-8 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">3</span>
                  <div>
                    <div class="font-heading font-bold text-slate-900 text-sm">Warisan yang Dihidupi di Indonesia</div>
                    <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed">
                      Spiritualitas St. Julie diwariskan kepada para Suster SPM di Indonesia dan terus dihidupi oleh Perkumpulan Dharmaputri dalam membentuk generasi yang beriman, berkarakter, dan berbelarasa.
                    </p>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </section>

      <!-- ===================================================================
           2. PATER MATHIAS WOLFF, SJ (PDF 2)
      ==================================================================== -->
      <section id="pater-wolff" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-28">
        <div class="bg-white rounded-3xl p-8 sm:p-12 md:p-14 border border-slate-200/90 shadow-xl relative overflow-hidden">
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
            
            <!-- Right on desktop: Content -->
            <div class="lg:col-span-7 space-y-6 lg:order-1">
              <div>
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider mb-2">
                  <span>PENDIRI KONGREGASI SPM</span>
                </div>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-slate-900 tracking-tight">
                  Pater Mathias Wolff, SJ
                </h2>
                <p class="text-base sm:text-lg font-bold text-blue-700 mt-1">
                  Perintis Karya Pendidikan yang Melahirkan Kongregasi SPM
                </p>
              </div>

              <!-- Summary Narrative -->
              <div class="space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed text-justify">
                <p>
                  <strong>Pater Mathias Wolff, SJ (1779–1857)</strong> adalah seorang imam Serikat Yesus (Yesuit) asal Luxembourg yang mengabdikan hidupnya bagi pelayanan Gereja dan pendidikan Katolik di Belanda. Pada awal abad ke-19, kesempatan pendidikan bagi anak-anak keluarga sederhana di Belanda sangat terbatas dan jumlah tenaga pendidik Katolik sangat minim.
                </p>
                <p>
                  Melihat situasi tersebut, Pater Wolff meyakini bahwa pendidikan adalah sarana vital untuk membangun masa depan dan memperkuat kehidupan iman. Ia mulai merintis gerakan untuk mencerdaskan sekaligus membentuk karakter Kristiani generasi muda.
                </p>
                <p>
                  Ia menghimpun dan mendampingi sekelompok perempuan muda Katolik di Amersfoort. Dengan visi yang tajam, Pater Wolff mengirim para calon suster tersebut ke Namur (Belgia) untuk menjalani pembinaan rohani di bawah asuhan kongregasi yang didirikan oleh Santa Julie Billiart. Dari perpaduan inilah pada rentang tahun <strong>1822–1824</strong> resmi lahir <strong>Kongregasi Suster-suster Santa Perawan Maria (SPM)</strong> Amersfoort.
                </p>
              </div>

              <!-- Milestone Cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div class="p-4 rounded-2xl bg-blue-50/60 border border-blue-100">
                  <div class="text-xs font-bold text-blue-800 uppercase">Mewariskan Spiritualitas</div>
                  <div class="text-sm font-bold text-slate-900 mt-1">Jalinan Namur &amp; Amersfoort</div>
                  <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    Menghubungkan pembinaan suster dengan karisma St. Julie: pendidikan kasih, iman, dan penghormatan martabat pribadi manusia.
                  </p>
                </div>

                <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-100">
                  <div class="text-xs font-bold text-amber-800 uppercase">Menjangkau Indonesia</div>
                  <div class="text-sm font-bold text-slate-900 mt-1">Misi Abadi Sejak 1926</div>
                  <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                    Karya Pater Wolff berkembang melampaui benua hingga tiba di Indonesia pada tahun 1926 melalui pelayanan Perkumpulan Dharmaputri.
                  </p>
                </div>
              </div>

            </div>

            <!-- Left on desktop: Image -->
            <div class="lg:col-span-5 flex flex-col items-center text-center lg:order-2">
              <div class="relative w-full max-w-sm rounded-3xl overflow-hidden shadow-2xl border-4 border-white ring-1 ring-slate-200/80 bg-blue-50/50">
                <img
                  src="/images/heritage/pater-wolff.png"
                  alt="Lukisan Pater Mathias Wolff, SJ"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/80 via-slate-900/40 to-transparent p-4 text-white text-left">
                  <div class="font-heading font-black text-lg">Pater Mathias Wolff, SJ</div>
                  <div class="text-xs text-blue-300 font-semibold">1779 – 1857 • Luxembourg &amp; Belanda</div>
                </div>
              </div>

              <div class="mt-4 text-xs font-semibold text-slate-500">
                Imam Serikat Yesus (Yesuit) • Pendiri Kongregasi Suster SPM
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- ===================================================================
           3. SEJARAH KONGREGASI SPM DI INDONESIA & PERKUMPULAN DHARMAPUTRI (PDF 3)
      ==================================================================== -->
      <section id="sejarah-spm" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-28">
        <div class="bg-white rounded-3xl p-8 sm:p-12 md:p-14 border border-slate-200/90 shadow-xl space-y-12">
          
          <!-- Header Bagian Sejarah -->
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider mb-2">
              <span>SEJARAH &amp; PERJALANAN MISI</span>
            </div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-slate-900 tracking-tight">
              Sejarah Berdirinya Kongregasi SPM di Indonesia
            </h2>
            <p class="text-base sm:text-lg font-bold text-slate-600 mt-1">
              Dari Amersfoort Belanda Menuju Tanah Air: Menyemai Benih Pendidikan dan Pelayanan Kasih
            </p>
          </div>

          <!-- GAMBAR PEMBUKA (Sesuai Catatan PDF 3) -->
          <div class="rounded-3xl overflow-hidden shadow-xl border-4 border-white ring-1 ring-slate-200 bg-slate-100 max-w-3xl mx-auto">
            <img
              src="/images/heritage/spm-sejarah.png"
              alt="Enam Suster Perintis Pertama Kongregasi SPM di Indonesia"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <div class="p-3 bg-slate-900 text-white text-center text-xs font-semibold">
              Foto Bersejarah: Enam Suster Misionaris Perintis Kongregasi SPM Tiba di Indonesia (1926)
            </div>
          </div>

          <!-- Narasi Sejarah Bagian 1 (Perataan Justify sesuai Catatan PDF 3) -->
          <div class="space-y-6 text-slate-700 text-sm sm:text-base leading-relaxed text-justify max-w-4xl mx-auto">
            <p>
              Sejarah berdirinya Kongregasi Suster-suster Santa Perawan Maria (SPM) di Indonesia merupakan bagian dari gelombang karya misi Gereja Katolik pada awal abad ke-20. Dari Amersfoort, Belanda, karisma pendidikan yang berakar pada St. Julia Billiart dan dipelopori oleh Pater Mathias Wolff, SJ ini akhirnya bersemi di tanah Indonesia.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
              <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200/90 space-y-2">
                <div class="text-xs font-extrabold text-blue-700 uppercase tracking-wider">A. Panggilan Misi (1926)</div>
                <h3 class="text-base font-heading font-black text-slate-900">Kebutuhan Tenaga Religius Wanita</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed text-justify font-normal">
                  Pada dekade 1920-an, Vikariat Apostolik di Hindia Belanda (khususnya wilayah Jawa Timur) membutuhkan tenaga religius wanita untuk menangani karya sosial dan pendidikan Katolik bagi masyarakat lokal, keturunan Tionghoa, dan Eropa. Atas undangan pimpinan Gereja setempat, pimpinan Kongregasi SPM di Amersfoort mengutus rombongan perintis pertama ke Indonesia.
                </p>
              </div>

              <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200/90 space-y-2">
                <div class="text-xs font-extrabold text-amber-700 uppercase tracking-wider">B. Pendaratan Perintis</div>
                <h3 class="text-base font-heading font-black text-slate-900">Probolinggo, 11 Oktober 1926</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed text-justify font-normal">
                  Pada 11 Oktober 1926, enam orang suster misionaris pertama tiba dan mendarat di Probolinggo, Jawa Timur, dipimpin oleh Bunda Stanislas, SPM. Kota Probolinggo dipilih sebagai pos misi pertama dan menjadi cikal bakal (rumah induk/provinsialat) perkembangan Kongregasi SPM di tanah air.
                </p>
              </div>
            </div>

            <!-- 3 Bidang Pelayanan Awal -->
            <div class="p-6 rounded-3xl bg-blue-50/50 border border-blue-100 space-y-3">
              <div class="font-heading font-black text-slate-900 text-sm sm:text-base">
                C. Perkembangan Karya Awal di Indonesia:
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                <div class="bg-white p-4 rounded-2xl border border-blue-100 shadow-xs">
                  <div class="font-bold text-sm text-blue-800 mb-1">1. Pendidikan</div>
                  <p class="text-xs text-slate-600 leading-relaxed font-normal">
