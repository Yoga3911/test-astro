---
/**
 * heritage.astro — Kongregasi, Identitas Spiritual & Sejarah Yayasan
 *
 * Sesuai Sitemap PDF:
 * - Maria Fatima
 * - SPM
 * - St. Julie Billiart
 * - Pater Matthias Wolff
 * - SIKARU
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { HERITAGE_DATA, SITE_CONFIG, VISI_MISI_DATA } from '@/utils/config';

const CORE_VALUE_ICONS: Record<string, { icon: string; color: string; bg: string }> = {
  Spiritualitas: { icon: '⛪', color: 'text-purple-700', bg: 'bg-purple-50 group-hover:bg-purple-100' },
  Integritas: { icon: '🛡️', color: 'text-blue-700', bg: 'bg-blue-50 group-hover:bg-blue-100' },
  Kasih: { icon: '❤️', color: 'text-rose-700', bg: 'bg-rose-50 group-hover:bg-rose-100' },
  Adil: { icon: '⚖️', color: 'text-emerald-700', bg: 'bg-emerald-50 group-hover:bg-emerald-100' },
  Respek: { icon: '🤝', color: 'text-amber-700', bg: 'bg-amber-50 group-hover:bg-amber-100' },
  Unggul: { icon: '🏆', color: 'text-indigo-700', bg: 'bg-indigo-50 group-hover:bg-indigo-100' },
};
---

<BaseLayout
  title="Heritage & Spiritualitas SPM"
  description="Warisan rohani, sejarah Kongregasi Suster SPM, Santa Maria Fatima, St. Julie Billiart, Pater Matthias Wolff, dan nilai SIKARU."
>
  <Header />

  <main id="main-content">
    
    <!-- Hero Header -->
    <section class="bg-gradient-to-b from-blue-50/80 via-white to-slate-50 border-b border-slate-200/80 py-16 sm:py-20 relative overflow-hidden">
      <!-- Decorative ambient glows -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-blue-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-amber-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider border border-blue-200 shadow-xs">
          <span>WARISAN SPIRITUAL &amp; IDENTITAS</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight text-slate-900">
          Heritage &amp; Spiritualitas
        </h1>
        <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto font-normal leading-relaxed">
          Mengenal akar iman, teladan para tokoh pendiri, dan nilai-nilai keutamaan yang menjiwai seluruh karya pendidikan di SDK Maria Fatima Jember.
        </p>
      </div>
    </section>

    <!-- Heritage Items List -->
    <section class="py-16 sm:py-24 bg-slate-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        
        {HERITAGE_DATA.map((item, index) => {
          const isEven = index % 2 === 0;

          return (
            <div
              id={item.id}
              class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/90 shadow-sm hover:shadow-lg transition-all duration-300 scroll-mt-28"
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                
                <!-- Left Details -->
                <div class={`lg:col-span-7 space-y-5 ${!isEven ? 'lg:order-2' : ''}`}>
                  <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider">
                    <span>{item.icon}</span>
                    <span>WARISAN #{index + 1}</span>
                  </div>

                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-slate-900 tracking-tight">
                    {item.title}
                  </h2>
                  <p class="text-sm sm:text-base font-bold text-amber-600">
                    {item.subtitle}
                  </p>

                  <p class="text-base text-slate-700 font-medium leading-relaxed bg-blue-50/60 p-4 rounded-2xl border border-blue-100">
                    {item.summary}
                  </p>

                  <div class="space-y-3 text-slate-600 text-sm sm:text-base leading-relaxed">
                    {item.content.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>

                  {item.values && item.values.length > 0 && (
                    <div class="pt-2">
                      <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Nilai Keutamaan:</div>
                      <div class="flex flex-wrap gap-2">
                        {item.values.map((v) => (
                          <span class="px-3 py-1 rounded-xl bg-slate-100 text-slate-800 text-xs font-bold">
                            ✦ {v}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                <!-- Right Visual -->
                <div class={`lg:col-span-5 ${!isEven ? 'lg:order-1' : ''}`}>
                  <div class="rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-slate-100 ring-1 ring-slate-200">
                    <img
                      src={`/images/heritage/${item.id === 'st-julie-billiart' ? 'st-julie' : item.id === 'pater-matthias-wolff' ? 'pater-wolff' : item.id}.svg`}
                      alt={item.title}
                      class="w-full h-auto object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>

              </div>

              {/* 6 Pilar SIKARU Cards Grid */}
              {item.id === 'sikaru' && (
                <div class="mt-10 pt-8 border-t border-slate-100">
                  <div class="text-center max-w-2xl mx-auto mb-8">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-widest mb-2 border border-blue-200">
                      <span>OUR CORE VALUES</span>
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-heading font-black text-slate-900">
                      6 Nilai Utama: SIKARU
                    </h3>
                    <p class="text-slate-600 text-sm sm:text-base mt-2">
                      Fondasi karakter luhur yang ditanamkan secara konsisten dalam setiap aspek pembelajaran dan kehidupan berkomunitas.
                    </p>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                    {VISI_MISI_DATA.coreValues.map((val) => {
                      const key = val.title.split(' ')[0];
                      const meta = CORE_VALUE_ICONS[key] || { icon: '💎', color: 'text-blue-700', bg: 'bg-blue-50' };

                      return (
                        <div class="bg-slate-50/90 rounded-3xl p-6 border border-slate-200 shadow-xs hover:shadow-lg hover:bg-white hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
                          <div>
                            <div class={`w-12 h-12 rounded-2xl ${meta.bg} flex items-center justify-center text-2xl mb-4 transition-colors`}>
                              {meta.icon}
                            </div>
                            <h4 class="font-heading font-black text-base text-slate-900 mb-2 group-hover:text-blue-700 transition-colors">
                              {val.title}
                            </h4>
                            <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
                              {val.desc}
                            </p>
                          </div>
                          <div class="pt-4 mt-4 border-t border-slate-200/60 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                            NILAI SIKARU
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          );
        })}

      </div>
    </section>

    <!-- Banner Call to Action (Bright Theme) -->
    <section class="py-16 bg-slate-50 border-t border-slate-200/80">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <div class="bg-gradient-to-br from-white via-blue-50/50 to-white rounded-3xl p-8 sm:p-12 border-2 border-blue-200/80 shadow-xl space-y-4 relative overflow-hidden">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold uppercase tracking-wider border border-amber-200 shadow-xs">
            <span>SPIRITUALITAS SPM</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-heading font-black text-slate-900">
            "Ah! Betapa Baiknya Allah yang Mahabaik!"
          </h3>
          <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
            Mari wujudkan semangat kasih dan keteladanan Bunda Maria dalam mendidik putra-putri tercinta di SDK Maria Fatima Jember.
          </p>
          <div class="pt-4">
            <a
              href="/admission"
              class="inline-flex items-center gap-2 px-8 py-3.5 rounded-2xl bg-blue-700 hover:bg-blue-800 text-white font-heading font-bold text-sm shadow-lg shadow-blue-700/25 hover:scale-105 active:scale-95 transition-all"
            >
              <span>Daftar SPMB Online</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
