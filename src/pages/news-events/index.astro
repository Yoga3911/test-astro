---
/**
 * news-events/index.astro — Warta & Kegiatan Sekolah
 *
 * Sesuai Sitemap PDF:
 * - Artikel
 * - Berita
 * - Galeri Kegiatan
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BeritaCard from '@/components/BeritaCard.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '@/utils/config';

const allBerita = await getCollection('berita');

// Sort by date desc, filter drafts
const sortedBerita = allBerita
  .filter((b) => !b.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Gallery items
const GALERI_KEGIATAN = [
  {
    title: 'Misa Kudus & Peringatan Santa Pelindung Maria Fatima',
    date: '13 Mei 2026',
    category: 'Spiritualitas',
    image: '/images/instagram/ig-1.svg',
    caption: 'Perayaan Ekaristi syukur bersama Suster SPM, dewan guru, dan seluruh peserta didik.',
  },
  {
    title: 'Juara 1 Olimpiade Sains & Matematika Tingkat Kabupaten',
    date: '20 April 2026',
    category: 'Prestasi',
    image: '/images/instagram/ig-2.svg',
    caption: 'Prestasi gemilang kontingen SDK Maria Fatima dalam ajang kompetisi sains bergengsi.',
  },
  {
    title: 'Gelar Karya Proyek P5: Gaya Hidup Berkelanjutan',
    date: '15 Maret 2026',
    category: 'Kegiatan Belajar',
    image: '/images/instagram/ig-3.svg',
    caption: 'Anak-anak kelas 1-6 memamerkan hasil pengolahan kompos dan kreasi daur ulang bahan organik.',
  },
  {
    title: 'Festival Musik & Paduan Suara Anak Nusantara',
    date: '28 Februari 2026',
    category: 'Seni & Budaya',
    image: '/images/instagram/ig-4.svg',
    caption: 'Penampilan memukau tim paduan suara membawakan lagu rohani dan lagu daerah nusantara.',
  },
];
---

<BaseLayout
  title="News & Events — Berita, Artikel & Galeri"
  description="Kabar terbaru, artikel edukatif, dokumentasi kegiatan, dan prestasi siswa SDK Maria Fatima Jember."
>
  <Header />

  <main id="main-content">
    
    <!-- Hero Header -->
    <section class="bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 text-white py-20 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-amber-300 text-xs font-bold uppercase tracking-wider">
          <span>WARTA &amp; AKTIVITAS SEKOLAH</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-black tracking-tight">
          News &amp; Events
        </h1>
        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-normal">
          Ikuti perkembangan prestasi, artikel inspiratif dewan guru, serta dokumentasi galeri momen berharga keluarga besar SDK Maria Fatima.
        </p>
      </div>
    </section>

    <!-- Articles & News List -->
    <section class="py-16 sm:py-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12">
          <div>
            <span class="text-xs font-bold text-blue-700 uppercase tracking-widest">INFORMASI TERKINI</span>
            <h2 class="text-3xl font-heading font-black text-slate-900 mt-1">
              Berita &amp; Artikel Edukatif
            </h2>
          </div>

          <div class="flex items-center gap-2 flex-wrap text-xs font-bold">
            <span class="px-4 py-2 rounded-xl bg-blue-700 text-white shadow-xs">Semua Warta</span>
            <span class="px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200">Prestasi</span>
            <span class="px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200">Kegiatan</span>
            <span class="px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200">PPDB</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedBerita.map((item, index) => (
            <BeritaCard berita={item} featured={index === 0} />
          ))}
        </div>

      </div>
    </section>

    <!-- 3. GALERI KEGIATAN -->
    <section id="galeri" class="py-16 sm:py-24 bg-white scroll-mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold uppercase mb-3">
            <span>DOKUMENTASI FOTO</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
            Galeri Kegiatan Sekolah
          </h2>
          <p class="text-slate-600 mt-2 text-base">
            Momen kebersamaan, perayaan sukacita, dan dinamika pembelajaran para peserta didik di SDK Maria Fatima Jember.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {GALERI_KEGIATAN.map((galeri) => (
            <div class="bg-slate-50 rounded-3xl overflow-hidden border border-slate-200 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="aspect-4/3 overflow-hidden bg-slate-200 relative">
                  <img
                    src={galeri.image}
                    alt={galeri.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-slate-950/70 backdrop-blur-md text-white text-[10px] font-bold uppercase">
                    {galeri.category}
                  </span>
                </div>

                <div class="p-5 space-y-2">
                  <span class="text-xs text-amber-600 font-semibold">{galeri.date}</span>
                  <h3 class="font-heading font-bold text-base text-slate-900 leading-snug group-hover:text-blue-700 transition-colors">
                    {galeri.title}
                  </h3>
                  <p class="text-xs text-slate-600 leading-relaxed font-normal">
                    {galeri.caption}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
