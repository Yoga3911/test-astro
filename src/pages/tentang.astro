---
/**
 * tentang.astro — Halaman Tentang / Profil Sekolah
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_CONFIG } from '@/utils/config';

const strukturOrganisasi = [
  { name: 'Drs. H. Wahyu Santoso, M.Pd.', role: 'Kepala Sekolah', nip: '197001011995041001' },
  { name: 'Hj. Sri Wahyuni, S.Pd., M.Si.', role: 'Wakasek Kurikulum', nip: '197205151997032002' },
  { name: 'Budi Setiawan, S.Pd.', role: 'Wakasek Kesiswaan', nip: '197408221998031003' },
  { name: 'Dra. Nurhayati, M.Pd.', role: 'Wakasek Sarana & Prasarana', nip: '196809101994012004' },
  { name: 'Ahmad Fauzi, S.Pd.', role: 'Wakasek Humas', nip: '197612012001121005' },
  { name: 'Rini Puspitasari, S.Pd.', role: 'Kepala Perpustakaan', nip: '198003202005022006' },
];

const nilaiSekolah = [
  { icon: '🎯', title: 'Integritas',     desc: 'Kejujuran dan konsistensi dalam setiap tindakan' },
  { icon: '🌟', title: 'Keunggulan',     desc: 'Selalu berupaya memberikan yang terbaik' },
  { icon: '🤝', title: 'Kolaborasi',     desc: 'Bekerja sama untuk mencapai tujuan bersama' },
  { icon: '💡', title: 'Inovasi',        desc: 'Berani berkreasi dan beradaptasi dengan perubahan' },
  { icon: '🌿', title: 'Keberlanjutan', desc: 'Menjaga lingkungan dan warisan untuk generasi berikutnya' },
];

const sejarahTimeline = [
  { tahun: '1975', peristiwa: 'Sekolah didirikan dengan nama SPG Negeri Nusantara' },
  { tahun: '1985', peristiwa: 'Berganti nama menjadi SMA Negeri 1 Nusantara' },
  { tahun: '1997', peristiwa: 'Pertama kali meraih Akreditasi A dari Depdikbud' },
  { tahun: '2010', peristiwa: 'Pembangunan gedung baru 4 lantai & laboratorium modern' },
  { tahun: '2018', peristiwa: 'Meraih penghargaan Sekolah Adiwiyata Nasional' },
  { tahun: '2024', peristiwa: 'Peluncuran program Digital & AI Literacy pertama di kota' },
  { tahun: '2026', peristiwa: 'Meraih medali emas OSN Fisika tingkat Nasional' },
];

const tentangSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `Tentang ${SITE_CONFIG.name}`,
  description: 'Profil lengkap, visi, misi, nilai utama, linimasa sejarah, struktur pimpinan dan organisasi SMAN 1 Nusantara.',
  url: `${SITE_CONFIG.url}/tentang`,
  mainEntity: {
    '@type': 'HighSchool',
    name: SITE_CONFIG.name,
    foundingDate: '1975',
    description: SITE_CONFIG.description,
  },
};
---

<BaseLayout
  title="Tentang Sekolah"
  description="Profil lengkap SMAN 1 Nusantara — sejarah sejak 1975, visi misi, 5 nilai utama, struktur organisasi, dan profil pimpinan sekolah."
  keywords={`Profil ${SITE_CONFIG.name}, Sejarah SMAN 1 Nusantara, Visi Misi SMAN 1 Nusantara, Struktur Organisasi Sekolah, Kepala Sekolah SMAN 1 Nusantara`}
  structuredData={tentangSchema}
>

  <Header />
  <main id="main-content" style="padding-top: 4.5rem; background: #ffffff;">

    <!-- Page Hero -->
    <div style="
      padding: 4.5rem 0;
      background: linear-gradient(135deg, #eff6ff 0%, #ffffff 50%, #fffbeb 100%);
      border-bottom: 1px solid #e2e8f0;
      position: relative; overflow: hidden;
    ">
      <div aria-hidden="true" style="position:absolute;inset:0;" class="bg-grid"></div>
      <div class="container" style="position: relative; text-align: center;">
        <div class="section-tag" style="display: inline-flex;">🏫 Profil Sekolah</div>
        <h1 style="margin: 0.75rem 0 1rem; font-size: clamp(2rem, 4vw, 3rem); color: #0f172a;">
          Tentang <span class="accent">SMAN 1 Nusantara</span>
        </h1>
        <p style="color: #475569; font-size: 1.1rem; max-width: 560px; margin: 0 auto; line-height: 1.75;">
          Lebih dari setengah abad mencetak generasi bangsa yang unggul, berkarakter, dan berdaya saing global.
        </p>
      </div>
    </div>

    <!-- ── Visi & Misi ──────────────────────────────────────────────────── -->
    <section id="visi-misi" class="section" aria-labelledby="visi-heading">
      <div class="container">
        <div style="
          display: grid;
          grid-template-columns: 1fr;
          gap: 2rem;
          max-width: 960px;
          margin: 0 auto;
        " class="visi-misi-grid">
          <!-- Visi -->
          <div class="gradient-border reveal">
            <div style="
              padding: 2.5rem;
              background: #ffffff;
              border-radius: var(--radius-card);
              height: 100%;
              border: 1px solid #e2e8f0;
            ">
              <div style="
                display: inline-flex; align-items: center; gap: 0.5rem;
                color: #1d4ed8;
                font-family: var(--font-heading);
                font-weight: 700; font-size: 0.8rem;
                letter-spacing: 0.1em; text-transform: uppercase;
                margin-bottom: 1rem;
              ">
                <span>👁️</span> VISI
              </div>
              <h2 id="visi-heading" style="font-size: 1.35rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem; line-height: 1.4;">
                Menjadi sekolah unggulan yang menghasilkan generasi beriman, berilmu, berkarakter, dan berdaya saing global.
              </h2>
            </div>
          </div>

          <!-- Misi -->
          <div class="card reveal delay-200" style="padding: 2.5rem; background: #ffffff; border: 1px solid #e2e8f0;">
            <div style="
              display: inline-flex; align-items: center; gap: 0.5rem;
              color: #b45309;
              font-family: var(--font-heading);
              font-weight: 700; font-size: 0.8rem;
              letter-spacing: 0.1em; text-transform: uppercase;
              margin-bottom: 1rem;
            ">
              <span>🎯</span> MISI
            </div>
            <h2 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1.25rem;">Langkah kami mewujudkan visi:</h2>
            <ol style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.875rem;">
              {[
                'Menyelenggarakan pembelajaran berkualitas berbasis inovasi dan teknologi',
                'Mengembangkan karakter siswa melalui kegiatan akademik dan non-akademik',
                'Membangun lingkungan belajar yang inklusif, aman, dan menyenangkan',
                'Menjalin kemitraan strategis dengan dunia industri, perguruan tinggi, dan komunitas',
                'Melestarikan nilai budaya lokal seiring adaptasi terhadap perkembangan global',
              ].map((misi, i) => (
                <li style="display: flex; gap: 0.75rem; align-items: flex-start; font-size: 0.9rem; color: #334155;">
                  <div style="
                    width: 24px; height: 24px;
                    background: #eff6ff;
                    border: 1px solid #bfdbfe;
                    border-radius: 50%;
                    display: flex; align-items: center; justify-content: center;
                    font-size: 0.7rem; font-weight: 700; color: #1d4ed8;
                    flex-shrink: 0; margin-top: 0.1rem;
                  ">{i + 1}</div>
                  <span style="line-height: 1.65;">{misi}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ── Nilai Sekolah ─────────────────────────────────────────────────── -->
    <section class="section" style="background: #f8fafc;" aria-labelledby="nilai-heading">
      <div class="container">
        <div style="text-align: center; margin-bottom: 3rem;" class="reveal">
          <div class="section-tag" style="display: inline-flex;">✨ Nilai Kami</div>
          <h2 id="nilai-heading" class="section-title">
            Lima Nilai <span class="accent-gold">Utama</span>
          </h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.25rem; max-width: 900px; margin: 0 auto;">
          {nilaiSekolah.map((nilai, i) => (
            <div class={`card reveal-scale delay-${(i + 1) * 100}`} style="padding: 1.75rem; text-align: center; background: #ffffff; border: 1px solid #e2e8f0;">
              <div style="font-size: 2.5rem; margin-bottom: 0.875rem;">{nilai.icon}</div>
              <h3 style="font-size: 1.05rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">{nilai.title}</h3>
              <p style="font-size: 0.82rem; color: #64748b; line-height: 1.6; margin: 0;">{nilai.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ── Sejarah Singkat ───────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sejarah-heading" style="background: #ffffff;">
      <div class="container">
        <div style="text-align: center; margin-bottom: 3rem;" class="reveal">
          <div class="section-tag" style="display: inline-flex;">📜 Sejarah</div>
          <h2 id="sejarah-heading" class="section-title">
            Perjalanan <span class="accent">51 Tahun</span>
          </h2>
        </div>

        <div style="max-width: 700px; margin: 0 auto; position: relative;">
          <!-- Timeline line -->
          <div aria-hidden="true" style="
            position: absolute; left: 72px; top: 0; bottom: 0;
            width: 2px;
            background: #e2e8f0;
          "></div>

          <div style="display: flex; flex-direction: column; gap: 1.75rem;">
            {sejarahTimeline.map((item, i) => (
              <div class={`reveal delay-${(i % 4 + 1) * 100}`} style="display: flex; gap: 1.5rem; align-items: flex-start;">
                <!-- Year badge -->
                <div style="
                  width: 72px;
                  flex-shrink: 0;
                  text-align: right;
                  padding-right: 1.25rem;
                  position: relative;
                ">
                  <span style="
                    font-family: var(--font-heading);
                    font-weight: 800; font-size: 0.85rem;
                    color: #1d4ed8;
                  ">{item.tahun}</span>
                  <!-- Dot -->
                  <div style="
                    position: absolute;
                    right: -7px; top: 50%; transform: translateY(-50%);
                    width: 12px; height: 12px;
                    background: #2563eb;
                    border: 2px solid #ffffff;
                    border-radius: 50%;
                    box-shadow: 0 0 0 2px #bfdbfe;
                  "></div>
                </div>
                <!-- Event -->
                <div class="card" style="padding: 1rem 1.25rem; flex: 1; background: #ffffff; border: 1px solid #e2e8f0;">
                  <p style="font-size: 0.9rem; color: #334155; margin: 0; line-height: 1.6;">{item.peristiwa}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="divider" />

    <!-- ── Struktur Organisasi ───────────────────────────────────────────── -->
    <section id="struktur" class="section" style="background: #f8fafc;" aria-labelledby="struktur-heading">
      <div class="container">
        <div style="text-align: center; margin-bottom: 3rem;" class="reveal">
          <div class="section-tag" style="display: inline-flex;">👥 Struktur</div>
          <h2 id="struktur-heading" class="section-title">
            Struktur <span class="accent">Organisasi</span>
          </h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem;">
          {strukturOrganisasi.map((person, i) => (
            <div class={`card reveal delay-${(i % 3 + 1) * 100}`} style="padding: 1.5rem; text-align: center; background: #ffffff; border: 1px solid #e2e8f0;">
              <!-- Avatar placeholder -->
              <div style="
                width: 60px; height: 60px;
                background: linear-gradient(135deg, #1d4ed8, #2563eb);
                border-radius: 50%;
                display: flex; align-items: center; justify-content: center;
                font-family: var(--font-heading);
                font-weight: 800; font-size: 1.4rem; color: #fff;
                margin: 0 auto 1rem;
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
              ">
                {person.name.charAt(0)}
              </div>
              <h3 style="font-size: 0.95rem; font-weight: 700; color: #0f172a; margin-bottom: 0.35rem; line-height: 1.35;">{person.name}</h3>
              <p style="font-size: 0.8rem; color: #2563eb; font-weight: 600; margin-bottom: 0.25rem;">{person.role}</p>
              <p style="font-size: 0.72rem; color: #64748b; font-family: monospace;">NIP: {person.nip}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  @media (min-width: 768px) {
    .visi-misi-grid {
      grid-template-columns: 1fr 1.3fr !important;
    }
  }
</style>

