---
/**
 * index.astro — Landing Page SDK Maria Fatima Jember
 *
 * Strictly follows the PDF Landing Page Structure (Page 2) inspired by sdh.sch.id:
 * 1. Hero Banner (Video Profil)
 * 2. Carousel VisMis (Visi, Misi, Core Value, Tagline)
 * 3. Tentang SDK (Singkat)
 * 4. Keunggulan Sekolah (Akreditasi, Prestasi/Juara, Karakter, Fasilitas)
 * 5. Carousel Testimoni Alumni (5 Alumni, @2 Paragraf)
 * 6. Cards Instagram Feed (Feeds, Reels @sdkmartimjember)
 * 7. Registrasi (Call to Action - CTA)
 * 8. Lokasi + Maps (Google Maps SDK Maria Fatima Jember)
 * 9. Footer
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HeroVideo from '@/components/HeroVideo.astro';
import CarouselVisMis from '@/components/CarouselVisMis.svelte';
import CarouselTestimoni from '@/components/CarouselTestimoni.svelte';
import InstagramFeed from '@/components/InstagramFeed.astro';
import { SITE_CONFIG } from '@/utils/config';

// ─── Data Keunggulan Sekolah ───────────────────────────────────────────────
const KEUNGGULAN_LIST = [
  {
    title: 'Akreditasi A (Unggul)',
    category: 'STANDAR NASIONAL',
    icon: '🏆',
    color: 'from-amber-500 to-yellow-600',
    desc: 'Pengakuan resmi mutu pendidikan terbaik dari BAN-S/M dengan capaian nilai tertinggi di Kabupaten Jember.',
    detail: 'Kurikulum Merdeka terintegrasi, manajemen teruji, dan fasilitas pembelajaran berstandar nasional.',
  },
  {
    title: 'Prestasi & Juara Bergengsi',
    category: 'AKADEMIK & BAKAT',
    icon: '🥇',
    color: 'from-blue-600 to-indigo-700',
    desc: 'Rutin meraih juara olimpiade sains, matematika, paduan suara anak, pramuka, seni tari, hingga olahraga.',
    detail: 'Bimbingan intensif klub bakat dan pembina kompeten yang mendampingi siswa hingga level provinsi & nasional.',
  },
  {
    title: 'Pembinaan Karakter SIKARU',
    category: 'SPIRITUALITAS SPM',
    icon: '💎',
    color: 'from-emerald-600 to-teal-700',
    desc: 'Internalisasi nilai Spiritualitas, Integritas, Kasih, Adil, Respek, dan Unggul dalam setiap dinamika sekolah.',
    detail: 'Pendidikan budi pekerti yang menyentuh hati (Educating Heart & Mind) berlandaskan kasih Santa Bunda Maria.',
  },
  {
    title: 'Fasilitas Modern & Ramah Anak',
    category: 'LINGKUNGAN BELAJAR',
    icon: '🏫',
    color: 'from-purple-600 to-violet-700',
    desc: 'Kampus asri dan aman dilengkapi Lab Komputer Multimedia, Perpustakaan Lengkap, Lapangan Olahraga, & Ruang Musik.',
    detail: 'Lingkungan hijau bebas perundungan (anti-bullying) yang nyaman dan mendukung tumbuh kembang optimal.',
  },
];
---

<BaseLayout
  title="Beranda"
  description="Website Resmi SDK Maria Fatima Jember — Sekolah Dasar Katolik unggulan di bawah naungan Yayasan Suster SPM Probolinggo. Membina tunas muda yang cerdas, berkarakter luhur, dan berakar kasih."
>
  <Header />

  <main id="main-content" class="min-h-screen">

    <!-- 1. HERO BANNER (VIDEO PROFIL ALA SDH) -->
    <HeroVideo />

    <!-- 2. CAROUSEL VISMIS (VISI, MISI, CORE VALUE SIKARU, TAGLINE) -->
    <CarouselVisMis client:visible />

    <!-- 3. TENTANG SDK (SINGKAT ALA SDH: ABOUT SDK MARIA FATIMA) -->
    <section id="tentang-singkat" class="py-16 sm:py-24 bg-white relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Image / Visual Composition (Left) -->
          <div class="lg:col-span-5 relative">
            <div class="relative mx-auto max-w-md lg:max-w-none">
              <!-- Decorative backing card -->
              <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-blue-600 to-amber-400 opacity-20 blur-xl"></div>
              
              <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-900">
                <img
                  src="/images/heritage/spm.svg"
                  alt="Sejarah Singkat SDK Maria Fatima Jember"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>

              <!-- Floating Experience Badge -->
              <div class="absolute -bottom-6 -right-4 sm:right-6 bg-white rounded-2xl p-4 shadow-xl border border-slate-100 flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-blue-700 text-white font-heading font-black text-xl flex items-center justify-center shadow-md">
                  65+
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">Dedikasi</div>
                  <div class="text-sm font-heading font-extrabold text-slate-900">Tahun Melayani di Jember</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Content Details (Right) -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider">
              <span>ABOUT SDK MARIA FATIMA</span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight leading-tight">
              Mendidik dengan Hati, <br class="hidden sm:inline" />
              <span class="text-blue-700">Membentuk Karakter Pemimpin</span>
            </h2>

            <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-normal">
              Didirikan di bawah naungan <strong>Perkumpulan Santa Perawan Maria (SPM) Probolinggo</strong>, SDK Maria Fatima Jember telah menjadi mercusuar pendidikan dasar Katolik di Kabupaten Jember selama lebih dari enam dekade.
            </p>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
              Terinspirasi oleh semangat <strong>Santa Julie Billiart</strong> dan teladan kasih <strong>Bunda Maria Fatima</strong>, kami tidak hanya menekankan keunggulan akademik dan kecakapan digital abad 21, tetapi juga merawat hati setiap anak agar berakar kuat pada nilai-nilai <em>SIKARU (Spiritualitas, Integritas, Kasih, Adil, Respek, Unggul)</em>.
            </p>

            <!-- Key Points -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                <span class="text-emerald-600 font-bold text-lg">✓</span>
                <span class="text-sm font-semibold text-slate-800">Kurikulum Merdeka Interaktif</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                <span class="text-emerald-600 font-bold text-lg">✓</span>
                <span class="text-sm font-semibold text-slate-800">Bilingual &amp; Digital Learning</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                <span class="text-emerald-600 font-bold text-lg">✓</span>
                <span class="text-sm font-semibold text-slate-800">Pendidikan Karakter Kristiani</span>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                <span class="text-emerald-600 font-bold text-lg">✓</span>
                <span class="text-sm font-semibold text-slate-800">Ekstrakurikuler Berprestasi</span>
              </div>
            </div>

            <!-- Action Button -->
            <div class="pt-4 flex flex-wrap items-center gap-4">
              <a
                href="/about-us"
                class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-blue-700 hover:bg-blue-800 text-white font-bold text-sm shadow-md shadow-blue-700/20 hover:scale-105 active:scale-95 transition-all duration-200"
              >
                <span>Pelajari Sejarah &amp; Profil Lengkap</span>
                <span>→</span>
              </a>
              <a
                href="/heritage"
                class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-sm transition-colors"
              >
                <span>Spiritualitas SPM &amp; Heritage</span>
              </a>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- 4. KEUNGGULAN SEKOLAH (AKREDITASI, PRESTASI, KARAKTER, FASILITAS) -->
    <section id="keunggulan-sekolah" class="py-16 sm:py-24 bg-slate-50 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold uppercase tracking-wider mb-3">
            <span>PILAR KEUNGGULAN</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight">
            Mengapa Memilih SDK Maria Fatima?
          </h2>
          <p class="text-slate-600 mt-3 text-base sm:text-lg">
            Empat pilar utama yang menjadikan SDK Maria Fatima pilihan terdepan orang tua dalam mempercayakan pendidikan putra-putrinya.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {KEUNGGULAN_LIST.map((item) => (
            <div class="bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${item.color} text-white flex items-center justify-center text-2xl shadow-lg mb-6 group-hover:scale-110 transition-transform duration-300`}>
                  {item.icon}
                </div>
                <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 mb-1">
                  {item.category}
                </div>
                <h3 class="text-xl font-heading font-black text-slate-900 mb-3 group-hover:text-blue-700 transition-colors">
                  {item.title}
                </h3>
                <p class="text-sm text-slate-700 font-medium leading-relaxed mb-4">
                  {item.desc}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 text-xs text-slate-500 font-normal leading-relaxed">
                {item.detail}
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 5. CAROUSEL TESTIMONI ALUMNI (5 ALUMNI, @2 PARAGRAF) -->
    <CarouselTestimoni client:visible />

    <!-- 6. CARDS INSTAGRAM FEED (FEEDS & REELS @SDKMARTIMJEMBER) -->
    <InstagramFeed />

    <!-- 7. REGISTRASI / CALL TO ACTION (ALA SDH: BE A PART OF OUR COMMUNITY) -->
    <section id="registrasi-cta" class="py-16 sm:py-24 bg-white relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-br from-blue-700 via-blue-800 to-indigo-900 text-white rounded-3xl p-8 sm:p-14 md:p-16 text-center shadow-2xl relative overflow-hidden">
          
          <!-- Ambient lighting effects -->
          <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-400/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-sky-400/25 rounded-full blur-3xl pointer-events-none"></div>

          <div class="relative z-10 space-y-6 max-w-3xl mx-auto">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/20 text-amber-300 text-xs font-bold uppercase tracking-widest">
              <span>PPDB TAHUN AJARAN 2026/2027</span>
            </div>

            <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black tracking-tight leading-tight text-white">
              Be a Part of Our Lifelong <br class="hidden sm:inline" />
              <span class="text-amber-300">
                Transformative Learning Community
              </span>
            </h2>

            <p class="text-blue-100 text-base sm:text-lg font-normal leading-relaxed">
              Pintu pendaftaran peserta didik baru (PPDB) telah dibuka. Berikan fondasi terbaik bagi masa depan, karakter, dan iman ananda tercinta bersama SDK Maria Fatima Jember.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
              <a
                href="/admission"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-heading font-black text-base text-slate-950 bg-amber-400 hover:bg-amber-300 shadow-xl shadow-amber-500/25 hover:scale-105 active:scale-95 transition-all duration-200"
              >
                <span>Daftar Sekarang Secara Online</span>
                <span>→</span>
              </a>

              <a
                href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=Halo%20Admin%20SDK%20Maria%20Fatima,%20saya%20ingin%20konsultasi%20pendaftaran%20PPDB%202026/2027`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl font-bold text-base text-white bg-white/15 hover:bg-white/25 border border-white/25 backdrop-blur-md transition-all"
              >
                <span>💬 Konsultasi PPDB via WA</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 8. LOKASI + GOOGLE MAPS -->
    <section id="lokasi-maps" class="py-16 sm:py-24 bg-white relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Location Info Box (Left) -->
          <div class="lg:col-span-5 space-y-6">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider">
              <span>LOKASI &amp; LAYANAN</span>
            </div>

            <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
              Kunjungi Kampus Kami di Jember
            </h2>

            <p class="text-slate-600 text-base leading-relaxed">
              Terletak strategis di pusat kota Jember, kampus SDK Maria Fatima menyediakan lingkungan yang aman, nyaman, dan mudah diakses oleh para orang tua dan penjemput.
            </p>

            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <span class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-xl shrink-0">📍</span>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">Alamat Sekolah</div>
                  <div class="text-sm font-semibold text-slate-800 mt-0.5">{SITE_CONFIG.address}</div>
                </div>
              </div>

              <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <span class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl shrink-0">⏰</span>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">Jam Pelayanan Kantor</div>
                  <div class="text-sm font-semibold text-slate-800 mt-0.5">Senin – Jumat: 07.00 – 14.30 WIB</div>
                  <div class="text-xs text-slate-500 mt-0.5">Sabtu: 07.30 – 12.00 WIB (Khusus Informasi PPDB)</div>
                </div>
              </div>

              <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <span class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-xl shrink-0">📞</span>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">Telepon &amp; WhatsApp</div>
                  <div class="text-sm font-semibold text-slate-800 mt-0.5">{SITE_CONFIG.phone} / +62 812-3456-7890</div>
                </div>
              </div>
            </div>

            <a
              href="https://maps.google.com/?q=SDK+Maria+Fatima+Jember"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-800 hover:underline pt-2"
            >
              <span>Buka Petunjuk Arah di Google Maps</span>
              <span>↗</span>
            </a>
          </div>

          <!-- Maps Embed Container (Right) -->
          <div class="lg:col-span-7">
            <div class="w-full h-[420px] sm:h-[480px] rounded-3xl overflow-hidden shadow-xl border border-slate-200 relative bg-slate-100">
              <iframe
                title="Peta Lokasi SDK Maria Fatima Jember"
                class="w-full h-full border-0"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3949.3364950942516!2d113.6961208!3d-8.168798!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd6943af6b5e0c5%3A0xbca12a433a763ff4!2sSDK%20Maria%20Fatima!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- 9. FOOTER -->
  <Footer />
</BaseLayout>
