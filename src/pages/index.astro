---
/**
 * index.astro — Landing Page SDK Maria Fatima Jember
 *
 * Strictly follows the PDF Landing Page Structure (Page 2) inspired by sdh.sch.id:
 * 1. Hero Banner (Video Profil)
 * 2. Carousel VisMis (Visi, Misi, Core Value, Tagline)
 * 3. Tentang SDK (Singkat)
 * 4. Keunggulan Sekolah (Akreditasi, Prestasi/Juara, Karakter, Fasilitas)
 * 5. Carousel Testimoni Alumni (5 Alumni, @2 Paragraf)
 * 6. Cards Instagram Feed (Feeds, Reels @sdkmartimjember)
 * 7. Registrasi (Call to Action - CTA)
 * 8. Lokasi + Maps (Google Maps SDK Maria Fatima Jember)
 * 9. Footer
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeroVideo from "@/components/HeroVideo.astro";
import VisiMisiSection from "@/components/VisiMisiSection.astro";
import TaglineSection from "@/components/TaglineSection.astro";
import CarouselTestimoni from "@/components/CarouselTestimoni.svelte";
import InstagramFeed from "@/components/InstagramFeed.astro";
import { SITE_CONFIG } from "@/utils/config";
---

<BaseLayout
  title="Beranda"
  description="Website Resmi SDK Maria Fatima Jember — Sekolah Dasar Katolik unggulan di Kabupaten Jember. Membina tunas muda yang cerdas, berkarakter luhur, dan berakar kasih."
  preloadImages={['/sdk/gedung-lapangan.jpg', '/logo/logo-sdk.png']}
>
  <Header />

  <main id="main-content" class="min-h-screen">
    <!-- 1. HERO BANNER (VIDEO PROFIL ALA SDH) -->
    <HeroVideo />

    <!-- 2. DARK BRIDGE CONTAINER: VISI, MISI & TAGLINE (MENYATU DENGAN VIDEO) -->
    <div class="bg-slate-950 relative overflow-hidden">
      <!-- Ambient subtle deep glows matching video mood -->
      <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-900/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-indigo-950/40 rounded-full blur-3xl pointer-events-none"></div>

      <!-- 2.1 VISI & MISI SEKOLAH (SIDE-BY-SIDE STANDALONE COMPONENT) -->
      <VisiMisiSection />

      <!-- 2.2 TAGLINE & SPIRITUALITAS KASIH (STANDALONE COMPONENT) -->
      <TaglineSection />
    </div>

    <!-- 3. TENTANG SDK (SINGKAT ALA SDH: ABOUT SDK MARIA FATIMA) -->
    <section
      id="tentang-singkat"
      class="py-16 sm:py-24 bg-white relative overflow-hidden"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <!-- Image / Visual Composition (Left) -->
          <div class="lg:col-span-5 relative">
            <div class="relative mx-auto max-w-md lg:max-w-none">
              <!-- Decorative backing card -->
              <div
                class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-blue-600 to-amber-400 opacity-20 blur-xl"
              >
              </div>

              <div
                class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-100 ring-1 ring-slate-200"
              >
                <img
                  src="/sdk/gedung-lapangan.jpg"
                  alt="Gedung Bersejarah & Lapangan SDK Maria Fatima Jember"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <!-- Floating Experience Badge -->
              <div
                class="absolute -bottom-6 -right-4 sm:right-6 bg-white rounded-2xl p-4 shadow-xl border border-slate-100 flex items-center gap-3"
              >
                <div
                  class="w-12 h-12 rounded-xl bg-blue-700 text-white font-heading font-black text-xl flex items-center justify-center shadow-md"
                >
                  <span class="stat-counter" data-target="65">0</span>+
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">
                    Dedikasi
                  </div>
                  <div
                    class="text-sm font-heading font-extrabold text-slate-900"
                  >
                    Tahun Melayani di Jember
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Content Details (Right) -->
          <div class="lg:col-span-7 space-y-6">
            <div
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider"
            >
              <span>ABOUT SDK MARIA FATIMA</span>
            </div>

            <h2
              class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-slate-900 tracking-tight leading-tight"
            >
              Mendidik dengan Hati, <br class="hidden sm:inline" />
              <span class="text-blue-700">Membentuk Karakter Pemimpin</span>
            </h2>

            <p
              class="text-slate-600 text-base sm:text-lg leading-relaxed font-normal"
            >
              SD Katolik Maria Fatima Jember merupakan sekolah Katolik yang telah melayani pendidikan sejak 1935 di bawah naungan Perkumpulan Dharmaputri. Berakar pada spiritualitas Santa Julia Billiart dan core value Unggul, Kasih, dan Bermartabat, kami membentuk generasi yang beriman, berkarakter, berprestasi, serta siap membawa terang dan kebaikan bagi sesama.
            </p>

            <p
              class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal"
            >
              Selama hampir satu abad, SD Katolik Maria Fatima Jember terus bertumbuh sebagai komunitas pendidikan yang memadukan keunggulan akademik, pembentukan karakter, dan nilai-nilai Katolik. Melalui lingkungan belajar yang penuh kasih dan budaya sekolah yang berorientasi pada karakter, Maria Fatima hadir untuk menemani perjalanan pendidikan putra-putri Anda.
            </p>

            <!-- Key Points -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <div
                class="group flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-white hover:border-blue-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
              >
                <span class="w-7 h-7 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0 shadow-2xs transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">✓</span>
                <span class="text-sm font-bold text-slate-800 group-hover:text-blue-700 transition-colors"
                  >Kurikulum Merdeka Interaktif</span
                >
              </div>
              <div
                class="group flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-white hover:border-blue-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
              >
                <span class="w-7 h-7 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0 shadow-2xs transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">✓</span>
                <span class="text-sm font-bold text-slate-800 group-hover:text-blue-700 transition-colors"
                  >Digital Learning</span
                >
              </div>
              <div
                class="group flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-white hover:border-blue-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
              >
                <span class="w-7 h-7 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0 shadow-2xs transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">✓</span>
                <span class="text-sm font-bold text-slate-800 group-hover:text-blue-700 transition-colors"
                  >Pendidikan Karakter Kristiani</span
                >
              </div>
              <div
                class="group flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-white hover:border-blue-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300"
              >
                <span class="w-7 h-7 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0 shadow-2xs transition-colors duration-300 group-hover:bg-blue-600 group-hover:text-white">✓</span>
                <span class="text-sm font-bold text-slate-800 group-hover:text-blue-700 transition-colors"
                  >Ekstrakurikuler Berprestasi</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. CAROUSEL TESTIMONI ALUMNI (DARI SPREADSHEET ALUMNI) -->
    <CarouselTestimoni client:load />

    <!-- 6. CARDS INSTAGRAM FEED (FEEDS & REELS @SDKMARTIMJEMBER) -->
    <InstagramFeed />

    <!-- 7. REGISTRASI / CALL TO ACTION (ALA SDH: BE A PART OF OUR COMMUNITY) -->
    <section
      id="registrasi-cta"
      class="py-16 sm:py-24 bg-slate-50 relative overflow-hidden"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="bg-gradient-to-br from-white via-blue-50/60 to-white text-slate-900 rounded-3xl p-8 sm:p-14 md:p-16 text-center shadow-xl border-2 border-blue-200/80 relative overflow-hidden"
        >
          <!-- Ambient lighting effects -->
          <div
            class="absolute -top-24 -right-24 w-96 h-96 bg-amber-100/60 rounded-full blur-3xl pointer-events-none -z-10"
          >
          </div>
          <div
            class="absolute -bottom-24 -left-24 w-96 h-96 bg-sky-100/60 rounded-full blur-3xl pointer-events-none -z-10"
          >
          </div>

          <div class="relative z-10 space-y-6 max-w-3xl mx-auto">
            <div
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 border border-blue-200 text-blue-800 text-xs font-extrabold uppercase tracking-widest shadow-xs"
            >
              <span>SPMB TAHUN AJARAN 2027/2028</span>
            </div>

            <h2
              class="text-3xl sm:text-4xl md:text-5xl font-heading font-black tracking-tight leading-tight text-slate-900"
            >
              Be a Part of Our Lifelong <br class="hidden sm:inline" />
              <span class="text-blue-700">
                Transformative Learning Community
              </span>
            </h2>

            <p
              class="text-slate-600 text-base sm:text-lg font-normal leading-relaxed"
            >
              Pintu pendaftaran peserta didik baru (SPMB) telah dibuka. Berikan
              fondasi terbaik bagi masa depan, karakter, dan iman ananda
              tercinta bersama SDK Maria Fatima Jember.
            </p>

            <div
              class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4"
            >
              <a
                href="/admission"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-heading font-black text-base text-white bg-gradient-to-r from-blue-700 via-blue-600 to-blue-800 hover:from-blue-800 hover:to-blue-900 shadow-lg shadow-blue-700/25 hover:scale-105 active:scale-95 transition-all duration-200"
              >
                <span>Daftar Sekarang Secara Online</span>
                <span>→</span>
              </a>

              <a
                href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=Halo%20Admin%20SDK%20Maria%20Fatima,%20saya%20ingin%20konsultasi%20pendaftaran%20SPMB%202027/2028`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl font-bold text-base text-slate-700 hover:text-blue-700 bg-white hover:bg-slate-50 border border-slate-200/90 shadow-sm transition-all"
              >
                <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Konsultasi Informasi via WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. LOKASI + GOOGLE MAPS -->
    <section
      id="lokasi-maps"
      class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200/60 relative"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <!-- Location Info Box (Left) -->
          <div class="lg:col-span-5 space-y-6">
            <div
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-wider"
            >
              <span>LOKASI &amp; LAYANAN</span>
            </div>

            <h2
              class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight"
            >
              Kunjungi Sekolah Kami di Jember
            </h2>

            <p class="text-slate-600 text-base leading-relaxed">
              Terletak strategis di pusat kota Jember, SDK Maria Fatima
              menyediakan lingkungan yang aman, nyaman, dan mudah diakses oleh
              para orang tua dan penjemput.
            </p>

            <div class="space-y-4 pt-2">
              <div
                class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs"
              >
                <svg
                  class="w-6 h-6 text-blue-700 shrink-0 mt-0.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">
                    Alamat Sekolah
                  </div>
                  <div class="text-sm font-semibold text-slate-800 mt-0.5">
                    {SITE_CONFIG.address}
                  </div>
                  <div
                    class="inline-flex items-center gap-1.5 mt-2 px-2.5 py-1 rounded-md bg-blue-50 border border-blue-100 text-blue-700 text-xs font-mono font-bold"
                  >
                    <svg
                      class="w-3.5 h-3.5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                      ></path>
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>Titik Koordinat:</span>
                    <span>-8.1713365, 113.7008447</span>
                  </div>
                </div>
              </div>

              <div
                class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs"
              >
                <svg
                  class="w-6 h-6 text-blue-700 shrink-0 mt-0.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">
                    Jam Pelayanan Kantor
                  </div>
                  <div class="text-sm font-semibold text-slate-800 mt-0.5">
                    Senin – Jumat: 07.00 – 14.30 WIB
                  </div>
                  <div class="text-xs text-slate-500 mt-0.5">
                    Sabtu: 07.30 – 12.00 WIB (Khusus Informasi SPMB)
                  </div>
                </div>
              </div>

              <div
                class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs"
              >
                <svg
                  class="w-6 h-6 text-blue-700 shrink-0 mt-0.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
                <div>
                  <div class="text-xs font-bold text-slate-400 uppercase">
                    Telepon &amp; WhatsApp
                  </div>
                  <div class="text-sm font-semibold text-slate-800 mt-0.5">
                    0813 5897 7450 (Bpk. Alex) / 0812 1751 3124 (Ibu Kikis)
                  </div>
                </div>
              </div>
            </div>

            <a
              href={SITE_CONFIG.mapsUrl ||
                "https://maps.google.com/?q=-8.1713365,113.7008447"}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-800 hover:underline pt-2"
            >
              <span>Buka Petunjuk Arah di Google Maps</span>
              <span>↗</span>
            </a>
          </div>

          <!-- Maps Embed Container (Right) -->
          <div class="lg:col-span-7">
            <div
              class="w-full h-[420px] sm:h-[480px] rounded-3xl overflow-hidden shadow-xl border border-slate-200 relative bg-slate-100"
            >
              <iframe
                title="Peta Lokasi SDK Maria Fatima Jember"
                class="w-full h-full border-0"
                src={SITE_CONFIG.mapsEmbedUrl ||
                  "https://maps.google.com/maps?q=-8.1713365,113.7008447&hl=id&z=17&output=embed"}
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- 9. FOOTER -->
  <Footer />
</BaseLayout>
