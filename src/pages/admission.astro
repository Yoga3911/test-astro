---
/**
 * admission.astro — Penerimaan Peserta Didik Baru (SPMB Online) SDK Maria Fatima Jember
 *
 * Konten disesuaikan 100% dengan 5 Materi Brosur Resmi:
 * 1. Poster Utama: SPMB T.A. 2027/2028, Dibuka 25 September 2026, Potongan DPP 50% (Sept - Okt)
 * 2. Mengapa Memilih SDK Maria Fatima Jember (5 Pilar Keunggulan)
 * 3. Alur Pendaftaran (4 Tahapan)
 * 4. Syarat Pendaftaran (4 Dokumen/Persyaratan)
 * 5. Informasi Pendaftaran & Layanan Sekretariat TU
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AdmissionForm from "@/components/AdmissionForm.svelte";
import { SITE_CONFIG } from "@/utils/config";

// ─── 1. Mengapa Memilih SDK Maria Fatima (5 Pilar Keunggulan) ───────────────
const KEUNGGULAN_LIST = [
  {
    number: "01",
    title: "Aman untuk bertumbuh",
    desc: "Lingkungan sekolah ramah anak yang aman, nyaman, inklusif, dan bebas perundungan.",
    icon: "shield",
  },
  {
    number: "02",
    title: "Cerdas dalam berpikir, baik dalam bersikap",
    desc: "Keseimbangan pembinaan nalar kritis akademik dan keluhuran budi pekerti Kristiani.",
    icon: "brain-heart",
  },
  {
    number: "03",
    title: "Didampingi untuk tumbuh dan belajar",
    desc: "Para pendidik berdedikasi tinggi yang mendampingi setiap fase tumbuh kembang anak secara personal.",
    icon: "mentor",
  },
  {
    number: "04",
    title: "Cakap digital, siap mencipta bersama Sokrates Empowering School",
    desc: "Integrasi kurikulum teknologi dan literasi digital modern terakreditasi bersama Sokrates.",
    icon: "digital",
  },
  {
    number: "05",
    title: "90+ tahun menumbuhkan generasi",
    desc: "Warisan tradisi pendidikan Katolik SPM yang telah teruji menghasilkan generasi berprestasi lintas zaman.",
    icon: "badge-90",
  },
];

// ─── 2. Alur Pendaftaran (4 Langkah Resmi) ──────────────────────────────────
const ALUR_PENDAFTARAN = [
  {
    step: "1",
    title: "Membeli formulir pendaftaran",
    desc: "Membeli formulir pendaftaran secara online melalui website ini atau langsung ke kantor tata usaha sekolah.",
  },
  {
    step: "2",
    title: "Mengisi dan melengkapi formulir beserta dokumen pendukung",
    desc: "Melengkapi formulir data calon murid serta melampirkan berkas identitas yang dipersyaratkan.",
  },
  {
    step: "3",
    title: "Mengembalikan formulir pendaftaran",
    desc: "Menyerahkan kembali formulir pendaftaran yang telah diisi lengkap ke sekretariat panitia SPMB.",
  },
  {
    step: "4",
    title: "Pelaksanaan wawancara",
    desc: "Sesi ramah anak dan wawancara orang tua bersama tim pendidik SDK Maria Fatima.",
  },
];

// ─── 3. Syarat Pendaftaran Resmi (4 Poin) ───────────────────────────────────
const SYARAT_PENDAFTARAN = [
  "Membeli dan mengisi formulir pendaftaran",
  "Fotokopi identitas keluarga (KTP Ayah/Ibu, Kartu Keluarga)",
  "Fotokopi akta kelahiran",
  "Fotokopi surat baptis bagi yang beragama Katolik",
];

// ─── 4. Informasi Layanan & Kontak Resmi ────────────────────────────────────
const INFORMASI_KONTAK = [
  {
    nama: "Bapak Alex",
    role: "Kontak WhatsApp",
    telepon: "0813 5897 7450",
    href: `https://wa.me/6281358977450?text=Halo%20Bapak%20Alex,%20saya%20ingin%20konsultasi%20pendaftaran%20SPMB%20SDK%20Maria%20Fatima`,
    icon: "whatsapp",
  },
  {
    nama: "Ibu Kikis",
    role: "Kontak Informasi",
    telepon: "0812 1751 3124",
    href: "tel:081217513124",
    icon: "phone",
  },
  {
    nama: "Kantor Tata Usaha",
    role: "Alamat Sekolah",
    telepon: "Jalan Kartini No. 24 Jember",
    href: SITE_CONFIG.mapsUrl,
    icon: "location",
  },
  {
    nama: "Senin – Jum'at",
    role: "Jam Kerja Layanan",
    telepon: "Pkl. 08.00 – 13.00 WIB",
    href: null,
    icon: "clock",
  },
];

const ppdbSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Sistem Penerimaan Murid Baru (SPMB) ${SITE_CONFIG.name}`,
  description: `Informasi resmi pendaftaran peserta didik baru (SPMB) ${SITE_CONFIG.name} Tahun Ajaran 2027/2028. Dibuka 25 September 2026. Potongan DPP 50% untuk pendaftaran September - Oktober.`,
  url: `${SITE_CONFIG.url}/admission`,
};
---

<BaseLayout
  title="Admission — SPMB Online 2027/2028"
  description="Penerimaan Murid Baru (SPMB) SDK Maria Fatima Jember T.A. 2027/2028. Dibuka 25 September 2026. Potongan DPP 50% untuk pendaftaran September - Oktober."
  structuredData={ppdbSchema}
>
  <Header />

  <main id="main-content">
    <!-- ════════════════════════════════════════════════════════════════════════
         HERO SECTION: BANNER UTAMA SPMB 2027/2028 (DARI POSTER UTAMA)
         ════════════════════════════════════════════════════════════════════════ -->
    <section class="bg-gradient-to-b from-blue-950 via-blue-900 to-slate-900 text-white pt-14 pb-20 sm:pt-20 sm:pb-24 relative overflow-hidden">
      <!-- Ambient Glows -->
      <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-amber-400/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          
          <!-- Text Content (Left) -->
          <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
            
            <!-- Institusi & Semboyan -->
            <div class="inline-flex flex-wrap items-center justify-center lg:justify-start gap-2">
              <span class="px-3.5 py-1 rounded-full bg-white/10 text-blue-200 border border-white/15 text-xs font-bold uppercase tracking-wider">
                PERKUMPULAN DHARMAPUTRI
              </span>
              <span class="px-3.5 py-1 rounded-full bg-amber-400/20 text-amber-300 border border-amber-400/30 text-xs font-extrabold uppercase tracking-wider">
                Unggul • Kasih • Bermartabat
              </span>
            </div>

            <!-- Main Title -->
            <div class="space-y-2">
              <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-heading font-black tracking-tight text-white leading-tight">
                Sistem Penerimaan <br class="hidden sm:inline" />
                <span class="text-amber-400">Murid Baru</span>
              </h1>
              <p class="text-lg sm:text-xl font-heading font-extrabold text-blue-200 tracking-wide">
                TAHUN AJARAN 2027/2028
              </p>
            </div>

            <!-- Subtitle Semboyan -->
            <p class="text-sm sm:text-base text-blue-100/85 max-w-xl mx-auto lg:mx-0 font-normal leading-relaxed italic">
              "Tota Christi Per Mariam — Living Value, Creating Digitally"
            </p>

            <!-- Jadwal Buka & Diskon DPP 50% Promo Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <!-- Tanggal Buka -->
              <div class="p-5 rounded-3xl bg-white/10 backdrop-blur-md border border-white/15 flex items-center gap-4 shadow-lg text-left">
                <div class="w-14 h-14 rounded-2xl bg-blue-600 text-white flex items-center justify-center text-2xl shrink-0 shadow-inner">
                  📅
                </div>
                <div>
                  <div class="text-[11px] font-extrabold text-blue-200 uppercase tracking-wider">
                    Jadwal Pendaftaran:
                  </div>
                  <div class="text-base sm:text-lg font-heading font-black text-white">
                    DIBUKA 25 SEPT 2026
                  </div>
                  <div class="text-xs text-amber-300 font-semibold mt-0.5">
                    Tahun Ajaran 2027/2028
                  </div>
                </div>
              </div>

              <!-- Promo Potongan DPP 50% -->
              <div class="p-5 rounded-3xl bg-gradient-to-br from-amber-500/20 via-amber-400/10 to-transparent backdrop-blur-md border border-amber-400/40 flex items-center gap-4 shadow-lg text-left">
                <div class="w-14 h-14 rounded-2xl bg-amber-400 text-slate-950 flex flex-col items-center justify-center font-heading font-black shrink-0 shadow-md">
                  <span class="text-xs leading-none">POTONGAN</span>
                  <span class="text-lg leading-none mt-0.5">50%</span>
                </div>
                <div>
                  <div class="text-xs font-heading font-black text-amber-300 uppercase tracking-wide">
                    POTONGAN DPP 50%
                  </div>
                  <div class="text-xs text-white/90 leading-snug mt-0.5 font-medium">
                    Untuk Pendaftaran di Bulan September – Oktober
                  </div>
                </div>
              </div>
            </div>

            <!-- Pengumuman Kuota Terbatas -->
            <div class="p-3.5 rounded-2xl bg-blue-900/60 border border-blue-700/60 flex items-center justify-center lg:justify-start gap-2.5 text-xs text-amber-300 font-bold shadow-sm">
              <span class="text-base">📢</span>
              <span>Kuota terbatas, segera daftarkan putra-putri Anda.</span>
            </div>

            <!-- REKOMENDASI UX: FAST TRACK CTA BUTTONS -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
              <!-- Fast Track 1: Langsung ke Formulir -->
              <a
                href="#formulir-online"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl font-heading font-black text-base text-slate-950 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-400 hover:from-amber-300 hover:to-amber-200 shadow-xl shadow-amber-400/25 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer"
              >
                <span>Langsung Isi Formulir Pendaftaran</span>
                <span class="text-lg">↓</span>
              </a>

              <!-- Fast Track 2: Lihat Alur & Syarat -->
              <a
                href="#alur-pendaftaran"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl font-heading font-bold text-sm text-white bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/40 transition-all text-center"
              >
                <span>Lihat Alur &amp; Syarat</span>
                <span>→</span>
              </a>
            </div>

          </div>

          <!-- Native UI Showcase Card (Right) -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="w-full max-w-md bg-gradient-to-b from-white/15 to-white/5 backdrop-blur-xl border border-white/20 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 text-left relative overflow-hidden">
              
              <!-- Subtle decorative accent -->
              <div class="absolute -top-12 -right-12 w-36 h-36 bg-amber-400/20 rounded-full blur-2xl pointer-events-none"></div>

              <!-- Card Header -->
              <div class="border-b border-white/15 pb-4 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="px-3 py-0.5 rounded-full bg-amber-400 text-slate-950 text-[11px] font-black uppercase tracking-wider">
                    SPMB RESMI
                  </span>
                  <span class="text-xs text-blue-200 font-semibold">T.A. 2027/2028</span>
                </div>
                <h3 class="text-xl sm:text-2xl font-heading font-black text-white leading-tight">
                  SDK Maria Fatima Jember
                </h3>
                <p class="text-xs text-blue-200/90 font-medium">
                  Perkumpulan Dharmaputri • Sokrates Empowering School
                </p>
              </div>

              <!-- Key Highlights Box -->
              <div class="space-y-3">
                <div class="p-4 rounded-2xl bg-amber-400/15 border border-amber-400/30 space-y-1">
                  <div class="text-[11px] font-extrabold text-amber-300 uppercase tracking-wider">
                    Penawaran Istimewa:
                  </div>
                  <div class="text-xl font-heading font-black text-amber-300">
                    POTONGAN DPP 50%
                  </div>
                  <div class="text-xs text-white/90">
                    Khusus pendaftaran di bulan <strong>September – Oktober</strong>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-white/10 border border-white/15 space-y-1">
                  <div class="text-[11px] font-extrabold text-blue-200 uppercase tracking-wider">
                    Status Pendaftaran:
                  </div>
                  <div class="text-lg font-heading font-black text-white flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Dibuka 25 September 2026</span>
                  </div>
                </div>
              </div>

              <!-- Checklist Keunggulan Ringkas -->
              <ul class="space-y-2 text-xs text-blue-100/90 pt-1">
                <li class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                  <span>Aman, inklusif, dan ramah anak</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                  <span>Penguatan literasi digital &amp; nalar kritis</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center text-[10px] font-black shrink-0">✓</span>
                  <span>90+ tahun mendidik generasi berprestasi</span>
                </li>
              </ul>

              <!-- Card CTA -->
              <div class="pt-2">
                <a
                  href="#formulir-online"
                  class="w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-2xl font-heading font-bold text-sm text-slate-950 bg-amber-400 hover:bg-amber-300 shadow-lg shadow-amber-400/20 active:scale-95 transition-all text-center"
                >
                  <span>Daftar Sekarang Secara Online</span>
                  <span>→</span>
                </a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════════════════
         BAGIAN 1: MENGAPA MEMILIH SDK MARIA FATIMA JEMBER (5 PILAR RESMI)
         ════════════════════════════════════════════════════════════════════════ -->
    <section class="py-16 sm:py-24 bg-white relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-14">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider mb-3">
            <span>5 KEUNGGULAN UTAMA</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
            Mengapa Memilih SDK Maria Fatima Jember?
          </h2>
          <p class="text-slate-600 mt-3 text-base sm:text-lg leading-relaxed">
            Menghadirkan lingkungan belajar holistik yang berakar pada kasih, kecerdasan intelektual, dan kesiapan teknologi masa depan.
          </p>
        </div>

        <!-- 5 Pillars Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
          {KEUNGGULAN_LIST.map((item) => (
            <div class="group bg-slate-50 rounded-3xl p-6 border border-slate-200/90 shadow-xs hover:shadow-xl hover:border-blue-400 hover:bg-white hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center font-heading font-black text-base shadow-2xs group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    {item.number}
                  </span>
                  
                  <!-- Pillar Icons -->
                  <span class="text-2xl">
                    {item.icon === "shield" && "🛡️"}
                    {item.icon === "brain-heart" && "🧠❤️"}
                    {item.icon === "mentor" && "👩‍🏫"}
                    {item.icon === "digital" && "💻"}
                    {item.icon === "badge-90" && "⭐"}
                  </span>
                </div>

                <h3 class="text-base font-heading font-black text-slate-900 leading-snug group-hover:text-blue-700 transition-colors">
                  {item.title}
                </h3>

                <p class="text-xs text-slate-600 leading-relaxed font-normal">
                  {item.desc}
                </p>
              </div>

              <div class="pt-4 mt-4 border-t border-slate-200/70 text-[11px] font-bold text-blue-600 group-hover:translate-x-1 transition-transform">
                SDK Maria Fatima →
              </div>
            </div>
          ))}
        </div>

        <!-- Slogan Banner dari Poster -->
        <div class="mt-12 text-center">
          <div class="inline-block p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-blue-50 via-amber-50 to-blue-50 border border-amber-200/80 shadow-sm max-w-3xl mx-auto">
            <p class="text-lg sm:text-2xl font-heading font-black text-blue-900 italic tracking-tight">
              "Bersama Maria Fatima, Raih Masa Depan yang Lebih Baik!"
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════════════════
         BAGIAN 2: ALUR PENDAFTARAN (4 TAHAPAN RESMI DARI POSTER)
         ════════════════════════════════════════════════════════════════════════ -->
    <section id="alur-pendaftaran" class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200/80 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-14">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold uppercase tracking-wider mb-3">
            <span>PROSES PENERIMAAN</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
            Alur Pendaftaran Murid Baru
          </h2>
          <p class="text-slate-600 mt-2 text-base leading-relaxed">
            Tahapan pendaftaran yang jelas, ramah, dan terstruktur untuk kenyamanan keluarga calon peserta didik.
          </p>
        </div>

        <!-- 4 Steps Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {ALUR_PENDAFTARAN.map((step) => (
            <div class="group bg-white rounded-3xl p-7 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-blue-400 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 border border-blue-200/60 flex items-center justify-center text-lg font-heading font-black shadow-2xs group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
                    0{step.step}
                  </span>
                  <span class="text-[11px] font-heading font-black uppercase px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 group-hover:bg-blue-100 group-hover:text-blue-800 transition-colors">
                    Tahap {step.step}
                  </span>
                </div>

                <h3 class="text-base sm:text-lg font-heading font-black text-slate-900 mb-2 group-hover:text-blue-700 transition-colors leading-snug">
                  {step.title}
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                  {step.desc}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100">
                <a
                  href="#formulir-online"
                  class="text-xs font-bold text-blue-700 hover:text-blue-900 inline-flex items-center gap-1 group-hover:gap-2 transition-all"
                >
                  <span>Mulai Tahap 01 Sekarang</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Slogan Penutup Alur dari Poster -->
        <div class="mt-12 text-center">
          <p class="text-sm sm:text-base font-heading font-bold text-slate-700 max-w-2xl mx-auto">
            "Bersama SDK Maria Fatima membentuk generasi yang <span class="text-blue-700 font-extrabold">unggul</span>, <span class="text-amber-600 font-extrabold">berbelas kasih</span> dan <span class="text-blue-900 font-extrabold">bermartabat</span> ♡"
          </p>
        </div>

      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════════════════
         BAGIAN 3: SYARAT PENDAFTARAN & FORMULIR REGISTRASI (SIDE-BY-SIDE)
         ════════════════════════════════════════════════════════════════════════ -->
    <section id="formulir-online" class="py-16 sm:py-24 bg-white border-t border-slate-200/80 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          
          <!-- LEFT COLUMN: SYARAT & INFORMASI PENDAFTARAN (DARI 2 POSTER) -->
          <div class="lg:col-span-5 space-y-8">
            
            <!-- 1. SYARAT PENDAFTARAN (DARI POSTER SYARAT) -->
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider">
                <span>DOKUMEN PERSYARATAN</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 tracking-tight">
                Syarat Pendaftaran
              </h2>

              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                Persiapkan dokumen di bawah ini untuk kelengkapan administrasi peserta didik baru:
              </p>

              <!-- 4 Syarat Checklist -->
              <ul class="space-y-3 pt-1">
                {SYARAT_PENDAFTARAN.map((syarat) => (
                  <li class="group flex items-start gap-3.5 p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:bg-white hover:border-blue-400 hover:shadow-md transition-all duration-200 text-xs sm:text-sm font-semibold text-slate-800">
                    <span class="w-6 h-6 rounded-lg bg-amber-400 text-slate-950 flex items-center justify-center text-xs font-black shrink-0 mt-0.5 shadow-2xs">
                      ✓
                    </span>
                    <span class="leading-relaxed">{syarat}</span>
                  </li>
                ))}
              </ul>

              <!-- Kutipan Syarat Poster -->
              <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200/80 text-xs text-amber-950 leading-relaxed font-medium">
                <span class="font-bold">"Langkah kecil hari ini, untuk masa depan besar nanti."</span>
                <p class="text-[11px] text-amber-900/85 mt-0.5">
                  Bersama SDK Maria Fatima, siap menjadi pribadi yang cerdas, baik, dan berkarakter!
                </p>
              </div>
            </div>

            <!-- 2. INFORMASI PENDAFTARAN (DARI POSTER INFORMASI) -->
            <div class="p-6 sm:p-7 rounded-3xl bg-blue-50/80 border border-blue-200 space-y-5">
              <div class="flex items-center justify-between border-b border-blue-200/80 pb-3">
                <h3 class="font-heading font-black text-base text-blue-900">
                  Informasi Pendaftaran
                </h3>
                <span class="px-2.5 py-0.5 rounded-full bg-blue-200 text-blue-900 text-[10px] font-extrabold uppercase">
                  Kontak Resmi
                </span>
              </div>

              <!-- Banner Kuota Terbatas dari Poster -->
              <div class="p-3 rounded-xl bg-amber-400 text-slate-950 text-xs font-extrabold flex items-center gap-2 shadow-xs">
                <span>📢</span>
                <span>Kuota terbatas, segera daftarkan putra-putri anda.</span>
              </div>

              <!-- List Kontak -->
              <div class="space-y-3">
                {INFORMASI_KONTAK.map((info) => (
                  <div class="flex items-start gap-3 p-3 rounded-xl bg-white border border-blue-100 shadow-2xs">
                    <span class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                      {info.icon === "whatsapp" && "💬"}
                      {info.icon === "phone" && "📞"}
                      {info.icon === "location" && "📍"}
                      {info.icon === "clock" && "⏰"}
                    </span>
                    <div class="text-xs">
                      <div class="font-bold text-slate-800">{info.nama}</div>
                      <div class="text-[11px] text-slate-500 font-medium">{info.role}</div>
                      {info.href ? (
                        <a
                          href={info.href}
                          target={info.href.startsWith("http") ? "_blank" : undefined}
                          rel={info.href.startsWith("http") ? "noopener noreferrer" : undefined}
                          class="font-extrabold text-blue-700 hover:underline mt-0.5 inline-block"
                        >
                          {info.telepon} →
                        </a>
                      ) : (
                        <div class="font-bold text-slate-800 mt-0.5">{info.telepon}</div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>

          <!-- RIGHT COLUMN: FORMULIR PENDAFTARAN ONLINE (SPMB FORM SVELTE) -->
          <div class="lg:col-span-7 bg-slate-50 rounded-3xl p-6 sm:p-10 border border-slate-200/90 shadow-xl relative">
            <div class="mb-6 border-b border-slate-200 pb-4">
              <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase mb-2">
                <span>TAHAP 01: FORMULIR ONLINE</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-heading font-black text-slate-900">
                Formulir Pendaftaran Siswa Baru
              </h3>
              <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Lengkapi 5 data calon peserta didik di bawah ini. Data langsung terhubung otomatis ke database Google Spreadsheet panitia.
              </p>
            </div>

            <!-- Svelte 5 Form Component -->
            <AdmissionForm client:load />
          </div>

        </div>

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
