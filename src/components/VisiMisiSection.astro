---
/**
 * VisiMisiSection.astro
 *
 * Dedicated section for Visi & Misi SDK Maria Fatima Jember:
 * - Side-by-side card layout (Our Vision & Our Mission)
 * - Clean bright theme with high contrast typography
 */

import { VISI_MISI_DATA } from '@/utils/config';
---

<section id="visi-misi" class="pt-12 sm:pt-16 pb-6 relative overflow-hidden">
  <!-- Soft ambient glow -->
  <div class="absolute top-0 right-1/4 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-0 left-1/4 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 items-stretch">
      
      <!-- Left Card: Our Vision -->
      <div class="bg-white rounded-3xl p-7 sm:p-9 border-2 border-blue-600 shadow-xl hover:shadow-2xl hover:border-blue-700 transition-all duration-300 flex flex-col justify-between group">
        <div class="space-y-5">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 group-hover:scale-125 transition-transform"></span>
            <span class="text-xs font-extrabold uppercase tracking-widest text-amber-600">OUR VISION</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 leading-snug">
            Visi SDK Maria Fatima
          </h2>
          <blockquote class="text-base sm:text-lg text-slate-800 font-heading font-bold leading-relaxed border-l-4 border-blue-600 pl-4 py-2 bg-blue-50/40 rounded-r-2xl">
            "{VISI_MISI_DATA.visi}"
          </blockquote>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Membentuk lingkungan belajar yang ramah anak, berakar pada cinta kasih Kristiani, menjunjung martabat kemanusiaan, serta memiliki kompetensi dan wawasan global di era digital.
          </p>
        </div>
        <div class="pt-5 mt-6 border-t border-slate-100 text-xs text-slate-500 font-bold flex items-center gap-2">
          <span>SDK Maria Fatima Jember</span>
        </div>
      </div>

      <!-- Right Card: Our Mission -->
      <div class="bg-white rounded-3xl p-7 sm:p-9 border-2 border-blue-600 shadow-xl hover:shadow-2xl hover:border-blue-700 transition-all duration-300 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-600 group-hover:scale-125 transition-transform"></span>
            <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600">OUR MISSION</span>
          </div>
          <div>
            <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 leading-snug">
              Misi SD Katolik Maria Fatima
            </h2>
            <p class="text-xs font-semibold text-slate-500 mt-1">Langkah Operasional dan Strategi Pembelajaran</p>
          </div>

          <!-- 5 Misi Points without numbers -->
          <div class="space-y-2.5 pt-1">
            {VISI_MISI_DATA.misi.map((m) => (
              <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-blue-50/50 hover:border-blue-200 transition-colors">
                <span class="w-5 h-5 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <p class="text-xs sm:text-sm text-slate-700 font-medium leading-relaxed">
                  {m}
                </p>
              </div>
            ))}
          </div>
        </div>
        <div class="pt-4 mt-6 border-t border-slate-100 text-xs text-slate-500 font-bold flex items-center gap-2">
          <span>Kabupaten Jember</span>
        </div>
      </div>

    </div>

  </div>
</section>
