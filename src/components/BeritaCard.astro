---
/**
 * BeritaCard.astro
 *
 * Single Responsibility: Renders a single news card.
 * Receives article data as props, no business logic inside.
 */

import { formatDate, KATEGORI_COLORS } from '@/utils/config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  berita:   CollectionEntry<'berita'>;
  featured?: boolean;
  class?:   string;
}

const { berita, featured = false, class: className = '' } = Astro.props;
const { title, description, pubDate, kategori, coverImage, author } = berita.data;

const badgeClass  = KATEGORI_COLORS[kategori] ?? 'badge-blue';
// Estimate reading time (avg 200 wpm)
const readingTime = Math.max(2, Math.ceil((berita.body ? berita.body.split(/\s+/).length : description.split(/\s+/).length * 12) / 200));
---

<article
  class={`card ${featured ? 'card-featured' : ''} ${className}`}
  style={`
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    ${featured ? 'grid-column: span 2;' : ''}
  `}
>
  <!-- Cover Image -->
  <a
    href={`/berita/${berita.id}`}
    aria-label={`Baca berita: ${title}`}
    style="display: block; overflow: hidden; border-radius: var(--radius-card) var(--radius-card) 0 0;"
    tabindex="-1"
  >
    <div style="
      position: relative;
      aspect-ratio: 16/9;
      background: #f1f5f9;
      overflow: hidden;
    ">
      {coverImage ? (
        <img
          src={coverImage}
          alt={title}
          width="600"
          height="338"
          style="width:100%; height:100%; object-fit:cover; transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);"
          loading="lazy"
          decoding="async"
          class="card-img"
        />
      ) : (
        <div style="
          width: 100%; height: 100%;
          display: flex; align-items: center; justify-content: center;
          background: linear-gradient(135deg, #eff6ff, #dbeafe);
          color: #2563eb;
        ">
          <svg style="width: 2.5rem; height: 2.5rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
      )}

      <!-- Gradient overlay for category badge legibility -->
      <div style="
        position: absolute; inset: 0;
        background: linear-gradient(0deg, rgba(15,23,42,0.4) 0%, transparent 60%);
      "></div>

      <!-- Featured badge -->
      {featured && (
        <div style="
          position: absolute; top: 0.75rem; left: 0.75rem;
          background: linear-gradient(135deg, #f59e0b, #d97706);
          color: #ffffff;
          font-size: 0.7rem; font-weight: 700;
          padding: 0.25rem 0.625rem;
          border-radius: 9999px;
          letter-spacing: 0.05em;
          text-transform: uppercase;
          box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        ">Unggulan</div>
      )}

      <!-- Kategori badge -->
      <div style="position: absolute; bottom: 0.75rem; left: 0.75rem;">
        <span class={`badge ${badgeClass}`}>{kategori}</span>
      </div>
    </div>
  </a>

  <!-- Content -->
  <div style="padding: 1.5rem; display: flex; flex-direction: column; flex: 1;">
    <!-- Meta -->
    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.875rem; font-size: 0.8rem; color: #64748b;">
      <time datetime={pubDate.toISOString()} style="display: flex; align-items: center; gap: 0.3rem;">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {formatDate(pubDate)}
      </time>
      <span style="display: flex; align-items: center; gap: 0.3rem;">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        {readingTime} menit baca
      </span>
    </div>

    <!-- Title -->
    <h3 style="margin-bottom: 0.75rem; flex-shrink: 0;">
      <a
        href={`/berita/${berita.id}`}
        style={`
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
          color: #0f172a;
          font-size: ${featured ? '1.35rem' : '1.05rem'};
          font-weight: 700;
          line-height: 1.35;
          transition: var(--transition-base);
          text-decoration: none;
        `}
        class="card-title-link"
      >
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p style="
      font-size: 0.875rem;
      color: #475569;
      line-height: 1.65;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      flex: 1;
      margin-bottom: 1.25rem;
    ">
      {description}
    </p>

    <!-- Footer: Author + Read More -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; border-top: 1px solid #f1f5f9; padding-top: 0.875rem;">
      <span style="font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 0.35rem;">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        {author}
      </span>
      <a
        href={`/berita/${berita.id}`}
        class="read-more-link"
        aria-label={`Baca selengkapnya: ${title}`}
        style="
          display: inline-flex; align-items: center; gap: 0.3rem;
          font-size: 0.85rem; font-weight: 700;
          color: #2563eb;
          transition: var(--transition-base);
          text-decoration: none;
        "
      >
        Selengkapnya
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" class="arrow-icon" style="transition: transform 0.2s;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .card:hover .card-img {
    transform: scale(1.06);
  }

  .card-title-link:hover {
    color: #2563eb !important;
  }

  .read-more-link:hover {
    color: #1d4ed8 !important;
  }

  .read-more-link:hover .arrow-icon {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .card-featured {
      grid-column: span 1 !important;
    }
  }
</style>

