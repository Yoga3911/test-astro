---
/**
 * Header.astro
 *
 * Sticky navigation with:
 * - Desktop multi-level dropdowns matching PDF Sitemap (Home, About Us, Heritage, People, News & Events, Media, Classroom, Admission)
 * - Mobile hamburger drawer with interactive accordion
 * - Glassmorphism design and smooth micro-animations
 * - Direct CTA to Admission / PPDB
 */

import { NAV_ITEMS, SITE_CONFIG } from '@/utils/config';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header id="site-header" role="banner" class="sticky top-0 z-50 transition-all duration-300">
  <nav
    id="main-nav"
    aria-label="Navigasi Utama"
    class="w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs transition-all duration-300"
  >
    <div class="w-full px-4 sm:px-6 md:px-8 lg:px-8 xl:px-12 2xl:px-16 h-20 flex items-center justify-between gap-4">

      <!-- Logo & Branding -->
      <a
        href="/"
        id="site-logo"
        aria-label={`${SITE_CONFIG.name} - Halaman Utama`}
        class="flex items-center gap-3 shrink-0 focus:outline-hidden focus:ring-2 focus:ring-blue-600 rounded-xl p-1"
      >
        <!-- Logo Mark -->
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-900 via-blue-800 to-blue-600 flex items-center justify-center font-heading font-black text-white text-lg shadow-md shadow-blue-900/20 group-hover:scale-105 transition-transform duration-300">
          MF
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-extrabold text-base sm:text-lg text-slate-900 leading-tight group-hover:text-blue-700 transition-colors whitespace-nowrap">
            {SITE_CONFIG.shortName}
          </span>
          <span class="text-xs text-amber-600 font-semibold tracking-wide flex items-center gap-1 whitespace-nowrap">
            <span>Yayasan Suster SPM</span> • <span>Jember</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu (Full Width & No Overlap / 1 Line) -->
      <ul id="desktop-nav" role="list" class="hidden lg:flex items-center gap-1 xl:gap-2 2xl:gap-3 list-none m-0 p-0">
        {NAV_ITEMS.map((item) => {
          const hasChildren = item.children && item.children.length > 0;
          const active = isActive(item.href);

          return (
            <li class="relative group/nav py-2 shrink-0">
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                aria-haspopup={hasChildren ? 'true' : undefined}
                class={`whitespace-nowrap inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 shrink-0 ${
                  active
                    ? 'text-blue-700 font-bold bg-blue-50/80 shadow-xs'
                    : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100/80'
                }`}
              >
                <span>{item.label}</span>
                {hasChildren && (
                  <svg
                    class="w-3.5 h-3.5 opacity-60 group-hover/nav:opacity-100 group-hover/nav:rotate-180 transition-transform duration-200 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {/* Dropdown Menu */}
              {hasChildren && (
                <div class="absolute left-0 top-full pt-1.5 hidden group-hover/nav:block group-focus-within/nav:block z-50 min-w-[260px] animate-fadeIn">
                  <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-2 ring-1 ring-slate-900/5">
                    <div class="px-3 py-1.5 mb-1 border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                      {item.label} Menu
                    </div>
                    {item.children!.map((child) => (
                      <a
                        href={child.href}
                        class="block px-3 py-2.5 rounded-xl hover:bg-blue-50/80 transition-colors group/sub"
                      >
                        <div class="text-sm font-semibold text-slate-800 group-hover/sub:text-blue-700 flex items-center justify-between">
                          <span>{child.label}</span>
                          <span class="opacity-0 -translate-x-1 group-hover/sub:opacity-100 group-hover/sub:translate-x-0 transition-all text-blue-600 text-xs">→</span>
                        </div>
                        {child.description && (
                          <div class="text-xs text-slate-500 line-clamp-1 mt-0.5 font-normal">
                            {child.description}
                          </div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>

      <!-- CTA & Mobile Menu Toggle -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/admission"
          class="hidden sm:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-600 hover:from-blue-800 hover:to-indigo-700 shadow-md shadow-blue-700/20 hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all duration-200 whitespace-nowrap"
        >
          <span>PPDB Online</span>
          <span>→</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          aria-label="Buka Menu Navigasi"
          class="lg:hidden p-2.5 rounded-xl text-slate-700 hover:text-blue-700 hover:bg-slate-100 border border-slate-200 transition-colors focus:outline-hidden focus:ring-2 focus:ring-blue-600"
        >
          <svg id="icon-menu" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div
    id="mobile-drawer"
    class="lg:hidden fixed inset-x-0 top-20 bg-white/98 backdrop-blur-lg border-b border-slate-200 shadow-2xl max-h-[calc(100vh-5rem)] overflow-y-auto hidden transition-all duration-300"
  >
    <div class="px-5 py-6 space-y-4">
      {NAV_ITEMS.map((item) => {
        const hasChildren = item.children && item.children.length > 0;
        const active = isActive(item.href);

        if (!hasChildren) {
          return (
            <a
              href={item.href}
              class={`block px-4 py-3 rounded-xl text-base font-semibold transition-colors ${
                active ? 'bg-blue-50 text-blue-700 font-bold' : 'text-slate-800 hover:bg-slate-50'
              }`}
            >
              {item.label}
            </a>
          );
        }

        return (
          <details class="group/mobile rounded-xl border border-slate-100 overflow-hidden bg-slate-50/50">
            <summary class="flex items-center justify-between px-4 py-3 text-base font-semibold text-slate-800 cursor-pointer list-none select-none hover:bg-slate-100/70">
              <span class={active ? 'text-blue-700 font-bold' : ''}>{item.label}</span>
              <svg
                class="w-4 h-4 text-slate-400 group-open/mobile:rotate-180 transition-transform duration-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 pb-3 pt-1 space-y-1 bg-white border-t border-slate-100">
              <a
                href={item.href}
                class="block py-2 text-xs font-bold text-blue-600 uppercase tracking-wider"
              >
                Semua {item.label} →
              </a>
              {item.children!.map((child) => (
                <a
                  href={child.href}
                  class="block py-2 text-sm font-medium text-slate-600 hover:text-blue-700 hover:pl-1 transition-all"
                >
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        );
      })}

      <div class="pt-4 border-t border-slate-200 flex flex-col gap-3">
        <a
          href="/admission"
          class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-white bg-blue-600 hover:bg-blue-700 text-center shadow-md shadow-blue-600/20"
        >
          <span>Pendaftaran Siswa Baru (PPDB)</span>
          <span>→</span>
        </a>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=Halo%20Admin%20SDK%20Maria%20Fatima%20Jember,%20saya%20ingin%20bertanya`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 text-center text-sm"
        >
          <span>💬 Chat WhatsApp Sekolah</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fadeIn {
    animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (btn && drawer && iconMenu && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // Close on click outside or navigation
    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target as Node) && !drawer.contains(e.target as Node) && !drawer.classList.contains('hidden')) {
        btn.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
