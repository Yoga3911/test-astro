---
/**
 * Header.astro
 *
 * Sticky navigation with:
 * - Desktop multi-level dropdowns matching PDF Sitemap (Home, About Us, Heritage, People, News & Events, Media, Classroom, Admission)
 * - Mobile hamburger drawer with interactive accordion
 * - Glassmorphism design and smooth micro-animations
 * - Direct CTA to Admission / SPMB
 */

import { NAV_ITEMS, SITE_CONFIG } from '@/utils/config';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header id="site-header" role="banner" class="sticky top-0 z-50 transition-all duration-300">
  <nav
    id="main-nav"
    aria-label="Navigasi Utama"
    class="w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs transition-all duration-300"
  >
    <div class="w-full px-4 sm:px-6 md:px-8 lg:px-8 xl:px-12 2xl:px-16 h-20 flex items-center justify-between gap-4">

      <!-- Logo & Branding -->
      <a
        href="/"
        id="site-logo"
        aria-label={`${SITE_CONFIG.name} - Halaman Utama`}
        class="flex items-center gap-3 shrink-0 focus:outline-hidden focus:ring-2 focus:ring-blue-600 rounded-xl p-1"
      >
        <!-- Logo Mark -->
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-900 via-blue-800 to-blue-600 flex items-center justify-center font-heading font-black text-white text-lg shadow-md shadow-blue-900/20 group-hover:scale-105 transition-transform duration-300">
          MF
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-extrabold text-base sm:text-lg text-slate-900 leading-tight group-hover:text-blue-700 transition-colors whitespace-nowrap">
            {SITE_CONFIG.shortName}
          </span>
          <span class="text-xs text-amber-600 font-semibold tracking-wide flex items-center gap-1 whitespace-nowrap">
            <span>Kabupaten Jember</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu (Guaranteed Single Line / No Overlap) -->
      <ul id="desktop-nav" role="list" class="hidden xl:flex items-center gap-1.5 2xl:gap-3 list-none m-0 p-0 flex-nowrap shrink-0">
        {NAV_ITEMS.map((item) => {
          const hasChildren = item.children && item.children.length > 0;
          const active = isActive(item.href);

          return (
            <li class="relative group/nav py-2 shrink-0">
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                aria-haspopup={hasChildren ? 'true' : undefined}
                class={`whitespace-nowrap inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-semibold transition-all duration-200 shrink-0 select-none ${
                  active
                    ? 'text-blue-700 font-bold bg-blue-50/80 shadow-xs'
                    : 'text-slate-700 hover:text-blue-700 hover:bg-slate-100/80'
                }`}
              >
                <span>{item.label}</span>
                {hasChildren && (
                  <svg
                    class="w-3.5 h-3.5 opacity-60 group-hover/nav:opacity-100 group-hover/nav:rotate-180 transition-transform duration-200 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {/* Dropdown Menu */}
              {hasChildren && (
                <div class="absolute left-0 top-full pt-1.5 hidden group-hover/nav:block group-focus-within/nav:block z-50 min-w-[260px] animate-fadeIn">
                  <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-2 ring-1 ring-slate-900/5">
                    <div class="px-3 py-1.5 mb-1 border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                      {item.label} Menu
                    </div>
                    {item.children!.map((child) => (
                      <a
                        href={child.href}
                        class="block px-3 py-2.5 rounded-xl hover:bg-blue-50/80 transition-colors group/sub"
                      >
                        <div class="text-sm font-semibold text-slate-800 group-hover/sub:text-blue-700 flex items-center justify-between">
                          <span>{child.label}</span>
                          <span class="opacity-0 -translate-x-1 group-hover/sub:opacity-100 group-hover/sub:translate-x-0 transition-all text-blue-600 text-xs">→</span>
                        </div>
                        {child.description && (
                          <div class="text-xs text-slate-500 line-clamp-1 mt-0.5 font-normal">
                            {child.description}
                          </div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>

      <!-- CTA & Mobile Menu Toggle -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/admission"
          class="hidden sm:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-600 hover:from-blue-800 hover:to-indigo-700 shadow-md shadow-blue-700/20 hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all duration-200 whitespace-nowrap shrink-0"
        >
          <span>SPMB Online</span>
          <span>→</span>
        </a>

        <!-- Animated Mobile Hamburger Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          aria-label="Buka Menu Navigasi"
          class="xl:hidden w-11 h-11 rounded-xl text-slate-700 hover:text-blue-700 hover:bg-slate-100 border border-slate-200 flex flex-col items-center justify-center gap-1.5 transition-all duration-300 focus:outline-hidden focus:ring-2 focus:ring-blue-600 relative group"
        >
          <span id="bar-top" class="w-5 h-0.5 bg-slate-700 rounded-full transition-all duration-300 origin-center group-hover:bg-blue-700"></span>
          <span id="bar-mid" class="w-5 h-0.5 bg-slate-700 rounded-full transition-all duration-300 group-hover:bg-blue-700"></span>
          <span id="bar-bot" class="w-5 h-0.5 bg-slate-700 rounded-full transition-all duration-300 origin-center group-hover:bg-blue-700"></span>
        </button>
      </div>

    </div>
  </nav>

  <!-- Mobile Drawer with Smooth Slide & Fade Transition -->
  <div
    id="mobile-drawer"
    class="xl:hidden fixed inset-x-0 top-20 bg-white/98 backdrop-blur-xl border-b border-slate-200/90 shadow-2xl max-h-[calc(100vh-5rem)] overflow-y-auto invisible opacity-0 -translate-y-4 pointer-events-none transition-all duration-300 ease-out z-40"
  >
    <div class="px-4 sm:px-6 py-6 space-y-3">
      {NAV_ITEMS.map((item, idx) => {
        const hasChildren = item.children && item.children.length > 0;
        const active = isActive(item.href);

        if (!hasChildren) {
          return (
            <div class="mobile-nav-item" style={`--item-index: ${idx}`}>
              <a
                href={item.href}
                class={`flex items-center justify-between px-4 py-3.5 rounded-2xl text-base font-semibold transition-all duration-200 ${
                  active
                    ? 'bg-blue-50 text-blue-700 font-bold shadow-xs'
                    : 'text-slate-800 hover:bg-slate-50 hover:text-blue-700'
                }`}
              >
                <span>{item.label}</span>
                <span class="text-xs text-slate-400">→</span>
              </a>
            </div>
          );
        }

        return (
          <div class="mobile-nav-item" style={`--item-index: ${idx}`}>
            <details class="group/mobile rounded-2xl border border-slate-100 overflow-hidden bg-slate-50/70 transition-all duration-300 open:bg-white open:border-blue-200 open:shadow-md">
              <summary class="flex items-center justify-between px-4 py-3.5 text-base font-semibold text-slate-800 cursor-pointer list-none select-none hover:bg-slate-100/70 transition-colors">
                <span class={active ? 'text-blue-700 font-bold' : ''}>{item.label}</span>
                <div class="w-7 h-7 rounded-lg bg-slate-100 group-open/mobile:bg-blue-50 group-open/mobile:text-blue-700 flex items-center justify-center transition-colors">
                  <svg
                    class="w-4 h-4 text-slate-500 group-open/mobile:text-blue-700 group-open/mobile:rotate-180 transition-transform duration-300 ease-out"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </summary>
              
              <!-- Animated Submenu (CSS Grid Expand/Collapse) -->
              <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-open/mobile:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <div class="px-4 pb-4 pt-1 space-y-1 bg-white border-t border-slate-100 animate-submenuSlide">
                    <a
                      href={item.href}
                      class="flex items-center justify-between py-2 px-3 rounded-xl text-xs font-extrabold text-blue-700 bg-blue-50/80 uppercase tracking-wider hover:bg-blue-100 transition-colors my-1"
                    >
                      <span>Lihat Semua {item.label}</span>
                      <span>→</span>
                    </a>
                    {item.children!.map((child) => (
                      <a
                        href={child.href}
                        class="block py-2.5 px-3 rounded-xl text-sm font-medium text-slate-700 hover:text-blue-700 hover:bg-blue-50/50 hover:translate-x-1 transition-all duration-200 group/subitem"
                      >
                        <div class="flex items-center justify-between">
                          <span class="font-semibold">{child.label}</span>
                          <span class="text-blue-600 text-xs opacity-0 -translate-x-1 group-hover/subitem:opacity-100 group-hover/subitem:translate-x-0 transition-all">→</span>
                        </div>
                        {child.description && (
                          <div class="text-xs text-slate-500 font-normal mt-0.5 line-clamp-1">
                            {child.description}
                          </div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </details>
          </div>
        );
      })}

      <!-- Mobile CTA Buttons -->
      <div class="mobile-nav-item pt-4 border-t border-slate-200 flex flex-col gap-3" style={`--item-index: ${NAV_ITEMS.length}`}>
        <a
          href="/admission"
          class="w-full flex items-center justify-center gap-2 py-3.5 rounded-2xl font-bold text-white bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-600 hover:from-blue-800 hover:to-indigo-700 text-center shadow-lg shadow-blue-700/25 active:scale-95 transition-all"
        >
          <span>Pendaftaran Siswa Baru (SPMB Online)</span>
          <span>→</span>
        </a>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=Halo%20Admin%20SDK%20Maria%20Fatima%20Jember,%20saya%20ingin%20bertanya`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3.5 rounded-2xl font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 text-center text-sm transition-colors active:scale-95"
        >
          <span>💬 Hubungi Kami via WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fadeIn {
    animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes staggerItemIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes submenuFade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-submenuSlide {
    animation: submenuFade 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* When mobile drawer is open */
  #mobile-drawer.is-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #mobile-drawer.is-open .mobile-nav-item {
    animation: staggerItemIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--item-index, 0) * 60ms);
  }

  /* Hamburger transform to X */
  #mobile-menu-toggle.is-active #bar-top {
    transform: translateY(8px) rotate(45deg);
    background-color: #1d4ed8;
  }
  #mobile-menu-toggle.is-active #bar-mid {
    opacity: 0;
    transform: scale(0);
  }
  #mobile-menu-toggle.is-active #bar-bot {
    transform: translateY(-8px) rotate(-45deg);
    background-color: #1d4ed8;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  if (toggleBtn && drawer) {
    const openMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.classList.add('is-active');
      drawer.classList.add('is-open');
      document.body.classList.add('overflow-hidden', 'xl:overflow-auto');
    };

    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.classList.remove('is-active');
      drawer.classList.remove('is-open');
      document.body.classList.remove('overflow-hidden', 'xl:overflow-auto');
    };

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (
        !toggleBtn.contains(e.target as Node) &&
        !drawer.contains(e.target as Node) &&
        drawer.classList.contains('is-open')
      ) {
        closeMenu();
      }
    });

    // Close when Esc key is pressed
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeMenu();
      }
    });
  }
</script>
