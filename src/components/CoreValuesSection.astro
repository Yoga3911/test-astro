---
/**
 * CoreValuesSection.astro
 *
 * Dedicated section for Core Values (6 Nilai SIKARU):
 * - Spiritualitas, Integritas, Kasih, Adil, Respek, Unggul
 * - 6-grid responsive card layout with clean modern aesthetic
 */

import { VISI_MISI_DATA } from '@/utils/config';

const CORE_VALUE_ICONS: Record<string, { icon: string; color: string; bg: string }> = {
  Spiritualitas: { icon: '⛪', color: 'text-purple-700', bg: 'bg-purple-50 group-hover:bg-purple-100' },
  Integritas: { icon: '🛡️', color: 'text-blue-700', bg: 'bg-blue-50 group-hover:bg-blue-100' },
  Kasih: { icon: '❤️', color: 'text-rose-700', bg: 'bg-rose-50 group-hover:bg-rose-100' },
  Adil: { icon: '⚖️', color: 'text-emerald-700', bg: 'bg-emerald-50 group-hover:bg-emerald-100' },
  Respek: { icon: '🤝', color: 'text-amber-700', bg: 'bg-amber-50 group-hover:bg-amber-100' },
  Unggul: { icon: '🏆', color: 'text-indigo-700', bg: 'bg-indigo-50 group-hover:bg-indigo-100' },
};
---

<section id="core-values" class="py-14 sm:py-20 bg-slate-50 relative overflow-hidden border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase tracking-widest mb-3 border border-blue-200 shadow-xs">
        <span>OUR CORE VALUES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-heading font-black text-slate-900 tracking-tight">
        6 Nilai Utama: SIKARU
      </h2>
      <p class="text-slate-600 mt-3 text-base sm:text-lg">
        Fondasi karakter luhur yang ditanamkan secara konsisten dalam setiap aspek pembelajaran dan kehidupan berkomunitas.
      </p>
    </div>

    <!-- 6 Values Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 sm:gap-6">
      {VISI_MISI_DATA.coreValues.map((val) => {
        const key = val.title.split(' ')[0];
        const meta = CORE_VALUE_ICONS[key] || { icon: '💎', color: 'text-blue-700', bg: 'bg-blue-50' };

        return (
          <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class={`w-12 h-12 rounded-2xl ${meta.bg} flex items-center justify-center text-2xl mb-4 transition-colors`}>
                {meta.icon}
              </div>
              <h3 class="font-heading font-black text-base text-slate-900 mb-2 group-hover:text-blue-700 transition-colors">
                {val.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
                {val.desc}
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-slate-100 text-[11px] font-bold uppercase tracking-wider text-slate-400">
              SIKARU SPM
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
