---
/**
 * HeroVideo.astro
 *
 * Full-Bleed Grand Background Video Hero Banner:
 * - Edge-to-edge full width & height background video playing automatically with audio
 * - Grand centered typography (Ala SDH)
 * - Tagline: "Beyond Education, Touching Lives — Cerdas, Berkarakter, dan Berakar pada Spiritualitas Kasih"
 * - Quick actions: "Daftar PPDB 2026/2027" & "Jelajahi Profil Sekolah"
 * - Sleek Fullscreen button at top right
 * - Integrated school quick statistics counter strip at bottom
 */

import { SITE_CONFIG, STATS } from '@/utils/config';
---

<section id="hero-banner" class="relative overflow-hidden w-full min-h-[88vh] lg:min-h-[92vh] flex flex-col justify-between bg-slate-950 text-white">
  
  <!-- 1. FULL-WIDTH EDGE-TO-EDGE HD BACKGROUND VIDEO -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <video
      id="hero-bg-video"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster="/images/heritage/spm.svg"
      style="will-change: transform; transform: translateZ(0);"
      class="w-full h-full object-cover select-none brightness-95"
    >
      <source src="/videos/hero-profile.mp4" type="video/mp4" />
    </video>

    <!-- Cinematic Vignette Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/55 to-slate-950/35 z-10 pointer-events-none"></div>
  </div>

  <!-- 2. TOP RIGHT FLOATING FULLSCREEN BUTTON -->
  <!-- 2. SOUND ENABLE OVERLAY — shown until user clicks (browser autoplay policy) -->
  <div
    id="sound-overlay"
    class="absolute inset-0 z-40 flex items-center justify-center cursor-pointer"
    style="background: transparent;"
    title="Klik di mana saja untuk mengaktifkan suara"
  >
    <!-- Pulsing sound badge at center -->
    <div id="sound-badge" class="flex flex-col items-center gap-2 pointer-events-none select-none" style="animation: soundPulse 2s ease-in-out infinite;">
      <div class="w-16 h-16 rounded-full bg-white/15 backdrop-blur-md border-2 border-amber-400/60 flex items-center justify-center shadow-2xl">
        <span class="text-3xl">🔇</span>
      </div>
      <span class="text-white text-xs font-bold tracking-widest uppercase bg-slate-950/60 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/20">
        Klik untuk aktifkan suara
      </span>
    </div>
  </div>

  <!-- 2b. TOP RIGHT VIDEO CONTROLS (absolute pinned to corner) -->
  <div class="absolute z-50 top-4 right-4 sm:top-5 sm:right-5 flex items-center gap-2">
    <button
      id="toggle-sound-btn"
      type="button"
      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-950/70 hover:bg-slate-900 text-white backdrop-blur-md border border-white/20 hover:border-amber-400 text-xs font-bold transition-all shadow-xl hover:scale-105 active:scale-95 cursor-pointer select-none"
      title="Nyalakan/Matikan Suara"
    >
      <span id="sound-btn-icon" class="text-sm">🔇</span>
      <span id="sound-btn-label">Suara</span>
    </button>
    <button
      id="toggle-fullscreen-btn"
      type="button"
      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-950/70 hover:bg-slate-900 text-white backdrop-blur-md border border-white/20 hover:border-amber-400 text-xs font-bold transition-all shadow-xl hover:scale-105 active:scale-95 cursor-pointer select-none"
      title="Tonton Video Profil Layar Penuh"
    >
      <span class="text-sm">⛶</span>
      <span>Layar Penuh</span>
    </button>
  </div>

  <style>
    @keyframes soundPulse {
      0%, 100% { transform: scale(1); opacity: 0.9; }
      50% { transform: scale(1.08); opacity: 1; }
    }
    #sound-overlay.hidden-overlay {
      display: none !important;
    }
  </style>

  <!-- 3. HERO MAIN LEFT-ALIGNED FLOATING CONTENT -->
  <div class="relative z-20 w-full px-4 sm:px-6 lg:px-8 pt-10 pb-16 flex-1 flex flex-col justify-center items-start text-left max-w-2xl">
    
    <!-- Identity Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-extrabold tracking-wide uppercase mb-6 shadow-inner animate-fadeIn">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-400"></span>
      </span>
      <span>Sekolah Dasar Katolik Unggulan Jember</span>
    </div>

    <!-- Grand Headline -->
    <h1 id="hero-headline" class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-black tracking-tight leading-[1.1] text-white mb-2 drop-shadow-lg">
      <span id="welcome-to-text">WELCOME TO</span> <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-sky-300 to-blue-300 whitespace-nowrap">
        SDK MARIA FATIMA
      </span><br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-300 to-blue-300">
        JEMBER
      </span>
    </h1>

    <!-- Tagline matching width of WELCOME TO -->
    <p
      id="hero-tagline"
      class="text-white tracking-wider mb-10 drop-shadow-lg font-script font-normal transform -rotate-1 whitespace-nowrap"
      style="font-size: 2rem;"
    >
      Living values, creating digitally
    </p>

    <!-- Quick Action Button -->
    <div class="flex items-center">
      <a
        href="/admission"
        class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-heading font-black text-base text-slate-950 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-400 hover:from-amber-300 hover:to-amber-200 shadow-xl shadow-amber-500/25 hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span>Daftar PPDB 2026/2027</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

  </div>

  <!-- 4. STATS STRIP (Integrated Bottom Bar) -->
  <div class="relative z-20 border-t border-white/10 bg-slate-950/70 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {STATS.map((stat) => (
          <div class="flex flex-col items-center justify-center p-2 group">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-amber-300 flex items-center justify-center gap-1 drop-shadow-sm group-hover:scale-105 transition-transform duration-300">
              <span class="stat-counter" data-target={stat.value}>0</span>
              <span>{stat.suffix}</span>
            </div>
            <div class="text-xs sm:text-sm font-medium text-slate-300 mt-1 flex items-center gap-1.5">
              <span>{stat.icon}</span>
              <span>{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    // ─── Browser Autoplay Policy Note ────────────────────────────────────────
    // All modern browsers (Chrome, Safari, Firefox) block audio autoplay
    // without a prior user gesture. We cannot bypass this in JS.
    // Strategy: play muted immediately → show a clear "click to enable sound"
    // overlay → on first click anywhere, unmute + hide overlay instantly.

    let _heroInitDone = false;

    // ─── Auto-fit tagline width to match "WELCOME TO" ────────────────────────
    function fitTaglineWidth() {
      const welcomeEl = document.getElementById('welcome-to-text') as HTMLElement;
      const taglineEl = document.getElementById('hero-tagline')    as HTMLElement;
      if (!welcomeEl || !taglineEl) return;

      // Reset font-size so we can measure the natural width
      taglineEl.style.fontSize = '2rem';

      // Wait a frame for layout to settle
      requestAnimationFrame(() => {
        const targetWidth = welcomeEl.getBoundingClientRect().width;
        if (!targetWidth) return;

        const naturalWidth = taglineEl.scrollWidth;
        if (!naturalWidth) return;

        const currentSize = parseFloat(getComputedStyle(taglineEl).fontSize);
        const newSize     = currentSize * (targetWidth / naturalWidth);

        taglineEl.style.fontSize = `${newSize}px`;
      });
    }

    function initHeroVideo() {
      const video    = document.getElementById('hero-bg-video')    as HTMLVideoElement;
      const overlay  = document.getElementById('sound-overlay')    as HTMLElement;
      const icon     = document.getElementById('sound-btn-icon')   as HTMLElement;
      const label    = document.getElementById('sound-btn-label')  as HTMLElement;
      const soundBtn = document.getElementById('toggle-sound-btn') as HTMLButtonElement;

      if (!video) return;

      // Start muted (guaranteed autoplay across all browsers)
      video.muted = true;
      if (video.paused) video.play().catch(() => {});

      // ── Sound state helpers ───────────────────────────────────────────────
      const updateButtonUI = (isMuted: boolean) => {
        if (icon)  icon.innerText  = isMuted ? '🔇' : '🔊';
        if (label) label.innerText = isMuted ? 'Suara' : 'Suara';
      };

      const setMuted = (muted: boolean) => {
        video.muted = muted;
        video.volume = muted ? 0 : 1.0;
        updateButtonUI(muted);
        if (!muted && video.paused) {
          video.play().catch(() => {});
        }
      };

      const unlockAudio = () => {
        setMuted(false);
        if (overlay) overlay.classList.add('hidden-overlay');
      };

      // ── Only attach listeners once per page lifecycle ─────────────────────
      if (_heroInitDone) return;
      _heroInitDone = true;

      // Overlay tap/click to unlock audio
      if (overlay) {
        overlay.addEventListener('click', (e) => {
          e.stopPropagation();
          unlockAudio();
        });
      }

      // One-time gesture listener across the window for first touch/click
      const onFirstUserGesture = (e: Event) => {
        // If clicking/tapping the sound button or fullscreen button, let those buttons handle their own events
        const target = e.target as HTMLElement | null;
        if (target && target.closest('#toggle-sound-btn, #toggle-fullscreen-btn')) {
          return;
        }
        unlockAudio();
        window.removeEventListener('touchstart', onFirstUserGesture);
        window.removeEventListener('click', onFirstUserGesture);
      };
      window.addEventListener('touchstart', onFirstUserGesture, { passive: true });
      window.addEventListener('click', onFirstUserGesture, { passive: true });

      // Mute/unmute toggle button in top bar
      if (soundBtn) {
        soundBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          e.preventDefault();
          if (video.muted) {
            unlockAudio();
          } else {
            setMuted(true);
          }
        });
      }
    }

    function initFullscreen() {
      const video = document.getElementById('hero-bg-video') as HTMLVideoElement;
      const fsBtn = document.getElementById('toggle-fullscreen-btn') as HTMLButtonElement;
      if (!video || !fsBtn || (fsBtn as any)._fsAdded) return;
      (fsBtn as any)._fsAdded = true;

      const isFullscreenActive = () => {
        return !!(
          document.fullscreenElement ||
          (document as any).webkitFullscreenElement ||
          (document as any).mozFullScreenElement ||
          (document as any).msFullscreenElement ||
          (video as any).webkitDisplayingFullscreen
        );
      };

      const enterFullscreen = () => {
        // Unmute and ensure video is playing when entering fullscreen
        video.muted = false;
        video.volume = 1.0;
        const icon = document.getElementById('sound-btn-icon');
        if (icon) icon.innerText = '🔊';
        const overlay = document.getElementById('sound-overlay');
        if (overlay) overlay.classList.add('hidden-overlay');

        if (video.paused) {
          video.play().catch(() => {});
        }

        // iOS Safari on iPhone requires webkitEnterFullscreen directly on HTMLVideoElement
        if (typeof (video as any).webkitEnterFullscreen === 'function') {
          (video as any).webkitEnterFullscreen();
        } else if (typeof (video as any).webkitEnterFullScreen === 'function') {
          (video as any).webkitEnterFullScreen();
        } else if (typeof video.requestFullscreen === 'function') {
          video.requestFullscreen().catch(() => {});
        } else if (typeof (video as any).webkitRequestFullscreen === 'function') {
          (video as any).webkitRequestFullscreen();
        } else if (typeof (video as any).mozRequestFullScreen === 'function') {
          (video as any).mozRequestFullScreen();
        } else if (typeof (video as any).msRequestFullscreen === 'function') {
          (video as any).msRequestFullscreen();
        }
      };

      const exitFullscreen = () => {
        if (typeof (video as any).webkitExitFullscreen === 'function') {
          (video as any).webkitExitFullscreen();
        } else if (typeof document.exitFullscreen === 'function') {
          document.exitFullscreen().catch(() => {});
        } else if (typeof (document as any).webkitExitFullscreen === 'function') {
          (document as any).webkitExitFullscreen();
        } else if (typeof (document as any).mozCancelFullScreen === 'function') {
          (document as any).mozCancelFullScreen();
        } else if (typeof (document as any).msExitFullscreen === 'function') {
          (document as any).msExitFullscreen();
        }
      };

      fsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();

        if (!isFullscreenActive()) {
          enterFullscreen();
        } else {
          exitFullscreen();
        }
      });
    }

    function initCounters() {
      const counters = document.querySelectorAll('.stat-counter');
      if (!counters.length) return;

      const animate = (el: HTMLElement) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        if (isNaN(target) || target <= 0) return;
        const duration = 1800;
        const startTime = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - startTime) / duration, 1);
          el.innerText = Math.floor((1 - Math.pow(1 - p, 3)) * target).toString();
          if (p < 1) requestAnimationFrame(tick);
          else el.innerText = target.toString();
        };
        requestAnimationFrame(tick);
      };

      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { animate(e.target as HTMLElement); obs.unobserve(e.target); }
        });
      }, { threshold: 0.1 });

      counters.forEach((c) => obs.observe(c));
    }

    function initAll() {
      initHeroVideo();
      initFullscreen();
      initCounters();
      // Fit tagline after fonts are likely loaded (small delay for Google Fonts)
      fitTaglineWidth();
      setTimeout(fitTaglineWidth, 600); // re-run after Homemade Apple font finishes loading
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('astro:page-load', () => {
      _heroInitDone = false;
      initAll();
    });

    // Re-fit on window resize (e.g. rotating phone, resizing desktop)
    let _resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(_resizeTimer);
      _resizeTimer = setTimeout(fitTaglineWidth, 120);
    }, { passive: true });
  </script>

</section>
