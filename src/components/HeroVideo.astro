---
/**
 * HeroVideo.astro
 *
 * Immersive Bright Light Hero Banner inspired by sdh.sch.id:
 * - Luminous white & soft blue ambient gradient background
 * - Grand clear typography: "WELCOME TO SDK MARIA FATIMA JEMBER"
 * - Tagline: "Beyond Education, Touching Lives — Cerdas, Berkarakter, dan Berakar pada Spiritualitas Kasih"
 * - Quick actions: "Daftar PPDB Online" & "Tonton Video Profil"
 * - Integrated school quick statistics strip
 */

import { SITE_CONFIG, STATS } from '@/utils/config';
---

<section id="hero-banner" class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-slate-50 text-slate-900 min-h-[80vh] lg:min-h-[85vh] flex flex-col justify-between border-b border-slate-200/80">
  <!-- Dynamic Ambient Soft Lighting -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-200/50 rounded-full blur-3xl"></div>
    <div class="absolute top-1/4 -right-32 w-96 h-96 bg-amber-100/60 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 left-1/3 w-[500px] h-[500px] bg-sky-100/50 rounded-full blur-3xl"></div>

    <!-- Soft grid pattern overlay -->
    <div class="absolute inset-0 opacity-40">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <pattern id="school-grid-light" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(37, 99, 235, 0.05)" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#school-grid-light)" />
      </svg>
    </div>
  </div>

  <!-- Hero Main Content -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 pb-12 flex-1 flex flex-col justify-center items-center text-center">
    
    <!-- Foundation Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-100 text-blue-800 text-xs sm:text-sm font-extrabold tracking-wide uppercase mb-6 border border-blue-200 shadow-xs animate-fadeIn">
      <span class="w-2 h-2 rounded-full bg-blue-600 animate-ping"></span>
      <span>YAYASAN SUSTER SPM PROBOLINGGO • JEMBER</span>
    </div>

    <!-- Grand Headline (Ala SDH) -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-black tracking-tight leading-[1.1] max-w-5xl text-slate-900 mb-6">
      WELCOME TO <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-700">
        SDK MARIA FATIMA
      </span>
      <span class="block text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-700 mt-2 font-body">
        JEMBER
      </span>
    </h1>

    <!-- Tagline & Description -->
    <p class="text-base sm:text-lg md:text-xl text-slate-600 max-w-3xl leading-relaxed mb-10 font-normal">
      <strong class="text-slate-900 font-bold">Educating in the Spirit of St. Julie & SPM:</strong> Beyond Education, Touching Lives. Membentuk tunas muda yang cerdas, berkarakter luhur, berprestasi, dan berakar pada spiritualitas kasih.
    </p>

    <!-- CTAs & Video Modal Trigger -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto justify-center">
      <a
        href="/admission"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-bold text-base text-white bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-600 hover:from-blue-800 hover:to-indigo-700 shadow-lg shadow-blue-700/25 hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span>Daftar PPDB 2026/2027</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <button
        type="button"
        id="open-video-modal"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 rounded-2xl font-bold text-base text-slate-800 bg-white hover:bg-slate-50 border border-slate-200/90 shadow-sm hover:shadow-md hover:scale-105 active:scale-95 transition-all duration-200 group cursor-pointer"
      >
        <div class="w-8 h-8 rounded-full bg-blue-100 group-hover:bg-blue-200 text-blue-700 flex items-center justify-center shadow-xs transition-colors">
          <svg class="w-4 h-4 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <span>Video Profil Sekolah</span>
      </button>

      <a
        href="/about-us"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl font-bold text-sm text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 transition-colors"
      >
        <span>Jelajahi Profil Sekolah</span>
        <span>→</span>
      </a>
    </div>

  </div>

  <!-- Stats Strip (Integrated Bottom Bar in White Theme) -->
  <div class="relative z-20 border-t border-slate-200/80 bg-white/90 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {STATS.map((stat) => (
          <div class="flex flex-col items-center justify-center p-2">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-blue-700 flex items-center gap-1">
              <span>{stat.value}</span>
              <span>{stat.suffix}</span>
            </div>
            <div class="text-xs sm:text-sm font-semibold text-slate-600 mt-1 flex items-center gap-1.5">
              <span>{stat.icon}</span>
              <span>{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Video Modal -->
  <div
    id="video-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-md hidden p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Video Profil SDK Maria Fatima Jember"
  >
    <div class="relative w-full max-w-4xl bg-slate-900 rounded-3xl overflow-hidden shadow-2xl border border-slate-700">
      <div class="flex items-center justify-between p-4 bg-slate-800/80 border-b border-slate-700">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500"></span>
          <span class="w-3 h-3 rounded-full bg-green-500"></span>
          <span class="text-sm font-bold text-slate-200 ml-2">Video Profil SDK Maria Fatima Jember</span>
        </div>
        <button
          id="close-video-modal"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-700 transition-colors"
          aria-label="Tutup Video"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <!-- Video Container -->
      <div class="aspect-video w-full bg-black relative flex items-center justify-center">
        <iframe
          id="video-iframe"
          class="w-full h-full"
          src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?enablejsapi=1"
          title="Video Profil SDK Maria Fatima Jember"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const openBtn = document.getElementById('open-video-modal');
  const closeBtn = document.getElementById('close-video-modal');
  const modal = document.getElementById('video-modal');
  const iframe = document.getElementById('video-iframe') as HTMLIFrameElement | null;

  if (openBtn && closeBtn && modal) {
    openBtn.addEventListener('click', () => {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      if (iframe) {
        const src = iframe.src;
        iframe.src = src;
      }
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
</script>
