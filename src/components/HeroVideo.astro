---
/**
 * HeroVideo.astro
 *
 * Full-Bleed Background Video Hero Banner inspired by sdh.sch.id:
 * - Edge-to-edge full width & height background video playing automatically
 * - Grand typography: "WELCOME TO SDK MARIA FATIMA JEMBER"
 * - Tagline: "Beyond Education, Touching Lives — Cerdas, Berkarakter, dan Berakar pada Spiritualitas Kasih"
 * - Quick actions: "Daftar PPDB 2026/2027" & "Jelajahi Profil Sekolah"
 * - Integrated school quick statistics strip at bottom
 */

import { SITE_CONFIG, STATS } from '@/utils/config';
---

<section id="hero-banner" class="relative overflow-hidden w-full min-h-[85vh] lg:min-h-[90vh] flex flex-col justify-between bg-slate-950 text-white">
  
  <!-- 1. FULL-WIDTH EDGE-TO-EDGE BACKGROUND VIDEO (SEAMLESS AUTOPLAY - NO CONTROLS) -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-0">
    
    <!-- Scaled video wrapper to hide any player UI and fit edge-to-edge -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[130vw] h-[73.125vw] min-h-[130vh] min-w-[231.11vh] pointer-events-none overflow-hidden select-none">
      <iframe
        id="hero-yt-player"
        class="w-full h-full object-cover pointer-events-none scale-110"
        src="https://www.youtube-nocookie.com/embed/n42s_hI72v4?autoplay=1&mute=1&controls=0&loop=1&playlist=n42s_hI72v4&playsinline=1&enablejsapi=1&rel=0&iv_load_policy=3&disablekb=1&modestbranding=1&fs=0&autohide=1"
        title="Background Video Profil SDK Maria Fatima"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        tabindex="-1"
        style="border: 0; pointer-events: none;"
      ></iframe>
    </div>

    <!-- Cinematic Vignette / Glass Gradient Overlay (Blocks All Iframe UI & Guarantees High Contrast) -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-slate-950/40 z-10 pointer-events-none"></div>
    <div class="absolute inset-0 bg-blue-950/30 mix-blend-multiply z-10 pointer-events-none"></div>

    <!-- Ambient Glowing Orbs -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/30 rounded-full blur-3xl z-10 pointer-events-none animate-pulse"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl z-10 pointer-events-none"></div>
  </div>

  <!-- 2. HERO MAIN FLOATING CONTENT -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 flex-1 flex flex-col justify-center items-center text-center">
    
    <!-- Foundation Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-amber-300 text-xs sm:text-sm font-extrabold tracking-wide uppercase mb-6 shadow-inner animate-fadeIn">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
      <span>SDK MARIA FATIMA • KABUPATEN JEMBER</span>
    </div>

    <!-- Grand Headline (Ala SDH) -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-black tracking-tight leading-[1.1] max-w-5xl text-white mb-6 drop-shadow-lg">
      WELCOME TO <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-sky-300 to-blue-300">
        SDK MARIA FATIMA
      </span>
      <span class="block text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-200 mt-2 font-body">
        JEMBER
      </span>
    </h1>

    <!-- Tagline & Description -->
    <p class="text-base sm:text-xl text-slate-200 max-w-3xl leading-relaxed mb-10 font-normal drop-shadow-md">
      <strong class="text-white font-semibold">Educating in the Spirit of St. Julie & SPM:</strong> Beyond Education, Touching Lives. Membentuk tunas muda yang cerdas, berkarakter luhur, berprestasi, dan berakar pada spiritualitas kasih.
    </p>

    <!-- Quick Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto justify-center">
      <a
        href="/admission"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-heading font-black text-base text-slate-950 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-400 hover:from-amber-300 hover:to-amber-200 shadow-xl shadow-amber-500/25 hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span>Daftar PPDB 2026/2027</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <a
        href="/about-us"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl font-bold text-base text-white bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 hover:border-white/40 shadow-md hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span>Jelajahi Profil Sekolah</span>
        <span>→</span>
      </a>
    </div>

  </div>

  <!-- 3. STATS STRIP (Integrated Bottom Bar ala SDH) -->
  <div class="relative z-20 border-t border-white/10 bg-slate-950/70 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {STATS.map((stat) => (
          <div class="flex flex-col items-center justify-center p-2 group">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-amber-300 flex items-center justify-center gap-1 drop-shadow-sm group-hover:scale-105 transition-transform duration-300">
              <span class="stat-counter" data-target={stat.value}>0</span>
              <span>{stat.suffix}</span>
            </div>
            <div class="text-xs sm:text-sm font-medium text-slate-300 mt-1 flex items-center gap-1.5">
              <span>{stat.icon}</span>
              <span>{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    function initHeroVideo() {
      const iframe = document.getElementById('hero-yt-player') as HTMLIFrameElement;
      if (!iframe) return;

      const triggerPlay = () => {
        try {
          iframe.contentWindow?.postMessage('{"event":"command","func":"mute","args":""}', '*');
          iframe.contentWindow?.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
        } catch (_) {}
      };

      iframe.addEventListener('load', triggerPlay);
      setTimeout(triggerPlay, 1000);
      setTimeout(triggerPlay, 2500);
    }

    function initCounters() {
      const counters = document.querySelectorAll('.stat-counter');
      if (!counters.length) return;

      const animate = (el: HTMLElement) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        if (isNaN(target) || target <= 0) return;

        const duration = 1800; // 1.8 detik animasi menghitung naik
        const startTime = performance.now();

        const updateCount = (currentTime: number) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease-out cubic: cepat di awal lalu melambat anggun
          const easeOut = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(easeOut * target);
          el.innerText = current.toString();

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            el.innerText = target.toString();
          }
        };

        requestAnimationFrame(updateCount);
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      counters.forEach((c) => observer.observe(c));
    }

    function initAll() {
      initHeroVideo();
      initCounters();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('astro:page-load', initAll);
  </script>

</section>
