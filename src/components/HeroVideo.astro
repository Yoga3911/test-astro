---
/**
 * HeroVideo.astro
 *
 * Immersive Bright Light Hero Banner inspired by sdh.sch.id:
 * - School profile video playing directly on page load (Autoplay, Loop, Muted for browser policy)
 * - Grand clear typography: "WELCOME TO SDK MARIA FATIMA JEMBER"
 * - Tagline: "Beyond Education, Touching Lives — Cerdas, Berkarakter, dan Berakar pada Spiritualitas Kasih"
 * - Quick actions: "Daftar PPDB Online" & Audio Control
 * - Integrated school quick statistics strip
 */

import { SITE_CONFIG, STATS } from '@/utils/config';
---

<section id="hero-banner" class="relative overflow-hidden bg-gradient-to-b from-blue-50/70 via-white to-slate-50 text-slate-900 border-b border-slate-200/80">
  
  <!-- Ambient Lighting Accents -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-200/50 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-amber-100/60 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 left-1/3 w-[500px] h-[500px] bg-sky-100/50 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 pb-12">
    
    <!-- Top Hero Header: Foundation Badge & Grand Headline -->
    <div class="text-center max-w-4xl mx-auto mb-8 sm:mb-12 space-y-4">
      
      <!-- Foundation Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-100 text-blue-800 text-xs sm:text-sm font-extrabold tracking-wide uppercase border border-blue-200 shadow-xs animate-fadeIn">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-ping"></span>
        <span>YAYASAN SUSTER SPM PROBOLINGGO • JEMBER</span>
      </div>

      <!-- Grand Headline (Ala SDH) -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-black tracking-tight leading-[1.15] text-slate-900">
        WELCOME TO <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-700">
          SDK MARIA FATIMA
        </span>
        <span class="block text-xl sm:text-3xl font-extrabold text-slate-700 mt-1 font-body">
          JEMBER
        </span>
      </h1>

      <!-- Tagline & Description -->
      <p class="text-sm sm:text-base md:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed font-normal">
        <strong class="text-slate-900 font-bold">Educating in the Spirit of St. Julie & SPM:</strong> Beyond Education, Touching Lives. Membentuk tunas muda yang cerdas, berkarakter luhur, berprestasi, dan berakar pada spiritualitas kasih.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
        <a
          href="/admission"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-2xl font-heading font-black text-sm sm:text-base text-white bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-600 hover:from-blue-800 hover:to-indigo-700 shadow-lg shadow-blue-700/25 hover:scale-105 active:scale-95 transition-all duration-200"
        >
          <span>Daftar PPDB 2026/2027</span>
          <span>→</span>
        </a>

        <a
          href="/about-us"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl font-bold text-sm text-slate-700 hover:text-blue-700 bg-white hover:bg-slate-50 border border-slate-200/90 shadow-xs transition-colors"
        >
          <span>Jelajahi Profil Sekolah</span>
        </a>
      </div>

    </div>

    <!-- DIRECT AUTOPLAYING VIDEO PROFILE EMBED (ALA SDH) -->
    <div class="max-w-5xl mx-auto">
      <div class="bg-white rounded-3xl p-3 sm:p-5 border-2 border-blue-200/80 shadow-2xl relative overflow-hidden group">
        
        <!-- Video Header Bar -->
        <div class="flex items-center justify-between px-3 py-2 mb-3 bg-slate-50 rounded-2xl border border-slate-200/80 text-xs text-slate-600 font-bold">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
            <span class="text-blue-900 font-extrabold uppercase tracking-wider">VIDEO PROFIL RESMI SDK MARIA FATIMA</span>
          </div>
          <div class="flex items-center gap-3 text-[11px] font-semibold text-slate-500">
            <span>🔴 SEDANG MEMUTAR</span>
          </div>
        </div>

        <!-- Video Player Frame with Direct Autoplay -->
        <div class="relative aspect-video w-full rounded-2xl overflow-hidden bg-slate-900 shadow-inner">
          <iframe
            id="hero-profile-video"
            class="w-full h-full object-cover"
            src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1&mute=1&loop=1&playlist=dQw4w9WgXcQ&controls=1&rel=0&modestbranding=1&playsinline=1"
            title="Video Profil SDK Maria Fatima Jember"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <!-- Bottom Video Caption & Helper -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-3 pt-3 text-xs text-slate-500">
          <p class="text-center sm:text-left">
            💡 <em>Video profil sekolah diputar otomatis (mode hening). Klik ikon suara pada pemutar YouTube untuk mengaktifkan audio.</em>
          </p>
          <a
            href="/media"
            class="shrink-0 text-blue-700 hover:text-blue-900 font-bold hover:underline"
          >
            Lihat Koleksi Media &amp; Video Lainnya →
          </a>
        </div>

      </div>
    </div>

  </div>

  <!-- Stats Strip (Integrated Bottom Bar in White Theme) -->
  <div class="relative z-20 border-t border-slate-200/80 bg-white/90 backdrop-blur-md mt-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {STATS.map((stat) => (
          <div class="flex flex-col items-center justify-center p-2">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-blue-700 flex items-center gap-1">
              <span>{stat.value}</span>
              <span>{stat.suffix}</span>
            </div>
            <div class="text-xs sm:text-sm font-semibold text-slate-600 mt-1 flex items-center gap-1.5">
              <span>{stat.icon}</span>
              <span>{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>
