---
/**
 * HeroVideo.astro
 *
 * Full-Bleed Grand Background Video Hero Banner:
 * - Edge-to-edge full width & height background video playing automatically with audio
 * - Grand centered typography (Ala SDH)
 * - Tagline: "Beyond Education, Touching Lives — Cerdas, Berkarakter, dan Berakar pada Spiritualitas Kasih"
 * - Quick actions: "Daftar PPDB 2026/2027" & "Jelajahi Profil Sekolah"
 * - Sleek Fullscreen button at top right
 * - Integrated school quick statistics counter strip at bottom
 */

import { SITE_CONFIG, STATS } from '@/utils/config';
---

<section id="hero-banner" class="relative overflow-hidden w-full min-h-[88vh] lg:min-h-[92vh] flex flex-col justify-between bg-slate-950 text-white">
  
  <!-- 1. FULL-WIDTH EDGE-TO-EDGE HD BACKGROUND VIDEO -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none z-0">
    <video
      id="hero-bg-video"
      autoplay
      loop
      muted
      playsinline
      poster="/images/heritage/spm.svg"
      class="w-full h-full object-cover select-none filter brightness-95 scale-100"
    >
      <source src="/videos/hero-profile.mp4" type="video/mp4" />
    </video>

    <!-- Cinematic Vignette Overlay (Perfect Text Legibility) -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-slate-950/40 z-10 pointer-events-none"></div>
    <div class="absolute inset-0 bg-blue-950/25 mix-blend-multiply z-10 pointer-events-none"></div>

    <!-- Ambient Glowing Orbs -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/30 rounded-full blur-3xl z-10 pointer-events-none animate-pulse"></div>
    <div class="absolute top-1/3 -right-32 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl z-10 pointer-events-none"></div>
  </div>

  <!-- 2. TOP RIGHT FLOATING FULLSCREEN BUTTON -->
  <div class="relative z-30 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-24 flex justify-end items-center">
    <button
      id="toggle-fullscreen-btn"
      type="button"
      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-950/70 hover:bg-slate-900 text-white backdrop-blur-md border border-white/20 hover:border-amber-400 text-xs font-bold transition-all shadow-xl hover:scale-105 active:scale-95 cursor-pointer"
      title="Tonton Video Profil Layar Penuh"
    >
      <span class="text-sm">⛶</span>
      <span>Layar Penuh</span>
    </button>
  </div>

  <!-- 3. HERO MAIN CENTERED FLOATING CONTENT (GRAND ALA SDH) -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-16 flex-1 flex flex-col justify-center items-center text-center">
    
    <!-- Foundation Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-amber-300 text-xs sm:text-sm font-extrabold tracking-wide uppercase mb-6 shadow-inner animate-fadeIn">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
      <span>SDK MARIA FATIMA • KABUPATEN JEMBER</span>
    </div>

    <!-- Grand Headline (Ala SDH) -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-black tracking-tight leading-[1.1] max-w-5xl text-white mb-4 drop-shadow-lg">
      WELCOME TO <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-sky-300 to-blue-300">
        SDK MARIA FATIMA JEMBER
      </span>
    </h1>

    <!-- Tagline & Description with Homemade Apple font -->
    <p class="text-xl sm:text-3xl md:text-4xl text-amber-300 tracking-wider mb-10 drop-shadow-lg font-script font-normal transform -rotate-1">
      Living values, creating digitally
    </p>

    <!-- Quick Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto justify-center">
      <a
        href="/admission"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-heading font-black text-base text-slate-950 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-400 hover:from-amber-300 hover:to-amber-200 shadow-xl shadow-amber-500/25 hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span>Daftar PPDB 2026/2027</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <a
        href="/about-us"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl font-bold text-base text-white bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 hover:border-white/40 shadow-md hover:scale-105 active:scale-95 transition-all duration-200"
      >
        <span>Jelajahi Profil Sekolah</span>
        <span>→</span>
      </a>
    </div>

  </div>

  <!-- 4. STATS STRIP (Integrated Bottom Bar) -->
  <div class="relative z-20 border-t border-white/10 bg-slate-950/70 backdrop-blur-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {STATS.map((stat) => (
          <div class="flex flex-col items-center justify-center p-2 group">
            <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-amber-300 flex items-center justify-center gap-1 drop-shadow-sm group-hover:scale-105 transition-transform duration-300">
              <span class="stat-counter" data-target={stat.value}>0</span>
              <span>{stat.suffix}</span>
            </div>
            <div class="text-xs sm:text-sm font-medium text-slate-300 mt-1 flex items-center gap-1.5">
              <span>{stat.icon}</span>
              <span>{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script>
    // Guarantee 100% autoplay on page load + instant sound unlock on user interaction
    function initHeroVideo() {
      const video = document.getElementById('hero-bg-video') as HTMLVideoElement;
      if (!video) return;

      // Start playing immediately (muted is required by browser security for autoplay)
      video.muted = true;
      video.defaultMuted = true;
      video.play().catch(() => {});

      let hasUnmuted = false;
      const enableSound = () => {
        if (hasUnmuted) return;
        hasUnmuted = true;
        video.muted = false;
        video.volume = 1.0;
        video.play().catch(() => {});
      };

      // Unmute instantly on ANY interaction (tap, click, scroll, hover, touch)
      const interactionEvents = [
        'click',
        'touchstart',
        'touchend',
        'pointerdown',
        'pointerup',
        'scroll',
        'wheel',
        'keydown',
        'mousemove'
      ];

      interactionEvents.forEach((eventName) => {
        window.addEventListener(eventName, enableSound, { once: true, passive: true });
        document.addEventListener(eventName, enableSound, { once: true, passive: true });
      });
    }

    function initFullscreen() {
      const video = document.getElementById('hero-bg-video') as HTMLVideoElement;
      const fsBtn = document.getElementById('toggle-fullscreen-btn');

      if (video && fsBtn) {
        fsBtn.addEventListener('click', () => {
          video.muted = false;
          video.volume = 1.0;
          video.play().catch(() => {});
          if (!document.fullscreenElement) {
            video.requestFullscreen?.().catch(() => {});
          } else {
            document.exitFullscreen?.().catch(() => {});
          }
        });
      }
    }

    function initCounters() {
      const counters = document.querySelectorAll('.stat-counter');
      if (!counters.length) return;

      const animate = (el: HTMLElement) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        if (isNaN(target) || target <= 0) return;

        const duration = 1800;
        const startTime = performance.now();

        const updateCount = (currentTime: number) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeOut = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(easeOut * target);
          el.innerText = current.toString();

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            el.innerText = target.toString();
          }
        };

        requestAnimationFrame(updateCount);
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      counters.forEach((c) => observer.observe(c));
    }

    function initAll() {
      initHeroVideo();
      initFullscreen();
      initCounters();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('astro:page-load', initAll);
  </script>

</section>
