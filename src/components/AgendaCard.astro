---
/**
 * AgendaCard.astro
 *
 * Single Responsibility: Renders a single agenda/event card.
 * Supports 'grid' and 'timeline' layouts.
 */

import { formatDate, getAgendaStatusBadge } from '@/utils/config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  agenda:  CollectionEntry<'agenda'>;
  index?:  number;
  layout?: 'timeline' | 'grid';
}

const { agenda, index = 0, layout = 'grid' } = Astro.props;
const { judul, tanggal, tanggalAkhir, lokasi, deskripsi, waktu, status, kategori } = agenda.data;

const badge    = getAgendaStatusBadge(status);
const isEven   = index % 2 === 0;
const isTimeline = layout === 'timeline';
---

{isTimeline && (
  <div style="display: grid; grid-template-columns: 1fr 40px 1fr; align-items: start; gap: 0; position: relative;" class="timeline-row">
    <div style={`padding: 0 2rem 2.5rem 0; ${!isEven ? 'visibility:hidden;' : ''}`}>
      {isEven && (
        <div class="card" style="padding: 1.5rem; background: #ffffff; border: 1px solid #e2e8f0;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <span class={`badge ${badge.class}`}>{badge.label}</span>
            <span class="badge" style="background: #f1f5f9; color: #64748b; font-size: 0.7rem; border: 1px solid #e2e8f0;">{kategori}</span>
          </div>
          <h3 style="font-size: 1.05rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">{judul}</h3>
          <p style="font-size: 0.85rem; color: #475569; margin-bottom: 0.875rem; line-height: 1.6;" class="line-clamp-2">{deskripsi}</p>
          <div style="display: flex; flex-direction: column; gap: 0.35rem; border-top: 1px solid #f1f5f9; padding-top: 0.75rem;">
            <div style="font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>{formatDate(tanggal)}{tanggalAkhir ? ` — ${formatDate(tanggalAkhir)}` : ''}</span>
            </div>
            {waktu && (
              <div style="font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>{waktu}</span>
              </div>
            )}
            <div style="font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{lokasi}</span>
            </div>
          </div>
        </div>
      )}
    </div>

    <div style="display: flex; flex-direction: column; align-items: center;">
      <div style="width: 16px; height: 16px; background: #2563eb; border-radius: 50%; box-shadow: 0 0 0 4px #eff6ff; flex-shrink: 0; z-index: 1; position: relative; margin-top: 12px;"></div>
      <div style="width: 2px; flex: 1; background: #e2e8f0; margin-top: 0.5rem; min-height: 40px;"></div>
    </div>

    <div style={`padding: 0 0 2.5rem 2rem; ${isEven ? 'visibility:hidden;' : ''}`}>
      {!isEven && (
        <div class="card" style="padding: 1.5rem; background: #ffffff; border: 1px solid #e2e8f0;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <span class={`badge ${badge.class}`}>{badge.label}</span>
            <span class="badge" style="background: #f1f5f9; color: #64748b; font-size: 0.7rem; border: 1px solid #e2e8f0;">{kategori}</span>
          </div>
          <h3 style="font-size: 1.05rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">{judul}</h3>
          <p style="font-size: 0.85rem; color: #475569; margin-bottom: 0.875rem; line-height: 1.6;" class="line-clamp-2">{deskripsi}</p>
          <div style="display: flex; flex-direction: column; gap: 0.35rem; border-top: 1px solid #f1f5f9; padding-top: 0.75rem;">
            <div style="font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>{formatDate(tanggal)}{tanggalAkhir ? ` — ${formatDate(tanggalAkhir)}` : ''}</span>
            </div>
            {waktu && (
              <div style="font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>{waktu}</span>
              </div>
            )}
            <div style="font-size: 0.8rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{lokasi}</span>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
)}

{!isTimeline && (
  <div class="card" style="padding: 1.5rem; height: 100%; display: flex; flex-direction: column; background: #ffffff; border: 1px solid #e2e8f0;">
    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; margin-bottom: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.625rem;">
        <div style="width: 42px; height: 42px; background: #eff6ff; border: 1px solid #dbeafe; border-radius: 0.625rem; display: flex; align-items: center; justify-content: center; color: #2563eb; flex-shrink: 0;">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <span class={`badge ${badge.class}`} style="margin-bottom: 0.25rem; display: inline-block;">{badge.label}</span>
          <div style="font-size: 0.75rem; color: #64748b; font-weight: 500;">{kategori}</div>
        </div>
      </div>
      <div style="text-align: center; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 0.5rem; padding: 0.375rem 0.625rem; flex-shrink: 0;">
        <div style="font-size: 1.25rem; font-weight: 800; color: #1d4ed8; line-height: 1; font-family: var(--font-heading);">{tanggal.getDate()}</div>
        <div style="font-size: 0.65rem; color: #2563eb; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">{tanggal.toLocaleString('id-ID', { month: 'short' })}</div>
      </div>
    </div>

    <h3 style="font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem; line-height: 1.35;">{judul}</h3>
    <p style="font-size: 0.85rem; color: #475569; line-height: 1.6; flex: 1; margin-bottom: 1rem;" class="line-clamp-3">{deskripsi}</p>

    <div style="display: flex; flex-direction: column; gap: 0.3rem; border-top: 1px solid #f1f5f9; padding-top: 0.875rem;">
      {waktu && (
        <div style="font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {waktu}
        </div>
      )}
      <div style="font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem;">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        {lokasi}
      </div>
    </div>
  </div>
)}

