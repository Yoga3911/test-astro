---
/**
 * TaglineSection.astro
 *
 * Dedicated section for Tagline & Spiritualitas:
 * - "Beyond Education, Touching Lives — Educating in the Spirit of St. Julie & SPM"
 * - Clean bright banner layout with call to action
 */

import { VISI_MISI_DATA } from '@/utils/config';
---

<section id="tagline-spirituality" class="pt-6 pb-16 sm:pb-24 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="bg-white rounded-3xl p-8 sm:p-12 md:p-14 border-2 border-blue-600 shadow-xl hover:shadow-2xl hover:border-blue-700 transition-all duration-300 text-center space-y-6 relative overflow-hidden">
      <!-- Decorative ambient glows -->
      <div class="absolute -top-20 -right-20 w-72 h-72 bg-blue-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>
      <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-amber-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-800 text-xs font-extrabold uppercase tracking-widest border border-blue-200 shadow-xs">
        <span>OUR MOTTO &amp; IDENTITY</span>
      </div>
      
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-black text-slate-900 leading-tight">
        "{VISI_MISI_DATA.tagline}"
      </h2>

      <p class="text-slate-600 text-sm sm:text-base md:text-lg max-w-2xl mx-auto font-normal leading-relaxed">
        <strong class="text-slate-900 font-semibold">"Ah, betapa baiknya Allah yang Mahabaik!"</strong> — Bersama teladan kasih Bunda Maria dan Santa Julie Billiart, kami mendedikasikan seluruh daya untuk menyentuh hati dan mencerdaskan budi tunas bangsa di Kabupaten Jember.
      </p>

    </div>

  </div>
</section>
