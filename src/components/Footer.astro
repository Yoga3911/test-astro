---
/**
 * Footer.astro
 *
 * Dedicated Footer for SDK Maria Fatima Jember:
 * - HO (Head Office Yayasan SPM Alamat)
 * - Alamat SDK Maria Fatima Jember
 * - Contact Us (Telepon, WhatsApp, Email, Jam Kerja)
 * - Icon Medsos (Center aligned with authentic brand SVG icons)
 * - Bottom Copyright (Clean centered text without Tata Tertib / SPMB / Mars & Jingle)
 */

import { SITE_CONFIG } from "@/utils/config";

const currentYear = new Date().getFullYear();
---

<footer
  class="bg-slate-50 text-slate-600 pt-14 pb-12 border-t border-slate-200/90"
  role="contentinfo"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Identity Strip -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-10 border-b border-slate-200/80"
    >
      <a href="/" class="flex items-center gap-3.5 group">
        <img
          src="/logo/logo-sdk.png"
          alt="SDK Maria Fatima Jember"
          class="w-12 h-12 rounded-2xl object-cover shadow-md group-hover:scale-105 transition-transform select-none"
          loading="lazy"
        />
        <div>
          <div
            class="font-heading font-black text-lg sm:text-xl text-slate-900 group-hover:text-blue-700 transition-colors"
          >
            {SITE_CONFIG.name}
          </div>
          <div class="text-xs text-amber-700 font-bold">
            Cerdas, Berkarakter &amp; Berakar Kasih • Akreditasi {
              SITE_CONFIG.akreditasi
            }
          </div>
        </div>
      </a>
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 shadow-xs text-xs font-bold text-slate-600"
      >
        <span>NPSN: {SITE_CONFIG.npsn}</span>
      </div>
    </div>

    <!-- 3 Core Information Columns: HO (Alamat), Alamat SDK, Contact Us -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10 py-10 border-b border-slate-200/80 text-left"
    >
      <!-- 1. HO (Alamat Head Office) -->
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-xs space-y-3"
      >
        <div class="flex items-center gap-2 text-blue-700">
          <span class="p-2 rounded-xl bg-blue-50 text-blue-700">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </span>
          <h3
            class="font-heading font-black text-sm uppercase tracking-wider text-slate-900"
          >
            Head Office (HO)
          </h3>
        </div>
        <div class="font-heading font-bold text-sm text-slate-900">
          {SITE_CONFIG.headOffice?.name || SITE_CONFIG.foundation}
        </div>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {
            SITE_CONFIG.headOffice?.address ||
              "Jl. Pandan No. 8, Klojen, Kec. Klojen, Kota Malang, Jawa Timur 65112"
          }
        </p>
        <div class="text-xs text-slate-500 pt-1">
          Yayasan Penyelenggara Pendidikan Katolik SPM
        </div>
      </div>

      <!-- 2. Alamat SDK -->
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-xs space-y-3"
      >
        <div class="flex items-center gap-2 text-blue-700">
          <span class="p-2 rounded-xl bg-blue-50 text-blue-700">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </span>
          <h3
            class="font-heading font-black text-sm uppercase tracking-wider text-slate-900"
          >
            Alamat SDK
          </h3>
        </div>
        <div class="font-heading font-bold text-sm text-slate-900">
          SDK Maria Fatima
        </div>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {SITE_CONFIG.address}
        </p>
        <div class="pt-1">
          <a
            href={SITE_CONFIG.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-blue-700 hover:text-blue-800 font-bold hover:underline"
          >
            <span>Buka di Google Maps</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- 3. Contact Us -->
      <div
        class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-xs space-y-3"
      >
        <div class="flex items-center gap-2 text-blue-700">
          <span class="p-2 rounded-xl bg-blue-50 text-blue-700">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </span>
          <h3
            class="font-heading font-black text-sm uppercase tracking-wider text-slate-900"
          >
            Contact Us
          </h3>
        </div>
        <div class="space-y-2 text-xs sm:text-sm text-slate-600">
          <div class="flex items-center gap-2">
            <span class="font-semibold text-slate-700 min-w-16">Telepon:</span>
            <a
              href={`tel:${SITE_CONFIG.phone}`}
              class="text-blue-700 font-bold hover:underline"
            >
              {SITE_CONFIG.phone}
            </a>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-semibold text-slate-700 min-w-24">Bpk. Alex (WA):</span>
            <a
              href={`https://wa.me/${SITE_CONFIG.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-600 font-bold hover:underline"
            >
              0813 5897 7450
            </a>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-semibold text-slate-700 min-w-24">Ibu Kikis:</span>
            <a
              href="tel:081217513124"
              class="text-blue-700 font-bold hover:underline"
            >
              0812 1751 3124
            </a>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-semibold text-slate-700 min-w-16">Email:</span>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="text-blue-700 font-medium hover:underline"
            >
              {SITE_CONFIG.email}
            </a>
          </div>
          <div class="text-xs text-slate-500 pt-1 border-t border-slate-100">
            Jam Layanan TU: <span class="font-semibold text-slate-700"
              >Senin–Jumat 07.00–14.30 WIB</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- 4. ICON MEDSOS (CENTER) -->
    <div
      class="py-8 text-center flex flex-col items-center justify-center border-b border-slate-200/80"
    >
      <div
        class="text-xs font-extrabold uppercase tracking-widest text-slate-500 mb-4"
      >
        Media Sosial Resmi SDK Maria Fatima
      </div>
      <div class="flex items-center justify-center gap-3 sm:gap-4 flex-wrap">
        <!-- Instagram -->
        <a
          href={SITE_CONFIG.socialMedia.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 rounded-2xl bg-white hover:bg-gradient-to-tr hover:from-amber-500 hover:via-pink-500 hover:to-purple-600 text-slate-700 hover:text-white border border-slate-200 shadow-xs flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95"
          aria-label="Instagram SDK Maria Fatima"
          title="Instagram @sdkmariafatimajbr"
        >
          <svg
            class="w-5 h-5 transition-colors"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            ></path>
          </svg>
        </a>
        <!-- YouTube -->
        <a
          href={SITE_CONFIG.socialMedia.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 rounded-2xl bg-white hover:bg-red-600 text-slate-700 hover:text-white border border-slate-200 shadow-xs flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95"
          aria-label="YouTube SDK Maria Fatima"
          title="YouTube SDK Maria Fatima Jember"
        >
          <svg
            class="w-5 h-5 transition-colors"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
            ></path>
          </svg>
        </a>
        <!-- Facebook -->
        <a
          href={SITE_CONFIG.socialMedia.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 rounded-2xl bg-white hover:bg-blue-600 text-slate-700 hover:text-white border border-slate-200 shadow-xs flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95"
          aria-label="Facebook SDK Maria Fatima"
          title="Facebook SDK Maria Fatima Jember"
        >
          <svg
            class="w-5 h-5 transition-colors"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            ></path>
          </svg>
        </a>
        <!-- TikTok -->
        <a
          href={SITE_CONFIG.socialMedia.tiktok}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 rounded-2xl bg-white hover:bg-black text-slate-700 hover:text-white border border-slate-200 shadow-xs flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95"
          aria-label="TikTok SDK Maria Fatima"
          title="TikTok @sdkmartimjember"
        >
          <svg
            class="w-5 h-5 transition-colors"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1.01-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.77 1.81-.04 3.32-1.51 3.38-3.33.07-3.92.03-7.85.04-11.78z"
            ></path>
          </svg>
        </a>
        <!-- WhatsApp -->
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 rounded-2xl bg-white hover:bg-blue-600 text-slate-700 hover:text-white border border-slate-200 shadow-xs flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95"
          aria-label="WhatsApp Resmi SDK Maria Fatima"
          title="WhatsApp Bpk. Alex: 0813 5897 7450"
        >
          <svg
            class="w-5 h-5 transition-colors"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Copyright (Centered, without Tata Tertib / SPMB / Mars & Jingle) -->
    <div class="pt-8 text-center text-xs text-slate-500">
      <p>
        © {currentYear}
        {SITE_CONFIG.name}. Seluruh hak cipta dilindungi undang-undang.
      </p>
    </div>
  </div>
</footer>
