---
/**
 * ArticleLayout.astro
 *
 * Single Responsibility: Wraps MDX article content with
 * structured article header (meta, author, date, category badge),
 * prose styling, and breadcrumb navigation.
 */

import BaseLayout from './BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_CONFIG, formatDate, KATEGORI_COLORS } from '@/utils/config';

interface Props {
  title:       string;
  description: string;
  pubDate:     Date;
  updatedDate?: Date;
  author?:     string;
  coverImage?: string;
  coverAlt?:   string;
  kategori?:   string;
  tags?:       string[];
  backHref?:   string;
  backLabel?:  string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author      = SITE_CONFIG.shortName,
  coverImage,
  coverAlt    = title,
  kategori,
  tags        = [],
  backHref    = '/news-events',
  backLabel   = 'Kembali ke News & Events',
} = Astro.props;

const badgeClass = kategori ? (KATEGORI_COLORS[kategori] ?? 'badge-blue') : 'badge-blue';
const articleURL = new URL(Astro.url.pathname, SITE_CONFIG.url).href;
const articleImage = coverImage ? new URL(coverImage, SITE_CONFIG.url).href : new URL('/og-image.svg', SITE_CONFIG.url).href;

// NewsArticle Schema.org Structured Data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleURL,
  },
  headline: title,
  description: description,
  image: [articleImage],
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.name,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_CONFIG.url}/logo/logo-sdk.png`,
    },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={coverImage ?? '/og-image.svg'}
  imageAlt={coverAlt}
  type="article"
  author={author}
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
  keywords={`${kategori ?? 'Berita'}, ${tags.join(', ')}, ${SITE_CONFIG.name}`}
  structuredData={articleSchema}
>
  <Header />

  <!-- Header with top nav padding -->
  <main id="main-content" style="padding-top: 4.5rem; background: #ffffff;">

    <!-- Article Page -->
    <article>
      <!-- Breadcrumb + Back Button -->
      <nav aria-label="Breadcrumb" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 0.875rem 0;">
        <div class="container">
          <a
            href={backHref}
            style="display: inline-flex; align-items: center; gap: 0.5rem; color: #2563eb; font-size: 0.875rem; font-weight: 600; transition: var(--transition-base);"
            onmouseover="this.style.color='#1d4ed8'"
            onmouseout="this.style.color='#2563eb'"
          >
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            {backLabel}
          </a>
        </div>
      </nav>

      <!-- Hero Image -->
      {coverImage && (
        <div style="width: 100%; max-height: 480px; overflow: hidden; background: #f1f5f9; aspect-ratio: 16/9;">
          <img
            src={coverImage}
            alt={coverAlt}
            width="1200"
            height="675"
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}


      <!-- Article Header -->
      <div class="container" style="padding-top: 3rem; padding-bottom: 1.5rem; max-width: 900px;">
        <div>
          <!-- Category + Tags -->
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem;">
            {kategori && <span class={`badge ${badgeClass}`}>{kategori}</span>}
            {tags.map(tag => (
              <span style="font-size: 0.75rem; color: #64748b; background: #f1f5f9; border: 1px solid #e2e8f0; padding: 0.2rem 0.6rem; border-radius: 9999px;">
                #{tag}
              </span>
            ))}
          </div>

          <!-- Title -->
          <h1 style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 800; color: #0f172a; line-height: 1.25; margin-bottom: 1.25rem;">
            {title}
          </h1>

          <!-- Meta (Author, Date, Read time) -->
          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; font-size: 0.875rem; color: #64748b; padding-bottom: 1.5rem; border-bottom: 1px solid #e2e8f0;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <div style="width: 28px; height: 28px; border-radius: 50%; background: #2563eb; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700;">
                MF
              </div>
              <span style="font-weight: 600; color: #334155;">{author}</span>
            </div>

            <span aria-hidden="true" style="color: #cbd5e1;">•</span>

            <time datetime={pubDate.toISOString()} style="display: flex; align-items: center; gap: 0.35rem;">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              {formatDate(pubDate)}
            </time>

            {updatedDate && (
              <>
                <span aria-hidden="true" style="color: #cbd5e1;">•</span>
                <span style="font-size: 0.8rem; color: #94a3b8;">
                  (Diperbarui: {formatDate(updatedDate)})
                </span>
              </>
            )}
          </div>
        </div>
      </div>

      <!-- Article Body -->
      <div class="container reveal delay-200" style="max-width: 900px; padding-bottom: 6rem;">
        <div class="prose-school">
          <slot />
        </div>

        <!-- Share section -->
        <div style="margin-top: 3rem; padding: 1.5rem; background: #f8fafc; border-radius: var(--radius-card); border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <span style="font-weight: 600; color: #334155;">Bagikan artikel ini:</span>
          <div style="display: flex; gap: 0.75rem;">
            <a
              href={`https://wa.me/?text=${encodeURIComponent(title + ' - ' + SITE_CONFIG.url + Astro.url.pathname)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-sm"
              aria-label="Bagikan ke WhatsApp"
            >
              WhatsApp
            </a>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(SITE_CONFIG.url + Astro.url.pathname)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-sm"
              aria-label="Bagikan ke Twitter/X"
            >
              Twitter/X
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
