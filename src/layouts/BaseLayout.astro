---
/**
 * BaseLayout.astro
 *
 * Single Responsibility: Handles HTML shell, SEO, meta tags, OpenGraph,
 * Twitter cards, Schema.org JSON-LD, fonts, performance optimizations,
 * and accessibility landmarks.
 *
 * All pages extend this layout. Change once → updates everywhere.
 */

import { SITE_CONFIG } from '@/utils/config';
import FloatingWA from '@/components/FloatingWA.svelte';
import SplashScreen from '@/components/SplashScreen.astro';
import '@/styles/global.css';

interface Props {
  title?:          string;
  description?:    string;
  image?:          string;
  imageAlt?:       string;
  type?:           'website' | 'article';
  keywords?:       string;
  author?:         string;
  publishedTime?:  string;
  modifiedTime?:   string;
  noindex?:        boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  preloadImages?:  string[];
}

const {
  title,
  description    = SITE_CONFIG.description,
  image          = '/og-image.svg',
  imageAlt       = `Banner ${SITE_CONFIG.name}`,
  type           = 'website',
  keywords       = 'SDK Maria Fatima Jember, SD Katolik Maria Fatima, Sekolah Dasar Katolik Jember, Yayasan Suster SPM, SPMB SDK Maria Fatima 2026, Profil Lulusan SDK Maria Fatima, Spiritualitas SIKARU, Akreditasi A Unggul',
  author         = SITE_CONFIG.name,
  publishedTime,
  modifiedTime,
  noindex        = false,
  structuredData,
  preloadImages  = [],
} = Astro.props;

const pageTitle    = title ? `${title} | ${SITE_CONFIG.shortName}` : `${SITE_CONFIG.name} — Cerdas, Berkarakter & Berakar Kasih`;
const canonicalURL = new URL(Astro.url.pathname, SITE_CONFIG.url).href;
const ogImageURL   = new URL(image, SITE_CONFIG.url).href;
const isHomePage   = Astro.url.pathname === '/' || Astro.url.pathname === '';

// Breadcrumb Schema calculation
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Beranda',
    item: SITE_CONFIG.url,
  },
  ...pathSegments.map((segment, index) => {
    const url = `${SITE_CONFIG.url}/${pathSegments.slice(0, index + 1).join('/')}`;
    const name = segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');
    return {
      '@type': 'ListItem',
      position: index + 2,
      name,
      item: url,
    };
  }),
];

// Organization Schema (ElementarySchool / School)
const schoolSchema = {
  '@context': 'https://schema.org',
  '@type': 'ElementarySchool',
  '@id': `${SITE_CONFIG.url}/#school`,
  name: SITE_CONFIG.name,
  alternateName: SITE_CONFIG.shortName,
  description: SITE_CONFIG.description,
  url: SITE_CONFIG.url,
  logo: `${SITE_CONFIG.url}/logo/logo-sdk.png`,
  image: ogImageURL,
  email: SITE_CONFIG.email,
  telephone: SITE_CONFIG.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE_CONFIG.address,
    addressLocality: 'Jember',
    addressRegion: 'Jawa Timur',
    postalCode: '68137',
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -8.1713365,
    longitude: 113.7008447,
  },
  hasMap: SITE_CONFIG.mapsUrl,
  sameAs: Object.values(SITE_CONFIG.socialMedia).filter(Boolean),
};

// WebSite Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_CONFIG.url}/#website`,
  url: SITE_CONFIG.url,
  name: SITE_CONFIG.name,
  description: SITE_CONFIG.description,
  publisher: {
    '@id': `${SITE_CONFIG.url}/#school`,
  },
  inLanguage: 'id-ID',
};

// BreadcrumbList Schema
const breadcrumbSchema = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
} : null;
---

<!doctype html>
<html lang="id" dir="ltr">
<head>
  <!-- Technical & Charset -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="theme-color" content="#1e3a8a" />
  <meta name="color-scheme" content="light" />

  <!-- Primary Meta Tags -->
  <title>{pageTitle}</title>
  <meta name="title" content={pageTitle} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={author} />
  <meta name="publisher" content={SITE_CONFIG.foundation} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Preload Critical Above-The-Fold Images -->
  {(preloadImages ?? []).map((src) => (
    <link rel="preload" as="image" href={src} fetchpriority="high" />
  ))}

  <!-- Preload fonts to eliminate CLS and render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Homemade+Apple&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Space+Grotesk:wght@500;600;700;800;900&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Homemade+Apple&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Space+Grotesk:wght@500;600;700;800;900&display=swap"
  />

  <!-- OpenGraph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={SITE_CONFIG.name} />
  <meta property="og:locale" content="id_ID" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <!-- Favicon & PWA -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Structured Data: Organization & Website -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schoolSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />

  <!-- Structured Data: Breadcrumb Schema (if subpage) -->
  {breadcrumbSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <!-- Structured Data: Custom Page Specific Schemas (Articles, Events, etc.) -->
  {structuredData && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body class="bg-white text-slate-700 min-h-screen flex flex-col justify-between antialiased">
  <!-- First Visit Splash Screen (Hanya di Beranda) -->
  {isHomePage && <SplashScreen />}

  <!-- Accessibility: Skip to main content link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-700 focus:text-white focus:rounded-lg">
    Lewati ke konten utama
  </a>

  <div class="flex-1 flex flex-col">
    <slot />
  </div>

  <!-- Global Floating WhatsApp Action Button -->
  <FloatingWA client:load />

  <!-- Global Scroll-Triggered Reveal Animation Observer (Smooth 60fps) -->
  <script>
    function setupScrollReveal() {
      const elementsToObserve = new Set<Element>();

      // 1. Explicitly marked elements
      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-on-scroll').forEach((el) => {
        elementsToObserve.add(el);
      });

      // 2. Automatically observe main sections & content grids across all pages
      const sections = document.querySelectorAll('main > section, main section');
      sections.forEach((section) => {
        if (section.id === 'hero-banner') return;

        if (!section.classList.contains('reveal') && !section.classList.contains('reveal-on-scroll')) {
          section.classList.add('reveal-on-scroll');
        }
        elementsToObserve.add(section);

        // Stagger child cards in grids
        const grids = section.querySelectorAll('.grid');
        grids.forEach((grid) => {
          Array.from(grid.children).forEach((child, idx) => {
            const el = child as HTMLElement;
            if (!el.classList.contains('reveal') && !el.classList.contains('reveal-scale') && !el.classList.contains('reveal-on-scroll')) {
              el.classList.add('reveal-on-scroll');
              el.style.transitionDelay = `${(idx % 6) * 120}ms`;
            }
            elementsToObserve.add(el);
          });
        });
      });

      if (!elementsToObserve.size) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              // Promote to GPU layer just before animating
              el.style.willChange = 'opacity, transform';
              el.classList.add('is-revealed', 'visible');
              observer.unobserve(el);
              // After transition, clear will-change to free GPU memory
              el.addEventListener('transitionend', () => {
                el.style.willChange = 'auto';
              }, { once: true });
            }
          });
        },
        {
          threshold: 0.08,
          rootMargin: '0px 0px -40px 0px',
        }
      );

      elementsToObserve.forEach((el) => {
        const rect = el.getBoundingClientRect();
        // If element is already visible on screen, reveal immediately without jump
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          el.classList.add('is-revealed', 'visible');
        } else {
          observer.observe(el);
        }
      });
    }

    function initGlobalCounters() {
      const counters = document.querySelectorAll('.stat-counter');
      if (!counters.length) return;

      const animate = (el: HTMLElement) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        if (isNaN(target) || target <= 0) return;

        const duration = 1800; // 1.8 detik animasi menghitung naik
        const startTime = performance.now();

        const updateCount = (currentTime: number) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeOut = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(easeOut * target);
          el.innerText = current.toString();

          if (progress < 1) {
            requestAnimationFrame(updateCount);
          } else {
            el.innerText = target.toString();
          }
        };

        requestAnimationFrame(updateCount);
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      counters.forEach((c) => observer.observe(c));
    }

    function setupImagePreloaders() {
      const images = document.querySelectorAll<HTMLImageElement>('img');
      images.forEach((img) => {
        // Enforce asynchronous decoding off main thread to prevent top-to-bottom scanline rendering
        if (!img.getAttribute('decoding')) {
          img.decoding = 'async';
        }

        // If image is already complete in memory (cached), reveal immediately without flicker
        if (img.complete && img.naturalWidth > 0) {
          img.classList.remove('is-loading');
          img.classList.add('is-loaded');
          return;
        }

        // Attach loading state while downloading
        img.classList.add('is-loading');

        const markLoaded = () => {
          img.classList.remove('is-loading');
          img.classList.add('is-loaded');
        };

        const tryDecode = () => {
          if (typeof img.decode === 'function') {
            img.decode().then(markLoaded).catch(markLoaded);
          } else {
            markLoaded();
          }
        };

        if (img.complete) {
          tryDecode();
        } else {
          img.addEventListener('load', tryDecode, { once: true });
          img.addEventListener('error', markLoaded, { once: true });
        }
      });

      // Background preloader for images approaching the viewport (400px advance margin)
      if ('IntersectionObserver' in window) {
        const preloadObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const img = entry.target as HTMLImageElement;
                if (img.src && !img.complete) {
                  new Image().src = img.src;
                }
                preloadObserver.unobserve(img);
              }
            });
          },
          { rootMargin: '400px 0px 400px 0px' }
        );

        images.forEach((img) => {
          if (!img.complete) {
            preloadObserver.observe(img);
          }
        });
      }
    }

    function initGlobalScripts() {
      setupScrollReveal();
      initGlobalCounters();
      setupImagePreloaders();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGlobalScripts);
    } else {
      initGlobalScripts();
    }
    document.addEventListener('astro:page-load', initGlobalScripts);
  </script>
</body>
</html>
